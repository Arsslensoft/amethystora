#: apps/connect/src/service.rs
msgid "The phone link cannot listen"
msgstr "Die Telefonverbindung kann nicht lauschen"

#: apps/connect/src/service.rs
msgid "Another program is using the ports the phone link needs. Phones can still be reached from here."
msgstr "Ein anderes Programm nutzt die Ports, die die Telefonverbindung braucht. Telefone lassen sich von hier aus weiterhin erreichen."

#: apps/connect/src/service.rs
#, python-brace-format
msgid "Something claimed to be “{name}”"
msgstr "Etwas gab sich als „{name}“ aus"

#: apps/connect/src/service.rs
msgid "It did not have the certificate that phone was paired with, so it was refused. If you reinstalled the app on the phone, remove the phone here and pair it again."
msgstr "Es hatte nicht das Zertifikat, mit dem dieses Telefon gekoppelt wurde, daher wurde es abgelehnt. Wenn Sie die App auf dem Telefon neu installiert haben, entfernen Sie das Telefon hier und koppeln Sie es erneut."

#: apps/connect/src/service.rs
msgid "Pairing failed"
msgstr "Kopplung fehlgeschlagen"

#: apps/connect/src/service.rs
msgid "The pairing could not be saved on this computer."
msgstr "Die Kopplung konnte auf diesem Computer nicht gespeichert werden."

#: apps/connect/src/service.rs
#, python-brace-format
msgid "“{name}” did not accept the pairing"
msgstr "„{name}“ hat die Kopplung nicht angenommen"

#: apps/connect/src/service.rs
msgid "The clocks of this computer and the phone differ by more than half an hour. Set both to the right time and try again."
msgstr "Die Uhren dieses Computers und des Telefons weichen um mehr als eine halbe Stunde ab. Stellen Sie beide auf die richtige Zeit und versuchen Sie es erneut."

#: apps/connect/src/service.rs
#, python-brace-format
msgid "“{name}” was unpaired"
msgstr "Die Kopplung mit „{name}“ wurde aufgehoben"

#: apps/connect/src/service.rs
msgid "The phone ended the pairing."
msgstr "Das Telefon hat die Kopplung beendet."

#: apps/connect/src/service.rs
#, python-brace-format
msgid "Key {key}. Compare it with the key on the phone, and cancel if they differ."
msgstr "Schlüssel {key}. Vergleichen Sie ihn mit dem Schlüssel auf dem Telefon und brechen Sie ab, wenn sie sich unterscheiden."

#: apps/connect/src/service.rs
#, python-brace-format
msgid "Key {key}. Compare it with the key on the phone, and accept only if they are the same."
msgstr "Schlüssel {key}. Vergleichen Sie ihn mit dem Schlüssel auf dem Telefon und nehmen Sie nur an, wenn sie gleich sind."

#: apps/connect/src/service.rs
#, python-brace-format
msgid "Key {key}. Compare it with the key on the other computer, and cancel if they differ."
msgstr "Schlüssel {key}. Vergleichen Sie ihn mit dem Schlüssel auf dem anderen Computer und brechen Sie ab, wenn sie sich unterscheiden."

#: apps/connect/src/service.rs
#, python-brace-format
msgid "Key {key}. Compare it with the key on the other computer, and accept only if they are the same."
msgstr "Schlüssel {key}. Vergleichen Sie ihn mit dem Schlüssel auf dem anderen Computer und nehmen Sie nur an, wenn sie gleich sind."

#: apps/connect/src/service.rs
msgid "This phone uses an older version of the protocol, which protects the pairing less well."
msgstr "Dieses Telefon nutzt eine ältere Version des Protokolls, die die Kopplung weniger gut schützt."

#: apps/connect/src/service.rs
msgid "Accept"
msgstr "Annehmen"

#: apps/connect/src/service.rs
msgid "Reject"
msgstr "Ablehnen"

#: apps/connect/src/service.rs
#, python-brace-format
msgid "Pairing with “{name}”"
msgstr "Kopplung mit „{name}“"

#: apps/connect/src/service.rs
#, python-brace-format
msgid "“{name}” wants to pair"
msgstr "„{name}“ möchte sich koppeln"

#: apps/connect/src/share.rs
msgid "Only files on this computer can be sent."
msgstr "Nur Dateien auf diesem Computer können gesendet werden."

#: apps/connect/src/share.rs
msgid "A file cannot be read."
msgstr "Eine Datei kann nicht gelesen werden."

#: apps/connect/src/share.rs
msgid "A folder cannot be sent."
msgstr "Ein Ordner kann nicht gesendet werden."

#: apps/connect/src/sms.rs
#, python-brace-format
msgid "{name} and {count} more"
msgstr "{name} und {count} weitere"

#: apps/connect/src/sms.rs
msgid "Attachment"
msgstr "Anhang"

#: apps/connect/src/telephony.rs
msgid "Unknown caller"
msgstr "Unbekannter Anrufer"

#: apps/connect/src/text.rs
msgid "unnamed file"
msgstr "unbenannte Datei"

#: apps/connect/src/transfers.rs
msgid "The phone did not say how to fetch the file."
msgstr "Das Telefon hat nicht mitgeteilt, wie die Datei abgerufen wird."

#: apps/connect/src/transfers.rs
#, python-brace-format
msgid "The folder for files from phones cannot be made: {error}"
msgstr "Der Ordner für Dateien von Telefonen kann nicht angelegt werden: {error}"

#: apps/connect/src/transfers.rs
msgid "There is not enough space for this file."
msgstr "Für diese Datei ist nicht genug Platz."

#: apps/connect/src/transfers.rs
#, python-brace-format
msgid "Receiving from “{name}”"
msgstr "Empfang von „{name}“"

#: apps/connect/src/transfers.rs
msgid "The phone is not paired."
msgstr "Das Telefon ist nicht gekoppelt."

#: apps/connect/src/transfers.rs
msgid "The phone stopped sending before the file was whole."
msgstr "Das Telefon hat das Senden beendet, bevor die Datei vollständig war."

#: apps/connect/src/transfers.rs
#, python-brace-format
msgid "The transfer failed: {error}"
msgstr "Die Übertragung ist fehlgeschlagen: {error}"

#: apps/connect/src/transfers.rs
#, python-brace-format
msgid "A file from “{name}” was not received"
msgstr "Eine Datei von „{name}“ wurde nicht empfangen"

#: apps/connect/src/transfers.rs
#, python-brace-format
msgid "A file for “{name}” was not sent"
msgstr "Eine Datei für „{name}“ wurde nicht gesendet"

#: apps/connect/src/transfers.rs
msgid "Show in folder"
msgstr "Im Ordner zeigen"

#: apps/connect/src/transfers.rs
#, python-brace-format
msgid "Received from “{name}”"
msgstr "Von „{name}“ empfangen"

#: apps/connect/src/transfers.rs
#, python-brace-format
msgid "{count} files"
msgstr "{count} Dateien"

#: apps/connect/src/transfers.rs
#, python-brace-format
msgid "{done} of {count} files; {failed} failed"
msgstr "{done} von {count} Dateien; {failed} fehlgeschlagen"

