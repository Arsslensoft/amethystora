msgid "The battery of “{name}” is low"
msgstr "Der Akku von „{name}“ ist schwach"

#: apps/connect/src/plugins.rs
#, python-brace-format
msgid "{percent}% left"
msgstr "{percent} % übrig"

#: apps/connect/src/plugins.rs
msgid "Reply"
msgstr "Antworten"

#: apps/connect/src/plugins.rs
msgid "Dismiss"
msgstr "Verwerfen"

#: apps/connect/src/plugins.rs
#, python-brace-format
msgid "Missed call from {caller}"
msgstr "Verpasster Anruf von {caller}"

#: apps/connect/src/plugins.rs
#, python-brace-format
msgid "On “{name}”"
msgstr "Auf „{name}“"

#: apps/connect/src/plugins.rs
msgid "Incoming call"
msgstr "Eingehender Anruf"

#: apps/connect/src/plugins.rs
msgid "Call in progress"
msgstr "Anruf läuft"

#: apps/connect/src/plugins.rs
msgid "Mute"
msgstr "Stumm"

