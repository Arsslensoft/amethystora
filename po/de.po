msgid "Light"
msgstr "Hell"

#: usr/libexec/amethystora-control-list
msgid "Medium light"
msgstr "Mittelhell"

#: usr/libexec/amethystora-control-list
msgid "Medium"
msgstr "Mittel"

#: usr/libexec/amethystora-control-list
msgid "Medium dark"
msgstr "Mitteldunkel"

#: usr/libexec/amethystora-control-list
msgid "Dark"
msgstr "Dunkel"

#: usr/libexec/amethystora-control-list
