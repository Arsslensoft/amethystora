# German translation of what Amethystora's own shell programs say: the security report and the app
# permissions.
msgid ""
msgstr ""
"Project-Id-Version: amethystora\n"
"Report-Msgid-Bugs-To: https://github.com/iarsslen/amethystora/issues\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: usr/libexec/amethystora-security-status
msgid "Updates and boot"
msgstr "Aktualisierungen und Systemstart"

#: usr/libexec/amethystora-security-status
msgid "Watching"
msgstr "Überwachung"

#: usr/libexec/amethystora-security-status
msgid "Apps"
msgstr "Apps"

#: usr/libexec/amethystora-security-status
msgid "Scans"
msgstr "Prüfungen"

#: usr/libexec/amethystora-security-status
msgid "Off unless you turned it on"
msgstr "Aus, sofern Sie es nicht eingeschaltet haben"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${title} is on (${COMMAND})"
msgstr "${title} ist eingeschaltet (${COMMAND})"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${title}: ${COMMAND} (${reason})"
msgstr "${title}: ${COMMAND} (${reason})"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "ok"
msgstr "ok"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "check"
msgstr "offen"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "off"
msgstr "Alarm"

#: usr/libexec/amethystora-security-status
msgid "today"
msgstr "heute"

#: usr/libexec/amethystora-security-status
msgid "yesterday"
msgstr "gestern"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${DAYS} day ago"
msgid_plural "${DAYS} days ago"
msgstr[0] "vor ${DAYS} Tag"
msgstr[1] "vor ${DAYS} Tagen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This machine is running ${IMAGE}"
msgstr "Auf diesem Rechner läuft ${IMAGE}"

#: usr/libexec/amethystora-security-status
msgid "Signed updates"
msgstr "Signierte Aktualisierungen"

#: usr/libexec/amethystora-security-status
msgid "Updates are refused unless they carry this image's signature"
msgstr "Aktualisierungen werden abgelehnt, wenn sie nicht die Signatur dieses Abbilds tragen"

#: usr/libexec/amethystora-security-status
msgid "Signature checking is staged, and turns on at the next restart"
msgstr "Die Signaturprüfung ist vorbereitet und wird beim nächsten Neustart aktiv"

#: usr/libexec/amethystora-security-status
msgid "Updates are not signature-checked"
msgstr "Die Signaturen von Aktualisierungen werden nicht geprüft"

#: usr/libexec/amethystora-security-status
msgid "Anything that can answer for the registry could replace this machine's whole system."
msgstr "Wer sich als die Registry ausgeben kann, könnte das gesamte System dieses Rechners ersetzen."

#: usr/libexec/amethystora-security-status
msgid "Fix it with this, then restart:"
msgstr "Beheben Sie das hiermit und starten Sie dann neu:"

#: usr/libexec/amethystora-security-status
msgid "Updates"
msgstr "Aktualisierungen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This machine follows a single build (${TAG}) and will not receive updates"
msgstr "Dieser Rechner folgt einem einzelnen Build (${TAG}) und erhält keine Aktualisierungen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Follow the ${STREAM} stream again with:"
msgstr "Wieder dem Kanal ${STREAM} folgen mit:"

#: usr/libexec/amethystora-security-status
msgid "Layered packages"
msgstr "Überlagerte Pakete"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${LAYERED} package is layered on this image with rpm-ostree"
msgid_plural "${LAYERED} packages are layered on this image with rpm-ostree"
msgstr[0] "${LAYERED} Paket ist mit rpm-ostree über dieses Abbild gelegt"
msgstr[1] "${LAYERED} Pakete sind mit rpm-ostree über dieses Abbild gelegt"

#: usr/libexec/amethystora-security-status
msgid "Updates keep them, but each one slows every update; the image is the better place"
msgstr "Aktualisierungen behalten sie, aber jedes verlangsamt jede Aktualisierung; das Abbild ist der bessere Ort dafür"

#: usr/libexec/amethystora-security-status
msgid "System image"
msgstr "Systemabbild"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This system image was built ${WHEN}"
msgstr "Dieses Systemabbild wurde ${WHEN} erstellt"

#: usr/libexec/amethystora-security-status
msgid "A newer system image is waiting for a restart"
msgstr "Ein neueres Systemabbild wartet auf einen Neustart"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The one running was built ${AGE} day ago. Restart to use the new one."
msgid_plural "The one running was built ${AGE} days ago. Restart to use the new one."
msgstr[0] "Das laufende wurde vor ${AGE} Tag erstellt. Starten Sie neu, um das neue zu verwenden."
msgstr[1] "Das laufende wurde vor ${AGE} Tagen erstellt. Starten Sie neu, um das neue zu verwenden."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This system image is ${AGE} day old"
msgid_plural "This system image is ${AGE} days old"
msgstr[0] "Dieses Systemabbild ist ${AGE} Tag alt"
msgstr[1] "Dieses Systemabbild ist ${AGE} Tage alt"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Security fixes reach this machine as new images, and none has arrived since ${SINCE}."
msgstr "Sicherheitskorrekturen erreichen diesen Rechner als neue Abbilder, und seit dem ${SINCE} ist keines angekommen."

#: usr/libexec/amethystora-security-status
msgid "Update now with:"
msgstr "Jetzt aktualisieren mit:"

#: usr/libexec/amethystora-security-status
msgid "Automatic updates"
msgstr "Automatische Aktualisierungen"

#: usr/libexec/amethystora-security-status
msgid "Automatic updates are off"
msgstr "Automatische Aktualisierungen sind ausgeschaltet"

#: usr/libexec/amethystora-security-status
msgid "Turn them back on with:"
msgstr "Wieder einschalten mit:"

#: usr/libexec/amethystora-security-status
msgid "Updates install by themselves"
msgstr "Aktualisierungen werden selbstständig installiert"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The last update that finished was ${DAYS} day ago"
msgid_plural "The last update that finished was ${DAYS} days ago"
msgstr[0] "Die letzte abgeschlossene Aktualisierung war vor ${DAYS} Tag"
msgstr[1] "Die letzte abgeschlossene Aktualisierung war vor ${DAYS} Tagen"

#: usr/libexec/amethystora-security-status
msgid "Updates start, but do not get to the end. System Updates shows why, or run one here:"
msgstr "Aktualisierungen starten, kommen aber nicht bis zum Ende. Systemaktualisierungen zeigt den Grund, oder starten Sie hier eine:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Updates install by themselves. The last one finished ${WHEN}"
msgstr "Aktualisierungen werden selbstständig installiert. Die letzte wurde ${WHEN} abgeschlossen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${name}, never upgraded"
msgstr "${name}, nie aktualisiert"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${name}, last upgraded ${WHEN}"
msgstr "${name}, zuletzt ${WHEN} aktualisiert"

#: usr/libexec/amethystora-security-status
msgid "Containers"
msgstr "Container"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} container has not been upgraded for two weeks"
msgid_plural "${N} containers have not been upgraded for two weeks"
msgstr[0] "${N} Container wurde seit zwei Wochen nicht aktualisiert"
msgstr[1] "${N} Container wurden seit zwei Wochen nicht aktualisiert"

#: usr/libexec/amethystora-security-status
msgid "What runs in a container goes without the fixes its distribution has published since. Upgrade them now with:"
msgstr "Was in einem Container läuft, bleibt ohne die Korrekturen, die seine Distribution seitdem veröffentlicht hat. Jetzt aktualisieren mit:"

#: usr/libexec/amethystora-security-status
msgid "The container amethystora-pkg manages is upgraded every day"
msgstr "Der Container, den amethystora-pkg verwaltet, wird täglich aktualisiert"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The ${COUNT} container amethystora-pkg manages is upgraded every day"
msgid_plural "The ${COUNT} containers amethystora-pkg manages are upgraded every day"
msgstr[0] "Der ${COUNT} Container, den amethystora-pkg verwaltet, wird täglich aktualisiert"
msgstr[1] "Die ${COUNT} Container, die amethystora-pkg verwaltet, werden täglich aktualisiert"

#: usr/libexec/amethystora-security-status
msgid "Verified system files"
msgstr "Geprüfte Systemdateien"

#: usr/libexec/amethystora-security-status
msgid "The running system is on composefs: /usr is verified as it is read, not only when pulled"
msgstr "Das laufende System nutzt composefs: /usr wird beim Lesen geprüft, nicht nur beim Herunterladen"

#: usr/libexec/amethystora-security-status
msgid "/usr is read-only and replaced whole by each update, but is not re-verified as it is read"
msgstr "/usr ist schreibgeschützt und wird mit jeder Aktualisierung vollständig ersetzt, aber beim Lesen nicht erneut geprüft"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot"
msgstr "Secure Boot"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot is on: this machine boots only a kernel it has checked"
msgstr "Secure Boot ist eingeschaltet: Dieser Rechner startet nur einen Kernel, den er geprüft hat"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot is off"
msgstr "Secure Boot ist ausgeschaltet"

#: usr/libexec/amethystora-security-status
msgid "The kernel protections below rest on it. Without it, anything that reaches root can boot a different kernel and step around them."
msgstr "Die Kernel-Schutzmaßnahmen weiter unten beruhen darauf. Ohne Secure Boot kann alles, was Root-Rechte erlangt, einen anderen Kernel starten und sie umgehen."

#: usr/libexec/amethystora-security-status
msgid "Turn Secure Boot on in this machine's firmware, then run:"
msgstr "Schalten Sie Secure Boot in der Firmware dieses Rechners ein und führen Sie dann aus:"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot state unknown (no EFI on this machine, or its firmware will not say)"
msgstr "Secure-Boot-Status unbekannt (kein EFI auf diesem Rechner, oder seine Firmware gibt ihn nicht preis)"

#: usr/libexec/amethystora-security-status
msgid "Signing keys"
msgstr "Signaturschlüssel"

#: usr/libexec/amethystora-security-status
msgid "This image's signing keys are enrolled"
msgstr "Die Signaturschlüssel dieses Abbilds sind registriert"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Not enrolled: ${CERT}"
msgstr "Nicht registriert: ${CERT}"

#: usr/libexec/amethystora-security-status
msgid "What it signs, such as evdi for DisplayLink docks, will not load."
msgstr "Was damit signiert ist, etwa evdi für DisplayLink-Docks, wird nicht geladen."

#: usr/libexec/amethystora-security-status
msgid "Enroll it with:"
msgstr "Registrieren mit:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Enrollment of ${CERT} is waiting for the next restart"
msgstr "Die Registrierung von ${CERT} wartet auf den nächsten Neustart"

#: usr/libexec/amethystora-security-status
msgid "Finish it in the blue MOK manager screen that appears during boot."
msgstr "Schließen Sie sie im blauen Bildschirm des MOK-Managers ab, der beim Start erscheint."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${cert} is not on this machine"
msgstr "${cert} ist auf diesem Rechner nicht vorhanden"

#: usr/libexec/amethystora-security-status
msgid "Whether its key is enrolled cannot be checked without it."
msgstr "Ohne diese Datei lässt sich nicht prüfen, ob ihr Schlüssel registriert ist."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Could not tell whether ${CERT} is enrolled"
msgstr "Es ließ sich nicht feststellen, ob ${CERT} registriert ist"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "mokutil said: ${rest}"
msgstr "mokutil meldete: ${rest}"

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown"
msgstr "Kernel-Lockdown"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Kernel lockdown is on (${LOCKDOWN}): root cannot rewrite the running kernel"
msgstr "Kernel-Lockdown ist eingeschaltet (${LOCKDOWN}): Root kann den laufenden Kernel nicht umschreiben"

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown is off, as it is on every NVIDIA image"
msgstr "Kernel-Lockdown ist ausgeschaltet, wie auf jedem NVIDIA-Abbild"

#: usr/libexec/amethystora-security-status
msgid "The NVIDIA driver is a module signed with this machine's own key, and lockdown would leave a machine without Secure Boot with no graphics driver at all."
msgstr "Der NVIDIA-Treiber ist ein Modul, das mit dem eigenen Schlüssel dieses Rechners signiert ist, und Lockdown würde einen Rechner ohne Secure Boot ganz ohne Grafiktreiber lassen."

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown is off"
msgstr "Kernel-Lockdown ist ausgeschaltet"

#: usr/libexec/amethystora-security-status
msgid "Turn it back on with:"
msgstr "Wieder einschalten mit:"

#: usr/libexec/amethystora-security-status
msgid "Firmware security"
msgstr "Firmware-Sicherheit"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "fwupd rates this machine's firmware protections ${LEVEL} of 5, and something running weakens them"
msgstr "fwupd bewertet die Firmware-Schutzmaßnahmen dieses Rechners mit ${LEVEL} von 5, und etwas, das gerade läuft, schwächt sie"

#: usr/libexec/amethystora-security-status
msgid "Every protection fwupd looks at, with what each is:"
msgstr "Alle Schutzmaßnahmen, die fwupd prüft, jeweils mit Erklärung:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "fwupd rates this machine's firmware protections ${LEVEL} of 5"
msgstr "fwupd bewertet die Firmware-Schutzmaßnahmen dieses Rechners mit ${LEVEL} von 5"

#: usr/libexec/amethystora-security-status
msgid "That is mostly up to the machine's maker. Every protection fwupd looks at, with what each is:"
msgstr "Das liegt überwiegend beim Hersteller des Rechners. Alle Schutzmaßnahmen, die fwupd prüft, jeweils mit Erklärung:"

#: usr/libexec/amethystora-security-status
msgid "Audit log"
msgstr "Audit-Protokoll"

#: usr/libexec/amethystora-security-status
msgid "The audit log is recording"
msgstr "Das Audit-Protokoll zeichnet auf"

#: usr/libexec/amethystora-security-status
msgid "The audit log is not recording"
msgstr "Das Audit-Protokoll zeichnet nicht auf"

#: usr/libexec/amethystora-security-status
msgid "Start it with:"
msgstr "Starten mit:"

#: usr/libexec/amethystora-security-status
msgid "Audit rules"
msgstr "Audit-Regeln"

#: usr/libexec/amethystora-security-status
msgid "Audit rules are immutable until the next reboot"
msgstr "Die Audit-Regeln sind bis zum nächsten Neustart unveränderlich"

#: usr/libexec/amethystora-security-status
msgid "Failed logins"
msgstr "Fehlgeschlagene Anmeldungen"

#: usr/libexec/amethystora-security-status
msgid "Repeated failed logins get the address blocked (ame security addresses)"
msgstr "Wiederholt fehlgeschlagene Anmeldungen führen zur Sperrung der Adresse (ame security addresses)"

#: usr/libexec/amethystora-security-status
msgid "fail2ban is not running"
msgstr "fail2ban läuft nicht"

#: usr/libexec/amethystora-security-status
msgid "Firewall"
msgstr "Firewall"

#: usr/libexec/amethystora-security-status
msgid "Firewall is on the amethystora zone: nothing incoming that a desktop does not need"
msgstr "Die Firewall nutzt die Zone amethystora: nichts Eingehendes, was ein Desktop nicht braucht"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Firewall default zone is ${ZONE}, not amethystora"
msgstr "Die Standardzone der Firewall ist ${ZONE}, nicht amethystora"

#: usr/libexec/amethystora-security-status
msgid "Put it back with:"
msgstr "Wiederherstellen mit:"

#: usr/libexec/amethystora-security-status
msgid "Suricata blocks connections to known malware, command servers and exploits"
msgstr "Suricata blockiert Verbindungen zu bekannter Schadsoftware, Steuerservern und Exploits"

#: usr/libexec/amethystora-security-status
msgid "Suricata inspects every connection and says what it recognises, without blocking"
msgstr "Suricata untersucht jede Verbindung und meldet, was es erkennt, ohne zu blockieren"

#: usr/libexec/amethystora-security-status
msgid "Network protection"
msgstr "Netzwerkschutz"

#: usr/libexec/amethystora-security-status
msgid "Network protection is on, but not running"
msgstr "Der Netzwerkschutz ist eingeschaltet, läuft aber nicht"

#: usr/libexec/amethystora-security-status
msgid "Connections pass without being inspected until it runs again. Start it with:"
msgstr "Verbindungen passieren ungeprüft, bis er wieder läuft. Starten mit:"

#: usr/libexec/amethystora-security-status
msgid "Network protection is running, but no traffic reaches it"
msgstr "Der Netzwerkschutz läuft, aber kein Datenverkehr erreicht ihn"

#: usr/libexec/amethystora-security-status
msgid "Its nftables table (inet amethystora-ips) is gone, so connections pass without being inspected. Put it back with:"
msgstr "Seine nftables-Tabelle (inet amethystora-ips) fehlt, daher passieren Verbindungen ungeprüft. Wiederherstellen mit:"

#: usr/libexec/amethystora-security-status
msgid "Network protection has no rules yet"
msgstr "Der Netzwerkschutz hat noch keine Regeln"

#: usr/libexec/amethystora-security-status
msgid "Nothing is recognised until the rules have downloaded once. Download them now with:"
msgstr "Nichts wird erkannt, bevor die Regeln einmal heruntergeladen wurden. Jetzt herunterladen mit:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The network protection rules are ${DAYS} day old"
msgid_plural "The network protection rules are ${DAYS} days old"
msgstr[0] "Die Regeln des Netzwerkschutzes sind ${DAYS} Tag alt"
msgstr[1] "Die Regeln des Netzwerkschutzes sind ${DAYS} Tage alt"

#: usr/libexec/amethystora-security-status
msgid "They download every day, and newer attacks are not recognised until they do. Check this machine's network, or try now with:"
msgstr "Sie werden täglich heruntergeladen, und neuere Angriffe werden erst danach erkannt. Prüfen Sie das Netzwerk dieses Rechners oder versuchen Sie es jetzt mit:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "It blocked ${BLOCKED} connection in the last 7 days. See it with:"
msgid_plural "It blocked ${BLOCKED} connections in the last 7 days. See them with:"
msgstr[0] "In den letzten 7 Tagen wurde ${BLOCKED} Verbindung blockiert. Anzeigen mit:"
msgstr[1] "In den letzten 7 Tagen wurden ${BLOCKED} Verbindungen blockiert. Anzeigen mit:"

#: usr/libexec/amethystora-security-status
msgid "Security watcher"
msgstr "Sicherheitswächter"

#: usr/libexec/amethystora-security-status
msgid "The security watcher noticed something"
msgstr "Der Sicherheitswächter hat etwas bemerkt"

#: usr/libexec/amethystora-security-status
msgid "A change to accounts, to what starts by itself or to a security setting, or a program reading the keyboard directly. See it with:"
msgstr "Eine Änderung an Konten, an dem, was von selbst startet, oder an einer Sicherheitseinstellung, oder ein Programm, das die Tastatur direkt liest. Anzeigen mit:"

#: usr/libexec/amethystora-security-status
msgid "The security watcher is off"
msgstr "Der Sicherheitswächter ist ausgeschaltet"

#: usr/libexec/amethystora-security-status
msgid "The security watcher's last run failed"
msgstr "Der letzte Lauf des Sicherheitswächters ist fehlgeschlagen"

#: usr/libexec/amethystora-security-status
msgid "See why with:"
msgstr "Den Grund anzeigen mit:"

#: usr/libexec/amethystora-security-status
msgid "The security watcher reads the audit log and checks the settings as they happen"
msgstr "Der Sicherheitswächter liest das Audit-Protokoll und prüft die Einstellungen, sobald sich etwas ändert"

#: usr/libexec/amethystora-security-status
msgid "The security watcher reads the audit log and checks the settings every 15 minutes"
msgstr "Der Sicherheitswächter liest das Audit-Protokoll und prüft die Einstellungen alle 15 Minuten"

#: usr/libexec/amethystora-security-status
msgid "Real-time watching"
msgstr "Echtzeitüberwachung"

#: usr/libexec/amethystora-security-status
msgid "Real-time watching is on: changes are read as they happen, and files scanned as they are written"
msgstr "Die Echtzeitüberwachung ist eingeschaltet: Änderungen werden gelesen, sobald sie geschehen, und Dateien geprüft, sobald sie geschrieben werden"

#: usr/libexec/amethystora-security-status
msgid "Real-time watching is on, but not running"
msgstr "Die Echtzeitüberwachung ist eingeschaltet, läuft aber nicht"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Not running: ${UNITS}. Real-time scanning waits for the first virus signatures."
msgstr "Läuft nicht: ${UNITS}. Die Echtzeitprüfung wartet auf die ersten Virensignaturen."

#: usr/libexec/amethystora-security-status
msgid "Ransomware protection"
msgstr "Ransomware-Schutz"

#: usr/libexec/amethystora-security-status
msgid "Ransomware protection is on, but no snapshot has been taken"
msgstr "Der Ransomware-Schutz ist eingeschaltet, aber es wurde noch kein Schnappschuss erstellt"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The latest snapshot of the home folders is ${HOURS} hour old"
msgid_plural "The latest snapshot of the home folders is ${HOURS} hours old"
msgstr[0] "Der neueste Schnappschuss der persönlichen Ordner ist ${HOURS} Stunde alt"
msgstr[1] "Der neueste Schnappschuss der persönlichen Ordner ist ${HOURS} Stunden alt"

#: usr/libexec/amethystora-security-status
msgid "They are taken every hour. See why the last ones were not with:"
msgstr "Sie werden stündlich erstellt. Den Grund für die fehlenden anzeigen mit:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The home folders are snapshotted every hour. The latest is from ${AT}"
msgstr "Von den persönlichen Ordnern wird stündlich ein Schnappschuss erstellt. Der neueste ist von ${AT}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "No backup has succeeded for ${DAYS} day"
msgid_plural "No backup has succeeded for ${DAYS} days"
msgstr[0] "Seit ${DAYS} Tag ist keine Sicherung gelungen"
msgstr[1] "Seit ${DAYS} Tagen ist keine Sicherung gelungen"

#: usr/libexec/amethystora-security-status
msgid "It runs once a day. See why the last ones failed with:"
msgstr "Sie läuft einmal am Tag. Den Grund, warum die letzten fehlschlugen, anzeigen mit:"

#: usr/libexec/amethystora-security-status
msgid "The daily backup is on, but none has succeeded yet"
msgstr "Die tägliche Sicherung ist an, aber noch keine ist gelungen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Your home folder is backed up every day. The last backup succeeded ${WHEN}"
msgstr "Ihr persönlicher Ordner wird täglich gesichert. Die letzte Sicherung gelang ${WHEN}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The kernel setting ${key} is ${live}, not ${value}"
msgstr "Die Kernel-Einstellung ${key} ist ${live}, nicht ${value}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The kernel argument ${karg} is missing"
msgstr "Das Kernel-Argument ${karg} fehlt"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The kernel module ${module} is no longer blocked"
msgstr "Das Kernel-Modul ${module} ist nicht mehr gesperrt"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path} is changed on this machine"
msgstr "${path} wurde auf diesem Rechner geändert"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path}, which the image ships, is gone"
msgstr "${path}, das das Abbild mitbringt, fehlt"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path} replaces the image's ${detail}"
msgstr "${path} ersetzt ${detail} des Abbilds"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path} changes how ${detail} runs"
msgstr "${path} ändert, wie ${detail} läuft"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path} stops ${detail} from ever starting"
msgstr "${path} verhindert, dass ${detail} jemals startet"

#: usr/libexec/amethystora-security-status
msgid "Image settings"
msgstr "Einstellungen des Abbilds"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} security setting differs from the image"
msgid_plural "${N} security settings differ from the image"
msgstr[0] "${N} Sicherheitseinstellung weicht vom Abbild ab"
msgstr[1] "${N} Sicherheitseinstellungen weichen vom Abbild ab"

#: usr/libexec/amethystora-security-status
msgid "If you did not change these, find out what did. The image's own copy of anything in /etc is in /usr/etc, to compare or copy back."
msgstr "Wenn Sie diese nicht geändert haben, finden Sie heraus, was es war. Die eigene Kopie des Abbilds von allem in /etc liegt in /usr/etc, zum Vergleichen oder Zurückkopieren."

#: usr/libexec/amethystora-security-status
msgid "The image's security settings are as it ships them"
msgstr "Die Sicherheitseinstellungen des Abbilds sind so, wie es sie ausliefert"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Added on this machine: ${PATHS}"
msgstr "Auf diesem Rechner hinzugefügt: ${PATHS}"

#: usr/libexec/amethystora-security-status
msgid "/etc/ld.so.preload exists: it loads a library into every program that starts"
msgstr "/etc/ld.so.preload existiert: Es lädt eine Bibliothek in jedes Programm, das startet"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "A setuid program outside the image: ${file}"
msgstr "Ein setuid-Programm außerhalb des Abbilds: ${file}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "A plain file in /dev, where only devices belong: ${file}"
msgstr "Eine gewöhnliche Datei in /dev, wo nur Geräte hingehören: ${file}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The kernel module ${name} did not come with this image"
msgstr "Das Kernel-Modul ${name} stammt nicht aus diesem Abbild"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The kernel module ${name} is not signed"
msgstr "Das Kernel-Modul ${name} ist nicht signiert"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The network interface ${name} reads every packet on its network (promiscuous mode)"
msgstr "Die Netzwerkschnittstelle ${name} liest jedes Paket in ihrem Netzwerk (Promiscuous Mode)"

#: usr/libexec/amethystora-security-status
msgid "Rootkit checks"
msgstr "Rootkit-Prüfungen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} thing where nothing should be"
msgid_plural "${N} things where nothing should be"
msgstr[0] "${N} Fund, wo nichts sein sollte"
msgstr[1] "${N} Funde, wo nichts sein sollte"

#: usr/libexec/amethystora-security-status
msgid "Each is either something you set up yourself, or something to look into now."
msgstr "Jeder ist entweder etwas, das Sie selbst eingerichtet haben, oder etwas, dem Sie jetzt nachgehen sollten."

#: usr/libexec/amethystora-security-status
msgid "Nothing where it should not be: no preloaded library, no setuid programs outside the image, no unknown kernel modules"
msgstr "Nichts, wo es nicht sein sollte: keine vorab geladene Bibliothek, keine setuid-Programme außerhalb des Abbilds, keine unbekannten Kernel-Module"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${program}, on port ${port}"
msgstr "${program}, auf Port ${port}"

#: usr/libexec/amethystora-security-status
msgid "Open to the network"
msgstr "Vom Netzwerk erreichbar"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} program accepts connections from other machines"
msgid_plural "${N} programs accept connections from other machines"
msgstr[0] "${N} Programm nimmt Verbindungen von anderen Rechnern an"
msgstr[1] "${N} Programme nehmen Verbindungen von anderen Rechnern an"

#: usr/libexec/amethystora-security-status
msgid "The firewall lets in only what a desktop needs from the local network, but every device on your tailnet can reach these."
msgstr "Die Firewall lässt aus dem lokalen Netzwerk nur herein, was ein Desktop braucht, aber jedes Gerät in Ihrem Tailnet kann diese erreichen."

#: usr/libexec/amethystora-security-status
msgid "No program accepts connections from other machines"
msgstr "Kein Programm nimmt Verbindungen von anderen Rechnern an"

#: usr/libexec/amethystora-security-status
msgid "App permissions"
msgstr "App-Berechtigungen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} app can leave its sandbox"
msgid_plural "${N} apps can leave their sandbox"
msgstr[0] "${N} App kann ihre Sandbox verlassen"
msgstr[1] "${N} Apps können ihre Sandbox verlassen"

#: usr/libexec/amethystora-security-status
msgid "Whatever runs in it can then do anything you can. If you did not mean it to, take it back in Flatseal, or see every app's permissions with:"
msgstr "Was darin läuft, kann dann alles, was Sie können. Falls das nicht beabsichtigt war, nehmen Sie es in Flatseal zurück, oder lassen Sie sich die Berechtigungen aller Apps anzeigen mit:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} app was given back what the image takes from every app"
msgid_plural "${N} apps were given back what the image takes from every app"
msgstr[0] "${N} App hat zurückerhalten, was das Abbild jeder App entzieht"
msgstr[1] "${N} Apps haben zurückerhalten, was das Abbild jeder App entzieht"

#: usr/libexec/amethystora-security-status
msgid "See every app's permissions with:"
msgstr "Berechtigungen aller Apps anzeigen mit:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "No app can leave its sandbox or read what you type into another (${COUNT} app checked)"
msgid_plural "No app can leave its sandbox or read what you type into another (${COUNT} apps checked)"
msgstr[0] "Keine App kann ihre Sandbox verlassen oder mitlesen, was Sie in eine andere eingeben (${COUNT} App geprüft)"
msgstr[1] "Keine App kann ihre Sandbox verlassen oder mitlesen, was Sie in eine andere eingeben (${COUNT} Apps geprüft)"

#: usr/libexec/amethystora-security-status
msgid "Files it finds are moved to quarantine. See what it found with:"
msgstr "Gefundene Dateien werden in Quarantäne verschoben. Die Funde anzeigen mit:"

#: usr/libexec/amethystora-security-status
msgid "Files it finds are deleted. See what it found with:"
msgstr "Gefundene Dateien werden gelöscht. Die Funde anzeigen mit:"

#: usr/libexec/amethystora-security-status
msgid "Files it finds are left where they are. See what it found with:"
msgstr "Gefundene Dateien bleiben, wo sie sind. Die Funde anzeigen mit:"

#: usr/libexec/amethystora-security-status
msgid "Weekly virus scan"
msgstr "Wöchentlicher Virenscan"

#: usr/libexec/amethystora-security-status
msgid "The last virus scan found something"
msgstr "Der letzte Virenscan hat etwas gefunden"

#: usr/libexec/amethystora-security-status
msgid "not yet"
msgstr "noch nicht"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Weekly virus scan, Sundays. Last run: ${LAST}"
msgstr "Wöchentlicher Virenscan, sonntags. Letzter Lauf: ${LAST}"

#: usr/libexec/amethystora-security-status
msgid "The weekly virus scan is off"
msgstr "Der wöchentliche Virenscan ist ausgeschaltet"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The weekly virus scan last ran ${DAYS} day ago"
msgid_plural "The weekly virus scan last ran ${DAYS} days ago"
msgstr[0] "Der wöchentliche Virenscan lief zuletzt vor ${DAYS} Tag"
msgstr[1] "Der wöchentliche Virenscan lief zuletzt vor ${DAYS} Tagen"

#: usr/libexec/amethystora-security-status
msgid "It runs on Sundays, or at the next start after a Sunday the machine was off. Run it now with:"
msgstr "Er läuft sonntags oder beim nächsten Start nach einem Sonntag, an dem der Rechner aus war. Jetzt ausführen mit:"

#: usr/libexec/amethystora-security-status
msgid "Virus signatures"
msgstr "Virensignaturen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Virus signatures updated ${WHEN}"
msgstr "Virensignaturen ${WHEN} aktualisiert"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Virus signatures are ${AGE} day old"
msgid_plural "Virus signatures are ${AGE} days old"
msgstr[0] "Die Virensignaturen sind ${AGE} Tag alt"
msgstr[1] "Die Virensignaturen sind ${AGE} Tage alt"

#: usr/libexec/amethystora-security-status
msgid "A clean scan proves little with signatures this old. Check this machine's network."
msgstr "Mit so alten Signaturen beweist ein sauberer Scan wenig. Prüfen Sie das Netzwerk dieses Rechners."

#: usr/libexec/amethystora-security-status
msgid "No virus signatures yet"
msgstr "Noch keine Virensignaturen"

#: usr/libexec/amethystora-security-status
msgid "clamav-freshclam.service has not finished its first download."
msgstr "clamav-freshclam.service hat seinen ersten Download noch nicht abgeschlossen."

#: usr/libexec/amethystora-security-status
msgid "Settings audit"
msgstr "Einstellungsprüfung"

#: usr/libexec/amethystora-security-status
msgid "The monthly settings audit is off"
msgstr "Die monatliche Einstellungsprüfung ist ausgeschaltet"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The settings audit last ran ${DAYS} day ago"
msgid_plural "The settings audit last ran ${DAYS} days ago"
msgstr[0] "Die Einstellungsprüfung lief zuletzt vor ${DAYS} Tag"
msgstr[1] "Die Einstellungsprüfung lief zuletzt vor ${DAYS} Tagen"

#: usr/libexec/amethystora-security-status
msgid "Run it now with:"
msgstr "Jetzt ausführen mit:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Monthly settings audit. Last run: ${LAST}"
msgstr "Monatliche Einstellungsprüfung. Letzter Lauf: ${LAST}"

#: usr/libexec/amethystora-security-status
msgid "Security key"
msgstr "Sicherheitsschlüssel"

#: usr/libexec/amethystora-security-status
msgid "Sign in, unlock the screen and approve sudo with a FIDO2 key instead of your password"
msgstr "Mit einem FIDO2-Schlüssel statt Ihres Passworts anmelden, den Bildschirm entsperren und sudo bestätigen"

#: usr/libexec/amethystora-security-status
msgid "Sign in, unlock the screen and approve sudo with a finger instead of your password"
msgstr "Mit einem Finger statt Ihres Passworts anmelden, den Bildschirm entsperren und sudo bestätigen"

#: usr/libexec/amethystora-security-status
msgid "Fingerprint"
msgstr "Fingerabdruck"

#: usr/libexec/amethystora-security-status
msgid "This machine has no fingerprint reader"
msgstr "Dieser Rechner hat keinen Fingerabdruckleser"

#: usr/libexec/amethystora-security-status
msgid "Backups"
msgstr "Sicherungen"

#: usr/libexec/amethystora-security-status
msgid "A daily restic backup to a repository that ransomware on this machine cannot delete from"
msgstr "Eine tägliche restic-Sicherung in ein Repository, aus dem Ransomware auf diesem Rechner nichts löschen kann"

#: usr/libexec/amethystora-security-status
msgid "Hourly read-only snapshots of the home folders, which ransomware running as you cannot change or delete"
msgstr "Stündliche schreibgeschützte Schnappschüsse der persönlichen Ordner, die Ransomware, die unter Ihrem Konto läuft, weder ändern noch löschen kann"

#: usr/libexec/amethystora-security-status
msgid "Needs the home folders on a btrfs subvolume"
msgstr "Erfordert die persönlichen Ordner auf einem btrfs-Subvolume"

#: usr/libexec/amethystora-security-status
msgid "Unlock the disk with the TPM"
msgstr "Festplatte mit dem TPM entsperren"

#: usr/libexec/amethystora-security-status
msgid "The TPM hands over the disk key at boot, so you stop typing the passphrase"
msgstr "Das TPM übergibt beim Start den Festplattenschlüssel, sodass Sie die Passphrase nicht mehr eingeben müssen"

#: usr/libexec/amethystora-security-status
msgid "The system's disk is not encrypted"
msgstr "Die Festplatte des Systems ist nicht verschlüsselt"

#: usr/libexec/amethystora-security-status
msgid "This machine has no usable TPM"
msgstr "Dieser Rechner hat kein nutzbares TPM"

#: usr/libexec/amethystora-security-status
msgid "Needs Secure Boot on"
msgstr "Erfordert eingeschaltetes Secure Boot"

#: usr/libexec/amethystora-security-status
msgid "USB protection"
msgstr "USB-Schutz"

#: usr/libexec/amethystora-security-status
msgid "Allows what is plugged in now, and blocks any new USB device until you allow it"
msgstr "Erlaubt, was jetzt eingesteckt ist, und blockiert jedes neue USB-Gerät, bis Sie es erlauben"

#: usr/libexec/amethystora-security-status
msgid "Browser protection"
msgstr "Browserschutz"

#: usr/libexec/amethystora-security-status
msgid "Browsers install only the extensions on a list, and web pages cannot reach USB, serial, HID or Bluetooth devices"
msgstr "Browser installieren nur Erweiterungen von einer Liste, und Webseiten können nicht auf USB-, serielle, HID- oder Bluetooth-Geräte zugreifen"

#: usr/libexec/amethystora-security-status
msgid "Key remapping"
msgstr "Tastenumbelegung"

#: usr/libexec/amethystora-security-status
msgid "Input Remapper reads every key typed, so it stays off until you need it"
msgstr "Input Remapper liest jeden Tastendruck mit und bleibt daher aus, bis Sie ihn brauchen"

#: usr/libexec/amethystora-security-status
msgid "Files a virus scan finds are moved to quarantine, where nothing can open them"
msgstr "Dateien, die ein Virenscan findet, werden in Quarantäne verschoben, wo nichts sie öffnen kann"

#: usr/libexec/amethystora-security-status
msgid "Files a virus scan finds are deleted"
msgstr "Dateien, die ein Virenscan findet, werden gelöscht"

#: usr/libexec/amethystora-security-status
msgid "Move what a virus scan finds to quarantine, or delete it, instead of only saying so"
msgstr "Was ein Virenscan findet, in Quarantäne verschieben oder löschen, statt es nur zu melden"

#: usr/libexec/amethystora-security-status
msgid "Act on what scans find"
msgstr "Auf Funde reagieren"

#: usr/libexec/amethystora-security-status
msgid "Read each change as it happens and scan every file as it is written, instead of every 15 minutes and every week"
msgstr "Jede Änderung lesen, sobald sie geschieht, und jede Datei prüfen, sobald sie geschrieben wird, statt alle 15 Minuten und jede Woche"

#: usr/libexec/amethystora-security-status
msgid "Suricata inspects every connection and says what it recognises, without blocking yet"
msgstr "Suricata untersucht jede Verbindung und meldet, was es erkennt, ohne bisher zu blockieren"

#: usr/libexec/amethystora-security-status
msgid "Inspect every connection with Suricata, and block the ones to known malware, command servers and exploits"
msgstr "Jede Verbindung mit Suricata untersuchen und die zu bekannter Schadsoftware, Steuerservern und Exploits blockieren"

#: usr/libexec/amethystora-app-permissions
msgid "Talk to every service of your session, which can run programs outside its sandbox"
msgstr "Mit jedem Dienst Ihrer Sitzung kommunizieren, worüber sich Programme außerhalb der Sandbox ausführen lassen"

#: usr/libexec/amethystora-app-permissions
msgid "Talk to every service of the system"
msgstr "Mit jedem Dienst des Systems kommunizieren"

#: usr/libexec/amethystora-app-permissions
msgid "Run programs outside its sandbox, through the Flatpak service"
msgstr "Programme außerhalb der Sandbox ausführen, über den Flatpak-Dienst"

#: usr/libexec/amethystora-app-permissions
msgid "Start programs outside its sandbox, through your session's systemd"
msgstr "Programme außerhalb der Sandbox starten, über das systemd Ihrer Sitzung"

#: usr/libexec/amethystora-app-permissions
msgid "Put a program where it starts at your next login, outside any sandbox"
msgstr "Ein Programm dort ablegen, wo es bei Ihrer nächsten Anmeldung startet, außerhalb jeder Sandbox"

#: usr/libexec/amethystora-app-permissions
msgid "Use X11, where it can read what you type into other X11 apps"
msgstr "X11 verwenden und damit mitlesen, was Sie in andere X11-Apps eingeben"

#: usr/libexec/amethystora-app-permissions
msgid "Read every key pressed on this machine"
msgstr "Jeden Tastendruck auf diesem Rechner mitlesen"

#: usr/libexec/amethystora-app-permissions
msgid "Use every device: cameras, security keys, game controllers"
msgstr "Alle Geräte verwenden: Kameras, Sicherheitsschlüssel, Gamecontroller"

#: usr/libexec/amethystora-app-permissions
msgid "Read and change every file you can"
msgstr "Jede Datei lesen und ändern, auf die Sie zugreifen können"

#: usr/libexec/amethystora-app-permissions
msgid "Read and change everything in your home folder"
msgstr "Alles in Ihrem persönlichen Ordner lesen und ändern"

#: usr/libexec/amethystora-app-permissions
msgid "Read every file you can"
msgstr "Jede Datei lesen, die Sie lesen können"

#: usr/libexec/amethystora-app-permissions
msgid "Read everything in your home folder"
msgstr "Alles in Ihrem persönlichen Ordner lesen"

#: usr/libexec/amethystora-app-permissions
msgid "Sign in with your SSH keys"
msgstr "Sich mit Ihren SSH-Schlüsseln anmelden"

#: usr/libexec/amethystora-app-permissions
msgid "Sign and decrypt with your GPG keys"
msgstr "Mit Ihren GPG-Schlüsseln signieren und entschlüsseln"

#: usr/libexec/amethystora-app-permissions
msgid "Read every password in your keyring"
msgstr "Jedes Passwort in Ihrem Schlüsselbund lesen"

#: usr/libexec/amethystora-app-permissions
msgid "granted on this machine"
msgstr "auf diesem Rechner gewährt"

#: usr/libexec/amethystora-layout-offer
msgid "Use classic windows"
msgstr "Klassische Fenster verwenden"

#: usr/libexec/amethystora-layout-offer
msgid "Keep tiling"
msgstr "Kacheln beibehalten"

#: usr/libexec/amethystora-layout-offer
msgid "Windows here tile side by side"
msgstr "Fenster werden hier nebeneinander gekachelt"

#: usr/libexec/amethystora-layout-offer
msgid "New windows open next to each other, arranged for you, and Super+Left and Super+Right move between them. If you would rather have windows that float and overlap, as on Windows and macOS, use classic windows. ame desktop layout changes it any time."
msgstr "Neue Fenster öffnen sich nebeneinander und werden für Sie angeordnet, Super+Left und Super+Right wechseln zwischen ihnen. Wenn Ihnen frei schwebende, überlappende Fenster wie unter Windows und macOS lieber sind, verwenden Sie klassische Fenster. ame desktop layout ändert das jederzeit."

#: usr/libexec/amethystora-control-list
