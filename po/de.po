msgstr "Trennt Rot und Grün deutlicher für ein Auge, das Rot schwach sieht"

#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@iarsslen.github.io/modules/access/filter.js
msgid "Green (deutan)"
msgstr "Grün (Deutan)"

#: usr/libexec/amethystora-control-list
msgid "Pulls apart reds and greens for an eye that sees green weakly"
msgstr "Trennt Rot und Grün deutlicher für ein Auge, das Grün schwach sieht"

