msgstr "Tout l’écran en gris, pour moins de distractions"

#: usr/libexec/amethystora-control-list
msgid "Switched off for now in quick settings."
msgstr "Désactivé pour le moment dans les réglages rapides."

#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@arsslensoft.github.io/modules/access/filter.js
msgid "Colour filter"
msgstr "Filtre de couleur"

