msgstr "Coincide con ${signature}. Puede devolverse a su sitio con: ame security scan restore"

#: usr/libexec/amethystora-clamav-onaccess
#, sh-format
msgid "${name} was deleted"
msgstr "${name} se eliminó"

#: usr/libexec/amethystora-clamav-onaccess
#, sh-format
msgid "It matched ${signature}. See it with: ame security scan"
msgstr "Coincidía con ${signature}. Puede verse con: ame security scan"

#: usr/libexec/amethystora-clamav-onaccess
