msgstr "Su contenedor está detenido."

#: usr/libexec/amethystora-control-list
msgid "Android apps"
msgstr "Aplicaciones Android"

#: usr/libexec/amethystora-control-list
msgid "Waydroid runs Android, LineageOS without Google's apps, in a container beside your desktop."
msgstr "Waydroid ejecuta Android, LineageOS sin las aplicaciones de Google, en un contenedor junto a su escritorio."

#: usr/libexec/amethystora-control-list
msgid "Stop…"
msgstr "Detener…"

#: usr/libexec/amethystora-control-list
msgid "Stop Android"
msgstr "Detener Android"

#: usr/libexec/amethystora-control-list
