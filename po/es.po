msgstr "Una barra superior fina y sólida, esquinas nítidas y líneas finas"

#: usr/libexec/amethystora-control-list
msgid "Capsule"
msgstr "Cápsula"

#: usr/libexec/amethystora-control-list usr/share/amethystora/just/desktop.just
msgid "The clock in a dark capsule, and everything else a pill"
msgstr "El reloj en una cápsula oscura, y todo lo demás en píldoras"

#: usr/libexec/amethystora-control-list usr/share/amethystora/just/desktop.just
msgid "Monospace, square and lined, like a terminal"
msgstr "Monoespaciado, cuadrado y con líneas, como una terminal"

#: usr/libexec/amethystora-control-list
msgid "Segments"
msgstr "Segmentos"

#: usr/libexec/amethystora-control-list usr/share/amethystora/just/desktop.just
