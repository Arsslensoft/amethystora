#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@arsslensoft.github.io/modules/present.js
msgid "Presenting"
msgstr "Presentación"

#: usr/libexec/amethystora-control-list
msgid "Present mode"
msgstr "Modo presentación"

#: usr/libexec/amethystora-control-list
msgid "A Present tile in quick settings: the screen stays awake, banners wait and the pointer is easy to follow. Super+Alt+D draws on the screen."
msgstr "Un recuadro Presentar en los ajustes rápidos: la pantalla sigue encendida, los avisos esperan y el puntero es fácil de seguir. Super+Alt+D dibuja en la pantalla."

#: usr/libexec/amethystora-control-list
msgid "A disc round the pointer"
msgstr "Un disco alrededor del puntero"

#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@arsslensoft.github.io/modules/present.js
msgid "Torch"
msgstr "Linterna"

#: usr/libexec/amethystora-control-list
msgid "Everything but a circle round the pointer dimmed"
msgstr "Todo atenuado salvo un círculo alrededor del puntero"

#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@arsslensoft.github.io/modules/present.js
msgid "No mark"
msgstr "Sin marca"

#: usr/libexec/amethystora-control-list
msgid "The pointer while presenting"
msgstr "El puntero al presentar"

#: usr/libexec/amethystora-control-list
