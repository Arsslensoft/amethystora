msgstr "De quién llegan los avisos cuando solo llegan los de las aplicaciones elegidas."

#: usr/libexec/amethystora-control-list
msgid "Notification sounds"
msgstr "Sonidos de notificación"

#: usr/libexec/amethystora-control-list
msgid "As set"
msgstr "Como estén"

#: usr/libexec/amethystora-control-list
msgid "Hides while a window touches it"
msgstr "Se oculta cuando una ventana lo toca"

#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@arsslensoft.github.io/modules/desks.js
msgid "The dock"
msgstr "El dock"

#: usr/libexec/amethystora-control-list
msgid "Solid glass and shorter motion"
msgstr "Vidrio sólido y movimiento más breve"

#: usr/libexec/amethystora-control-list
msgid "What power saver does to the desktop, for games played in a window."
msgstr "Lo que el ahorro de energía hace al escritorio, para juegos en ventana."

#: usr/libexec/amethystora-control-list
msgid "Paused"
msgstr "En pausa"

#: usr/libexec/amethystora-control-list
msgid "At its warmest"
msgstr "Al máximo de calidez"

#: usr/libexec/amethystora-control-list
msgid "Night Light"
msgstr "Luz nocturna"

#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@arsslensoft.github.io/modules/desks.js
msgid "Performance"
