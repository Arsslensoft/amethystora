msgstr "Solo las aplicaciones elegidas"

#: usr/libexec/amethystora-control-list
msgid "Held"
msgstr "Retenidos"

#: usr/libexec/amethystora-control-list
msgid "Banners"
msgstr "Avisos"

#: usr/libexec/amethystora-control-list
msgid "Calls, alarms and urgent ones always come through. Held banners wait in the list."
msgstr "Las llamadas, las alarmas y los urgentes siempre llegan. Los avisos retenidos esperan en la lista."

