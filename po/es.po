#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@arsslensoft.github.io/modules/desks.js
msgid "Power saver"
msgstr "Ahorro de energía"

#: usr/libexec/amethystora-control-list
msgid "Power mode"
msgstr "Modo de energía"

#: usr/libexec/amethystora-control-list
msgid "The theme's"
msgstr "El del tema"

#: usr/libexec/amethystora-control-list
msgid "The night picture"
msgstr "La imagen nocturna"

#: usr/libexec/amethystora-control-list
msgid "Daylight's picture for the night, over yours"
msgstr "La imagen nocturna de Luz del día, sobre la suya"

#: usr/libexec/amethystora-control-list
msgid "The screen in grey"
msgstr "La pantalla en gris"

#: usr/libexec/amethystora-control-list
msgid "One more pass over the whole screen for every frame while it is on."
msgstr "Una pasada más sobre toda la pantalla en cada fotograma mientras está activada."

#: usr/libexec/amethystora-control-list
msgid "A saved set"
msgstr "Un conjunto guardado"

#: usr/libexec/amethystora-control-list
msgid "Offered, after asking, when you pick the profile yourself."
msgstr "Se ofrece, tras preguntar, cuando usted mismo elige el perfil."

#: usr/libexec/amethystora-control-list usr/share/amethystora/just/desktop.just
msgid "Focus: Work"
msgstr "Concentración: Trabajo"

#: usr/libexec/amethystora-control-list usr/share/amethystora/just/desktop.just
msgid "Focus: Games"
