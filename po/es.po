msgstr "Menos tinte, más color, un borde superior iluminado y luz a lo largo de la parte inferior"

#: usr/libexec/amethystora-control-list usr/share/gnome-shell/extensions/amethystora-ui@arsslensoft.github.io/modules/pill/digest.js
msgid "Clear"
msgstr "Transparente"

#: usr/libexec/amethystora-control-list usr/share/amethystora/just/desktop.just
msgid "The thinnest glass and the brightest rim; it darkens by itself where text needs it"
msgstr "El vidrio más fino y el borde más brillante; se oscurece por sí solo donde el texto lo necesita"

