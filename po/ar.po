msgstr "تُضبط الساعة من 2.fedora.pool.ntp.org ومن خوادم الوقت التي تسمّيها كل شبكة، عبر NTP غير مشفّر."

#: usr/libexec/amethystora-sends
msgid "The clock"
msgstr "الساعة"

#: usr/libexec/amethystora-sends
msgid "Without a time server, the clock drifts."
msgstr "دون خادم وقت، تنحرف الساعة."

