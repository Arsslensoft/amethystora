#: usr/libexec/amethystora-security-status
msgid "Updates and boot"
msgstr "التحديثات والإقلاع"

#: usr/libexec/amethystora-security-status
msgid "Watching"
msgstr "المراقبة"

#: usr/libexec/amethystora-security-status
msgid "Apps"
msgstr "التطبيقات"

#: usr/libexec/amethystora-security-status
msgid "Scans"
msgstr "الفحوص"

#: usr/libexec/amethystora-security-status
msgid "Off unless you turned it on"
msgstr "معطّلة ما لم تفعّلها بنفسك"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${title} is on (${COMMAND})"
msgstr "${title}: مفعّل (${COMMAND})"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${title}: ${COMMAND} (${reason})"
msgstr "${title}: ${COMMAND} (${reason})"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "ok"
msgstr "جيد"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "check"
msgstr "حذر"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "off"
msgstr "خطر"

#: usr/libexec/amethystora-security-status
msgid "today"
msgstr "اليوم"

#: usr/libexec/amethystora-security-status
msgid "yesterday"
msgstr "أمس"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${DAYS} day ago"
msgid_plural "${DAYS} days ago"
msgstr[0] "اليوم"
msgstr[1] "منذ يوم واحد"
msgstr[2] "منذ يومين"
msgstr[3] "منذ ${DAYS} أيام"
msgstr[4] "منذ ${DAYS} يومًا"
msgstr[5] "منذ ${DAYS} يوم"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This machine is running ${IMAGE}"
msgstr "يشغّل هذا الجهاز ${IMAGE}"

#: usr/libexec/amethystora-security-status
msgid "Signed updates"
msgstr "التحديثات الموقّعة"

#: usr/libexec/amethystora-security-status
msgid "Updates are refused unless they carry this image's signature"
msgstr "تُرفض التحديثات ما لم تحمل توقيع هذه الصورة"

#: usr/libexec/amethystora-security-status
msgid "Signature checking is staged, and turns on at the next restart"
msgstr "التحقق من التوقيع مُجهَّز، ويُفعَّل عند إعادة التشغيل التالية"

#: usr/libexec/amethystora-security-status
msgid "Updates are not signature-checked"
msgstr "لا يُتحقق من توقيع التحديثات"

#: usr/libexec/amethystora-security-status
msgid "Anything that can answer for the registry could replace this machine's whole system."
msgstr "أي جهة تستطيع انتحال مستودع الصور قد تستبدل نظام هذا الجهاز بأكمله."

#: usr/libexec/amethystora-security-status
msgid "Fix it with this, then restart:"
msgstr "أصلحه بهذا الأمر، ثم أعد التشغيل:"

#: usr/libexec/amethystora-security-status
msgid "Updates"
msgstr "التحديثات"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This machine follows a single build (${TAG}) and will not receive updates"
msgstr "يتبع هذا الجهاز بنية واحدة (${TAG}) ولن يتلقى تحديثات"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Follow the ${STREAM} stream again with:"
msgstr "عُد إلى تتبّع المسار ${STREAM} بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "Layered packages"
msgstr "الحزم المضافة كطبقات"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${LAYERED} package is layered on this image with rpm-ostree"
msgid_plural "${LAYERED} packages are layered on this image with rpm-ostree"
msgstr[0] "لا حزم مضافة كطبقات على هذه الصورة باستخدام rpm-ostree"
msgstr[1] "حزمة واحدة مضافة كطبقة على هذه الصورة باستخدام rpm-ostree"
msgstr[2] "حزمتان مضافتان كطبقتين على هذه الصورة باستخدام rpm-ostree"
msgstr[3] "${LAYERED} حزم مضافة كطبقات على هذه الصورة باستخدام rpm-ostree"
msgstr[4] "${LAYERED} حزمة مضافة كطبقات على هذه الصورة باستخدام rpm-ostree"
msgstr[5] "${LAYERED} حزمة مضافة كطبقات على هذه الصورة باستخدام rpm-ostree"

#: usr/libexec/amethystora-security-status
msgid "Updates keep them, but each one slows every update; the image is the better place"
msgstr "تحتفظ بها التحديثات، لكن كل واحدة منها تُبطئ كل تحديث؛ والصورة هي المكان الأفضل لها"

#: usr/libexec/amethystora-security-status
msgid "System image"
msgstr "صورة النظام"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This system image was built ${WHEN}"
msgstr "بُنيت صورة النظام هذه ${WHEN}"

#: usr/libexec/amethystora-security-status
msgid "A newer system image is waiting for a restart"
msgstr "صورة نظام أحدث تنتظر إعادة التشغيل"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The one running was built ${AGE} day ago. Restart to use the new one."
msgid_plural "The one running was built ${AGE} days ago. Restart to use the new one."
msgstr[0] "بُنيت الصورة العاملة اليوم. أعد التشغيل لاستخدام الجديدة."
msgstr[1] "بُنيت الصورة العاملة منذ يوم واحد. أعد التشغيل لاستخدام الجديدة."
msgstr[2] "بُنيت الصورة العاملة منذ يومين. أعد التشغيل لاستخدام الجديدة."
msgstr[3] "بُنيت الصورة العاملة منذ ${AGE} أيام. أعد التشغيل لاستخدام الجديدة."
msgstr[4] "بُنيت الصورة العاملة منذ ${AGE} يومًا. أعد التشغيل لاستخدام الجديدة."
msgstr[5] "بُنيت الصورة العاملة منذ ${AGE} يوم. أعد التشغيل لاستخدام الجديدة."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This system image is ${AGE} day old"
msgid_plural "This system image is ${AGE} days old"
msgstr[0] "عمر صورة النظام هذه أقل من يوم"
msgstr[1] "عمر صورة النظام هذه يوم واحد"
msgstr[2] "عمر صورة النظام هذه يومان"
msgstr[3] "عمر صورة النظام هذه ${AGE} أيام"
msgstr[4] "عمر صورة النظام هذه ${AGE} يومًا"
msgstr[5] "عمر صورة النظام هذه ${AGE} يوم"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Security fixes reach this machine as new images, and none has arrived since ${SINCE}."
msgstr "تصل الإصلاحات الأمنية إلى هذا الجهاز في صور جديدة، ولم تصل أي صورة منذ ${SINCE}."

#: usr/libexec/amethystora-security-status
msgid "Update now with:"
msgstr "حدّث الآن بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "Automatic updates"
msgstr "التحديثات التلقائية"

#: usr/libexec/amethystora-security-status
msgid "Automatic updates are off"
msgstr "التحديثات التلقائية معطّلة"

#: usr/libexec/amethystora-security-status
msgid "Turn them back on with:"
msgstr "أعد تفعيلها بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "Updates install by themselves"
msgstr "تُثبَّت التحديثات تلقائيًا"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The last update that finished was ${DAYS} day ago"
msgid_plural "The last update that finished was ${DAYS} days ago"
msgstr[0] "آخر تحديث اكتمل كان اليوم"
msgstr[1] "آخر تحديث اكتمل كان منذ يوم واحد"
msgstr[2] "آخر تحديث اكتمل كان منذ يومين"
msgstr[3] "آخر تحديث اكتمل كان منذ ${DAYS} أيام"
msgstr[4] "آخر تحديث اكتمل كان منذ ${DAYS} يومًا"
msgstr[5] "آخر تحديث اكتمل كان منذ ${DAYS} يوم"

#: usr/libexec/amethystora-security-status
msgid "Updates start, but do not get to the end. System Updates shows why, or run one here:"
msgstr "تبدأ التحديثات لكنها لا تبلغ نهايتها. يُظهر تطبيق «تحديثات النظام» السبب، أو شغّل تحديثًا هنا:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Updates install by themselves. The last one finished ${WHEN}"
msgstr "تُثبَّت التحديثات تلقائيًا. اكتمل آخرها ${WHEN}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${name}, never upgraded"
msgstr "${name}، لم تُرقَّ قط"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${name}, last upgraded ${WHEN}"
msgstr "${name}، آخر ترقية ${WHEN}"

#: usr/libexec/amethystora-security-status
msgid "Containers"
msgstr "الحاويات"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} container has not been upgraded for two weeks"
msgid_plural "${N} containers have not been upgraded for two weeks"
msgstr[0] "لا حاويات لم تُرقَّ منذ أسبوعين"
msgstr[1] "حاوية واحدة لم تُرقَّ منذ أسبوعين"
msgstr[2] "حاويتان لم تُرقَّيا منذ أسبوعين"
msgstr[3] "${N} حاويات لم تُرقَّ منذ أسبوعين"
msgstr[4] "${N} حاوية لم تُرقَّ منذ أسبوعين"
msgstr[5] "${N} حاوية لم تُرقَّ منذ أسبوعين"

#: usr/libexec/amethystora-security-status
msgid "What runs in a container goes without the fixes its distribution has published since. Upgrade them now with:"
msgstr "ما يعمل في الحاوية يبقى دون الإصلاحات التي نشرتها توزيعتها منذ ذلك الحين. رقِّها الآن بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "The container amethystora-pkg manages is upgraded every day"
msgstr "تُرقّى كل يوم الحاوية التي يديرها amethystora-pkg"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The ${COUNT} container amethystora-pkg manages is upgraded every day"
msgid_plural "The ${COUNT} containers amethystora-pkg manages are upgraded every day"
msgstr[0] "لا يدير amethystora-pkg أي حاوية"
msgstr[1] "تُرقّى كل يوم الحاوية التي يديرها amethystora-pkg"
msgstr[2] "تُرقّى كل يوم الحاويتان اللتان يديرهما amethystora-pkg"
msgstr[3] "تُرقّى كل يوم الحاويات التي يديرها amethystora-pkg، وعددها ${COUNT}"
msgstr[4] "تُرقّى كل يوم الحاويات التي يديرها amethystora-pkg، وعددها ${COUNT}"
msgstr[5] "تُرقّى كل يوم الحاويات التي يديرها amethystora-pkg، وعددها ${COUNT}"

#: usr/libexec/amethystora-security-status
msgid "Verified system files"
msgstr "ملفات نظام متحقَّق منها"

#: usr/libexec/amethystora-security-status
msgid "The running system is on composefs: /usr is verified as it is read, not only when pulled"
msgstr "النظام العامل على composefs: يُتحقق من ‎/usr أثناء قراءته، لا عند سحبه فقط"

#: usr/libexec/amethystora-security-status
msgid "/usr is read-only and replaced whole by each update, but is not re-verified as it is read"
msgstr "المجلد ‎/usr للقراءة فقط ويُستبدل بالكامل مع كل تحديث، لكن لا يُعاد التحقق منه أثناء قراءته"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot"
msgstr "Secure Boot"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot is on: this machine boots only a kernel it has checked"
msgstr "ميزة Secure Boot مفعّلة: لا يُقلع هذا الجهاز إلا بنواة تحقّق منها"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot is off"
msgstr "ميزة Secure Boot معطّلة"

#: usr/libexec/amethystora-security-status
msgid "The kernel protections below rest on it. Without it, anything that reaches root can boot a different kernel and step around them."
msgstr "تعتمد عليها حمايات النواة أدناه. ومن دونها، يستطيع أي شيء يبلغ صلاحيات الجذر أن يُقلع بنواة أخرى ويلتفّ عليها."

#: usr/libexec/amethystora-security-status
msgid "Turn Secure Boot on in this machine's firmware, then run:"
msgstr "فعّل Secure Boot من البرنامج الثابت لهذا الجهاز، ثم نفّذ:"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot state unknown (no EFI on this machine, or its firmware will not say)"
msgstr "حالة Secure Boot مجهولة (لا EFI في هذا الجهاز، أو أن برنامجه الثابت لا يُفصح عنها)"

#: usr/libexec/amethystora-security-status
msgid "Signing keys"
msgstr "مفاتيح التوقيع"

#: usr/libexec/amethystora-security-status
msgid "This image's signing keys are enrolled"
msgstr "مفاتيح توقيع هذه الصورة مسجّلة"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Not enrolled: ${CERT}"
msgstr "غير مسجّل: ${CERT}"

#: usr/libexec/amethystora-security-status
msgid "What it signs, such as evdi for DisplayLink docks, will not load."
msgstr "لن يُحمَّل ما يوقّعه، مثل evdi لمحطات إرساء DisplayLink."

#: usr/libexec/amethystora-security-status
msgid "Enroll it with:"
msgstr "سجّله بالأمر:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Enrollment of ${CERT} is waiting for the next restart"
msgstr "تسجيل ${CERT} ينتظر إعادة التشغيل التالية"

#: usr/libexec/amethystora-security-status
msgid "Finish it in the blue MOK manager screen that appears during boot."
msgstr "أكمله في شاشة MOK manager الزرقاء التي تظهر أثناء الإقلاع."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${cert} is not on this machine"
msgstr "الملف ‎${cert} غير موجود على هذا الجهاز"

#: usr/libexec/amethystora-security-status
msgid "Whether its key is enrolled cannot be checked without it."
msgstr "لا يمكن التحقق من تسجيل مفتاحه من دونه."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Could not tell whether ${CERT} is enrolled"
msgstr "تعذّرت معرفة ما إذا كان ${CERT} مسجّلًا"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "mokutil said: ${rest}"
msgstr "قال mokutil: ${rest}"

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown"
msgstr "إقفال النواة"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Kernel lockdown is on (${LOCKDOWN}): root cannot rewrite the running kernel"
msgstr "إقفال النواة مفعّل (${LOCKDOWN}): لا يستطيع المستخدم الجذر تعديل النواة العاملة"

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown is off, as it is on every NVIDIA image"
msgstr "إقفال النواة معطّل، كما هو الحال في كل صور NVIDIA"

#: usr/libexec/amethystora-security-status
msgid "The NVIDIA driver is a module signed with this machine's own key, and lockdown would leave a machine without Secure Boot with no graphics driver at all."
msgstr "مشغّل NVIDIA وحدة موقّعة بمفتاح هذا الجهاز نفسه، والإقفال سيترك الجهاز الذي لا يعمل فيه Secure Boot دون أي مشغّل رسوميات على الإطلاق."

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown is off"
msgstr "إقفال النواة معطّل"

#: usr/libexec/amethystora-security-status
msgid "Turn it back on with:"
msgstr "أعد تفعيله بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "Firmware security"
msgstr "أمان البرنامج الثابت"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "fwupd rates this machine's firmware protections ${LEVEL} of 5, and something running weakens them"
msgstr "يقيّم fwupd حمايات البرنامج الثابت لهذا الجهاز بـ${LEVEL} من 5، وثمة شيء يعمل يُضعفها"

#: usr/libexec/amethystora-security-status
msgid "Every protection fwupd looks at, with what each is:"
msgstr "كل حماية يفحصها fwupd، مع شرح كل منها:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "fwupd rates this machine's firmware protections ${LEVEL} of 5"
msgstr "يقيّم fwupd حمايات البرنامج الثابت لهذا الجهاز بـ${LEVEL} من 5"

#: usr/libexec/amethystora-security-status
msgid "That is mostly up to the machine's maker. Every protection fwupd looks at, with what each is:"
msgstr "يعود ذلك في الغالب إلى صانع الجهاز. كل حماية يفحصها fwupd، مع شرح كل منها:"

#: usr/libexec/amethystora-security-status
msgid "Audit log"
msgstr "سجل التدقيق"

#: usr/libexec/amethystora-security-status
msgid "The audit log is recording"
msgstr "سجل التدقيق يسجّل"

#: usr/libexec/amethystora-security-status
msgid "The audit log is not recording"
msgstr "سجل التدقيق لا يسجّل"

#: usr/libexec/amethystora-security-status
msgid "Start it with:"
msgstr "شغّله بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "Audit rules"
msgstr "قواعد التدقيق"

#: usr/libexec/amethystora-security-status
msgid "Audit rules are immutable until the next reboot"
msgstr "قواعد التدقيق غير قابلة للتغيير حتى إعادة التشغيل التالية"

#: usr/libexec/amethystora-security-status
msgid "Failed logins"
msgstr "محاولات الولوج الفاشلة"

#: usr/libexec/amethystora-security-status
msgid "Repeated failed logins get the address blocked (ame security addresses)"
msgstr "تكرار محاولات الولوج الفاشلة يحظر العنوان (ame security addresses)"

#: usr/libexec/amethystora-security-status
msgid "fail2ban is not running"
msgstr "الخدمة fail2ban لا تعمل"

#: usr/libexec/amethystora-security-status
msgid "Firewall"
msgstr "الجدار الناري"

#: usr/libexec/amethystora-security-status
msgid "Firewall is on the amethystora zone: nothing incoming that a desktop does not need"
msgstr "الجدار الناري على المنطقة amethystora: لا يدخل شيء لا يحتاجه سطح المكتب"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Firewall default zone is ${ZONE}, not amethystora"
msgstr "المنطقة المبدئية للجدار الناري هي ${ZONE}، لا amethystora"

#: usr/libexec/amethystora-security-status
msgid "Put it back with:"
msgstr "أعده بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "Suricata blocks connections to known malware, command servers and exploits"
msgstr "يحظر Suricata الاتصالات بالبرمجيات الخبيثة المعروفة وخوادم التحكم وأدوات الاستغلال"

#: usr/libexec/amethystora-security-status
msgid "Suricata inspects every connection and says what it recognises, without blocking"
msgstr "يفحص Suricata كل اتصال ويُبلغ بما يتعرّف عليه، دون حظر"

#: usr/libexec/amethystora-security-status
msgid "Network protection"
msgstr "حماية الشبكة"

#: usr/libexec/amethystora-security-status
msgid "Network protection is on, but not running"
msgstr "حماية الشبكة مفعّلة، لكنها لا تعمل"

#: usr/libexec/amethystora-security-status
msgid "Connections pass without being inspected until it runs again. Start it with:"
msgstr "تمر الاتصالات دون فحص حتى تعمل مجددًا. شغّلها بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "Network protection is running, but no traffic reaches it"
msgstr "حماية الشبكة تعمل، لكن لا تصلها أي حركة مرور"

#: usr/libexec/amethystora-security-status
msgid "Its nftables table (inet amethystora-ips) is gone, so connections pass without being inspected. Put it back with:"
msgstr "اختفى جدول nftables الخاص بها (inet amethystora-ips)، فصارت الاتصالات تمر دون فحص. أعده بالأمر:"

#: usr/libexec/amethystora-security-status
msgid "Network protection has no rules yet"
msgstr "لا قواعد لحماية الشبكة بعد"

#: usr/libexec/amethystora-security-status
msgid "Nothing is recognised until the rules have downloaded once. Download them now with:"
msgstr "لا يُتعرّف على شيء حتى تُنزَّل القواعد مرة واحدة. نزّلها الآن بالأمر:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The network protection rules are ${DAYS} day old"
msgid_plural "The network protection rules are ${DAYS} days old"
msgstr[0] "عمر قواعد حماية الشبكة أقل من يوم"
msgstr[1] "عمر قواعد حماية الشبكة يوم واحد"
msgstr[2] "عمر قواعد حماية الشبكة يومان"
