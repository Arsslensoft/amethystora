#: usr/libexec/amethystora-sends
msgid "Containers' upgrades"
msgstr "ترقيات الحاويات"

#: usr/libexec/amethystora-sends
msgid "Every day, each container asks its distribution's mirrors for its package list."
msgstr "كل يوم، تطلب كل حاوية قائمة حزمها من مرايا توزيعتها."

