#, sh-format
msgid "There is no file ${shown}."
msgstr ""

#: usr/libexec/amethystora-windows-program
msgid "This needs a terminal to ask in."
msgstr ""

#: usr/libexec/amethystora-windows-program
msgid "Signature: it does NOT match the program: the file was changed after it was signed."
msgstr ""

#: usr/libexec/amethystora-windows-program
msgid "Signature: none. Nothing says who made it."
msgstr ""

#: usr/libexec/amethystora-windows-program
msgid "Signature: it could not be read, so nothing here says who made it."
msgstr ""

#: usr/libexec/amethystora-windows-program
#, sh-format
msgid "Signed by: ${publisher}. The signature checks out."
msgstr ""

#: usr/libexec/amethystora-windows-program
#, sh-format
msgid "Signed in the name of ${publisher}, which this machine cannot confirm: the certificate is not from an authority it trusts, or has expired."
msgstr ""

#: usr/libexec/amethystora-windows-program
#, sh-format
msgid "${shown} is not a program you can run. It is a part of Windows, or of a Windows program: a library, a driver or a firmware program, which only works inside it."
msgstr ""

