# Custom keybindings are a relocatable schema, so they cannot go in a gschema override: only the list
# of paths can (custom-keybindings in zz0-amethystora-modifications). The entries live here.
# Numbering starts at 20 to stay clear of the ones 02-amethystora-keybindings ships (custom0..custom5;
# custom6, Smile's second key, went when Super+. became the emoji picker's).

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom20]
binding='<Super>Return'
command='/usr/libexec/amethystora-workspace-terminal'
name='Terminal'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom21]
binding='<Super><Alt>space'
command='amethystora-menu'
name='Amethystora menu'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom22]
binding='<Super><Control><Shift>space'
command='amethystora-menu theme'
name='Theme picker'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom23]
binding='<Super><Control>space'
command='amethystora-theme bg next'
name='Next background'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom24]
binding='<Super><Control>d'
command='amethystora-theme toggle'
name='Switch between the light and dark theme'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom25]
binding='<Super><Shift>f'
command='nautilus --new-window'
name='Files'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom26]
binding='<Super><Shift>b'
command='firefox --new-window'
name='Browser'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom27]
binding='<Super><Control><Shift>a'
command='amethystora-agent'
name='AI agent'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom28]
binding='<Super>F1'
command='amethystora-manual'
name='Amethystora Manual'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom29]
binding='<Super><Control><Shift>c'
command='amethystora-control'
name='Amethystora Control'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom30]
binding='<Super><Alt>n'
command='amethystora-notes capture'
name='Quick note'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom31]
binding='<Super><Control>t'
command='amethystora-theme next'
name='Next theme'
