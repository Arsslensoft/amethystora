#!/usr/bin/bash
# What keeps a device from working that this machine can tell by itself: a device no driver took, firmware the
# kernel asked for and did not get, a kernel module it refused, and the cases Amethystora knows (NVIDIA's driver
# not loaded, a Broadcom Wi-Fi card no driver drives, the Xbox wireless adapter without its firmware, a DisplayLink
# dock whose driver the kernel refused). Each with
# the command that fixes it where there is one, or the manual's section. It reads and changes nothing.
#
#   amethystora-driver-status [--json]   the findings: asked of the machine now when run as root, who can read
#                                        the kernel's log, otherwise as the last check saved them
#   amethystora-driver-status check      as root: ask, save them in /var/lib/amethystora/drivers/status.json for
#                                        everyone, and say each new one once per machine, with a button that
#                                        opens its fix in a terminal (amethystora-driver-check.timer)
#
# The JSON is {checked, findings: [{id, kind, device, text, fix, manual}]}, kind one of no-driver, firmware,
# refused, nvidia, broadcom-wifi, xbox-adapter and displaylink. AMETHYSTORA_DRIVERS_ROOT (a stand-in /sys, /proc/cmdline,
# image-info.json and firmware folder), AMETHYSTORA_DRIVERS_LOG (the kernel's log) and AMETHYSTORA_DRIVERS_MOK
# (what amethystora-mok-status says) are for the tests in 20-tests.sh, AMETHYSTORA_DRIVERS_STATE (the folder of what
# it saved and said) and AMETHYSTORA_DRIVERS_NOTIFY (amethystora-notify-users) for test-driver-status.sh.

set -uo pipefail

# Marks a message for po/amethystora.pot; amethystora-notify-users translates it for each account it tells
N_() { printf '%s' "$1"; }

ROOT="${AMETHYSTORA_DRIVERS_ROOT:-}"
STATE="${AMETHYSTORA_DRIVERS_STATE:-/var/lib/amethystora/drivers}"
NOTIFY="${AMETHYSTORA_DRIVERS_NOTIFY:-/usr/libexec/amethystora-notify-users}"
SAVED="${STATE}/status.json"
INFO="${ROOT}/usr/share/amethystora/image-info.json"
FIRMWARE=/var/lib/amethystora/firmware
PCI="${ROOT}/sys/bus/pci/devices"
USB="${ROOT}/sys/bus/usb/devices"
MODE="${1:-}"
case "${MODE}" in
    "" | --json | check) ;;
    *) echo "usage: ${0##*/} [--json|check]" >&2; exit 64 ;;
esac
# At boot the check can start before the kernel has bound every driver (a DisplayLink dock starts it within a minute):
# the devices udev is still adding are waited for first, so that a driver still loading is not said to be missing
[[ "${MODE}" == check && -z "${ROOT}" ]] && { udevadm settle --timeout=60 >/dev/null 2>&1 || true; }

print() {
    if [[ "${MODE}" == --json ]]; then
        cat
    else
        jq -r '(.findings | if length == 0 then "No missing or refused driver found." else .[] |
            "\(.device): \(.text)" + (if .fix then "\n    Fix: \(.fix)" else "\n    See the manual: \(.manual)" end) end),
            "(checked \(.checked | todate))"'
    fi
}

# Anyone else reads what the last check saved
if [[ "${EUID}" -ne 0 && -z "${ROOT}" ]]; then
    [[ "${MODE}" == check ]] && { echo "The check needs root." >&2; exit 77; }
    if [[ ! -s "${SAVED}" ]]; then
        echo "No check has run yet: it runs a few minutes after each start, or now with sudo." >&2
        exit 1
    fi
    print <"${SAVED}"
    [[ "${MODE}" == --json ]] || echo "As the last check found it: sudo ame system drivers looks again."
    exit 0
fi

FINDINGS=()
# found ID KIND DEVICE TEXT FIX MANUAL. A device's name can be what the device itself says (a USB product
# string), so it is cleaned before it reaches a terminal or a notification.
found() {
    local device
    device="$(/usr/libexec/amethystora-security-text --max 200 "$3" 2>/dev/null || printf '%s' "$3")"
    FINDINGS+=("$(jq -nc --arg id "$1" --arg kind "$2" --arg device "${device}" --arg text "$4" --arg fix "$5" --arg manual "$6" \
        '{$id, $kind, $device, $text, fix: (if $fix == "" then null else $fix end), $manual}')")
}

# A PCI device as lspci names it, or by its IDs where lspci does not know it
pci_name() {
    local name
    [[ -z "${ROOT}" ]] && name="$(lspci -s "$1" 2>/dev/null | sed 's/^[^ ]* //')"
    echo "${name:-PCI device $(cat "${PCI}/$1/vendor" 2>/dev/null):$(cat "${PCI}/$1/device" 2>/dev/null) at $1}"
}

if [[ -n "${AMETHYSTORA_DRIVERS_LOG:-}" ]]; then
    LOG="$(cat "${AMETHYSTORA_DRIVERS_LOG}")"
else
    # The kernel's own lines, and systemd's when it could not load a module, this boot
    LOG="$(timeout 30 journalctl -b -o cat --no-pager --grep 'firmware|rejected|Lockdown|Failed to insert module' \
        _TRANSPORT=kernel + SYSLOG_IDENTIFIER=systemd-modules-load 2>/dev/null)"
fi
if [[ -n "${AMETHYSTORA_DRIVERS_MOK:-}" ]]; then
    MOK="$(cat "${AMETHYSTORA_DRIVERS_MOK}")"
else
    MOK="$(/usr/libexec/amethystora-mok-status 2>/dev/null)"
fi
# Secure Boot, from the firmware's own variable: its last byte is 1 when it is on
SECURE_BOOT=false
[[ "$(od -An -tu1 -j4 -N1 "${ROOT}"/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ')" == 1 ]] &&
    SECURE_BOOT=true
CMDLINE=" $(cat "${ROOT}/proc/cmdline" 2>/dev/null) "
FLAVOR="$(jq -r '."image-flavor" // "main"' "${INFO}" 2>/dev/null)"
STREAM="$(jq -r '."image-tag" // "stable"' "${INFO}" 2>/dev/null)"

# A module the kernel would not load, and why: a key Secure Boot does not trust yet, or lockdown without Secure Boot
UNTRUSTED=false
grep -q "^not-enrolled " <<<"${MOK}" && UNTRUSTED=true
refusal_fix() {
    if [[ "${SECURE_BOOT}" == true && "${UNTRUSTED}" == true ]]; then
        echo "ame security secure-boot"
    elif [[ "${SECURE_BOOT}" != true && "${CMDLINE}" == *" lockdown="* && ! -e "${ROOT}/usr/share/amethystora/sealed" ]]; then
        # A sealed image's kernel arguments are inside its signed kernel, and cannot change
        echo "ame security lockdown off"
    fi
}

# --- A DisplayLink dock --------------------------------------------------------------------------------------
# DisplayLink's own USB vendor id, which rebranded docks keep; a dock that takes its video over DisplayPort has
# none and needs nothing of this. The package's udev rule starts displaylink.service when such a device arrives,
# whose condition loads evdi. The check runs after it, so evdi not loaded means the kernel refused it. The key is the one
# evdi is signed with (03-install-kernel-akmods.sh), and enrolling is offered only where it can help: without
# Secure Boot the kernel trusts no enrolled key, so there only lockdown stands in the way. The texts are messages
# of their own, translated for each account. DOCK_ID is the machine's state, said once per state (below).
DOCK=false
DOCK_ID=""
for device in "${USB}"/*; do
    [[ "$(cat "${device}/idVendor" 2>/dev/null)" == 17e9 ]] || continue
    DOCK=true
    fix=""
    manual=hardware#secure-boot
    if [[ -e "${ROOT}/sys/module/evdi" ]]; then
        systemctl is-active -q displaylink.service && break
        DOCK_ID=displaylink:service
        manual=displays
        text="$(N_ "Its driver has loaded, but its screens also need displaylink.service, which is not running. It starts when the dock is plugged in, unless something stopped it.")"
    elif [[ "${SECURE_BOOT}" == true ]]; then
        case "$(sed -n 's|^\([a-z-]*\) .*/amethystora-modules\.der.*|\1|p' <<<"${MOK}")" in
            not-enrolled)
                DOCK_ID=displaylink:needs-enrollment
                fix="ame security secure-boot"
                text="$(N_ "Its screens need a driver, evdi, and stay dark until Secure Boot trusts the driver's key. Enrolling it asks for your password, then at the next restart a blue screen asks you to accept the key. Nothing changes unless you go on.")"
                ;;
            pending)
                DOCK_ID=displaylink:enrollment-pending
                text="$(N_ "Its screens stay dark until you restart and accept the driver's key: on the blue screen, choose Enroll MOK, Continue and Yes, then type the password amethystora.")"
                ;;
            *)
                DOCK_ID=displaylink:refused
                manual=common-problems#a-displaylink-dock-shows-nothing
                text="$(N_ "Its screens stay dark: their driver, evdi, did not load, and its key is not what stands in the way.")"
                ;;
        esac
    elif [[ -e "${ROOT}/usr/share/amethystora/sealed" ]]; then
        DOCK_ID=displaylink:sealed-no-secure-boot
        text="$(N_ "Its screens stay dark: on a sealed image without Secure Boot, the kernel refuses their driver, evdi, and its arguments cannot change. Turn Secure Boot on in the machine's firmware.")"
    elif [[ -n "$(refusal_fix)" ]]; then
        DOCK_ID=displaylink:lockdown
        fix="$(refusal_fix)"
        text="$(N_ "Its screens stay dark: with Secure Boot off, kernel lockdown refuses their driver, evdi, and enrolling a key cannot help. Turn Secure Boot on in the firmware and enroll the key, which keeps lockdown, or turn lockdown off, which costs some protection. Nothing changes unless you choose.")"
    else
        DOCK_ID=displaylink:refused
        manual=common-problems#a-displaylink-dock-shows-nothing
        text="$(N_ "Its screens stay dark: their driver, evdi, did not load.")"
    fi
    found "${DOCK_ID}" displaylink "$(cat "${device}/product" 2>/dev/null || echo "DisplayLink dock")" "${text}" "${fix}" "${manual}"
    break
done

# --- Firmware the kernel asked for and did not get ---------------------------------------------------------
# Drivers ask for optional files too, newest first, so a file counts only when its device was left without a
# driver, or when the driver says it gave up
declare -A COVERED=()
while IFS= read -r line; do
    if [[ "${line}" =~ ^[^\ ]+\ ([0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]):\ Direct\ firmware\ load\ for\ ([^ ]+)\ failed ]]; then
        address="${BASH_REMATCH[1]}"
        file="${BASH_REMATCH[2]}"
        [[ -e "${PCI}/${address}" && ! -e "${PCI}/${address}/driver" && -z "${COVERED[${address}]+set}" ]] || continue
        COVERED["${address}"]=1
        found "firmware:${file}" firmware "$(pci_name "${address}")" \
            "Its driver stopped without the firmware ${file}, which this image does not have." "" hardware#when-a-device-does-not-work
    elif [[ "${line}" =~ ^([^\ ]+)\ ([^\ ]+):\ no\ suitable\ firmware\ found ]]; then
        found "firmware:${BASH_REMATCH[1]}:${BASH_REMATCH[2]}" firmware "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}" \
            "Its driver found no firmware it could use, which this image does not have." "" hardware#when-a-device-does-not-work
    fi
done < <(grep -E 'Direct firmware load for|no suitable firmware found' <<<"${LOG}")

# --- Modules the kernel refused ----------------------------------------------------------------------------
if grep -qE 'Loading of (module with unavailable key|unsigned module) is rejected|Lockdown: [^:]*: unsigned module loading is restricted' <<<"${LOG}"; then
    modules="$(grep -oE "Failed to insert module '[^']+'" <<<"${LOG}" | cut -d"'" -f2 | sort -u | paste -sd' ')"
    fix="$(refusal_fix)"
    if [[ "${SECURE_BOOT}" == true ]]; then
        why="Secure Boot is on, and the key it is signed with is not one this machine trusts."
    elif [[ "${CMDLINE}" == *" lockdown="* ]]; then
        why="Kernel lockdown is on without Secure Boot, so the kernel trusts no key but its own."
    else
        why="The kernel takes signed modules only, and does not trust the key it is signed with."
    fi
    # A refusal with no module named, when the dock above already says that it was evdi, is the same thing
    [[ -n "${modules}" || -z "${DOCK_ID}" ]] &&
        found "refused:${modules:-module}" refused "${modules:-A kernel module}" "The kernel refused to load it. ${why}" "${fix}" hardware#secure-boot
fi

# --- NVIDIA ------------------------------------------------------------------------------------------------
# A display controller of NVIDIA's that nothing drives: the wrong image for it, the key not enrolled, or lockdown
for device in "${PCI}"/*; do
    [[ "$(cat "${device}/class" 2>/dev/null)" == 0x03* && "$(cat "${device}/vendor" 2>/dev/null)" == 0x10de &&
        ! -e "${device}/driver" ]] || continue
    address="${device##*/}"
    COVERED["${address}"]=1
    offer="$(AMETHYSTORA_PCI_DEVICES="${PCI}" AMETHYSTORA_IMAGE_INFO="${INFO}" /usr/libexec/amethystora-gpu-check offer)"
    fix=""
    if [[ -n "${offer}" ]]; then
        text="Nothing drives it on this image: ${offer#* } carries the driver for it."
        fix="ame system rebase ${offer#* } ${STREAM}"
    elif [[ "${FLAVOR}" == nvidia-* ]]; then
        fix="$(refusal_fix)"
        if [[ "${fix}" == *secure-boot ]]; then
            text="NVIDIA's driver did not load: Secure Boot is on, and the key it is signed with is not enrolled."
        elif [[ -n "${fix}" ]]; then
            text="NVIDIA's driver did not load: kernel lockdown is on without Secure Boot, which refuses it."
        else
            text="NVIDIA's driver did not load."
        fi
    else
        text="Nothing drives it."
    fi
    found "nvidia:${address}" nvidia "$(pci_name "${address}")" "${text}" "${fix}" hardware#graphics
    break
done

# --- Devices no driver took --------------------------------------------------------------------------------
# Only the kinds a person notices: storage, network, graphics, sound and video, USB controllers and wireless.
# Bridges, the chipset's own functions and the like never have one.
for device in "${PCI}"/*; do
    [[ -e "${device}/class" && ! -e "${device}/driver" ]] || continue
    address="${device##*/}"
    [[ -z "${COVERED[${address}]+set}" ]] || continue
    class="$(cat "${device}/class")"
    vendor="$(cat "${device}/vendor" 2>/dev/null)"
    case "${class}" in
        0x01* | 0x02* | 0x03* | 0x04* | 0x0c03* | 0x0d*) ;;
        *) continue ;;
    esac
    if [[ "${class}" == 0x0280* && "${vendor}" == 0x14e4 ]]; then
        found "broadcom-wifi:${address}" broadcom-wifi "$(pci_name "${address}")" \
            "This Broadcom Wi-Fi card has no driver on Amethystora: the only one there is for it has security holes nobody may fix. A USB Wi-Fi adapter works instead." \
            "" wireless#wi-fi
    else
        found "no-driver:${address}:$(cat "${device}/device" 2>/dev/null)" no-driver "$(pci_name "${address}")" \
            "No driver took this device." "" hardware#when-a-device-does-not-work
    fi
done
# USB: only wireless and network adapters, since a vendor's own devices are often driven from programs instead
for interface in "${USB}"/*:*; do
    [[ -e "${interface}/bInterfaceClass" && ! -e "${interface}/driver" ]] || continue
    case "$(cat "${interface}/bInterfaceClass")" in e0 | 02) ;; *) continue ;; esac
    parent="${USB}/$(basename "${interface%%:*}")"
    ids="$(cat "${parent}/idVendor" 2>/dev/null):$(cat "${parent}/idProduct" 2>/dev/null)"
    found "no-driver:usb:${ids}" no-driver "$(cat "${parent}/product" 2>/dev/null || echo "USB device ${ids}")" \
        "No driver took this USB adapter." "" hardware#when-a-device-does-not-work
done

# --- The Xbox wireless adapter -----------------------------------------------------------------------------
for device in "${USB}"/*; do
    [[ "$(cat "${device}/idVendor" 2>/dev/null)" == 045e ]] || continue
    product="$(cat "${device}/idProduct" 2>/dev/null)"
    [[ " 02e6 02fe 02f9 091e " == *" ${product} "* ]] || continue
    [[ -s "${ROOT}${FIRMWARE}/xone_dongle_${product}.bin" && "${CMDLINE}" == *" firmware_class.path=${FIRMWARE} "* ]] &&
        continue
    found "xbox-adapter:${product}" xbox-adapter "Xbox wireless adapter" \
        "It needs Microsoft's firmware, which the image may not pass on: setting it up downloads it from Microsoft." \
        "ame apps xbox-adapter on" devices#game-controllers
done

STATUS="$(printf '%s\n' "${FINDINGS[@]}" | jq -sc --argjson checked "$(date +%s)" '{$checked, findings: map(select(. != null))}')"
[[ "${MODE}" == check ]] || { print <<<"${STATUS}"; exit 0; }

mkdir -p "${STATE}"
chmod 0755 "${STATE}"
printf '%s\n' "${STATUS}" >"${SAVED}.new" && chmod 0644 "${SAVED}.new" && mv "${SAVED}.new" "${SAVED}"

# Each new finding is said once per machine, to somebody logged in to hear it: the login screen has a session bus
# too, and a finding that reached nobody is said at a later check
SAID="${STATE}/said"
# A dock's state again when it changes, so with a dock here only its present state stays said; without one
# nothing has changed, and plugging it in again says nothing new
if [[ "${DOCK}" == true && -s "${SAID}" ]]; then
    { grep -v '^displaylink:' "${SAID}"; ! grep -qxF "${DOCK_ID:-none}" "${SAID}" || echo "${DOCK_ID}"; } >"${SAID}.new"
    mv "${SAID}.new" "${SAID}"
fi
while IFS=$'\t' read -r -u 3 id kind device text manual fix; do
    grep -qxF -- "${id}" "${SAID}" 2>/dev/null && continue
    echo "${id}" >>"${SAID}"
    read_more=(--action "manual=$(N_ 'Read more')")
    message=--msgid-summary
    if [[ -n "${fix}" ]]; then
        actions=(--action "fix=$(N_ 'Fix it…')")
        # One of the commands above, a word at a time
        # shellcheck disable=SC2206
        run=(/usr/libexec/amethystora-in-terminal ${fix})
    else
        actions=("${read_more[@]}")
    fi
    # A dock's texts are messages, and its buttons say what they start; the person's yes is asked in the terminal
    if [[ "${kind}" == displaylink ]]; then
        message=--msgid
        case "${id}" in
            displaylink:needs-enrollment) actions=(--action "fix=$(N_ 'Enroll the key…')" "${read_more[@]}") ;;
            displaylink:lockdown) actions=(--action "fix=$(N_ 'Turn lockdown off…')" "${read_more[@]}") ;;
        esac
    fi
    # Any other finding's text is what the check found, English; the sentence around the device and the buttons
    # are translated for each account (amethystora-notify-users)
    export device
    # Ask the agent, for an account whose agentic features are on: the finding's id, never its words
    ANSWERS="$("${NOTIFY}" "${actions[@]}" --agent "agent=$(N_ 'Ask the agent')" "${message}" \
        "$(N_ 'A device does not work: ${device}')" "${text}")" || {
        grep -vxF -- "${id}" "${SAID}" >"${SAID}.new"
        mv "${SAID}.new" "${SAID}"
        continue
    }
    while read -r user answer; do
        [[ -n "${answer}" ]] || continue
        uid="$(id -u "${user}")" || continue
        case "${answer}" in
            agent) command=(/usr/bin/amethystora-agent diagnose --driver "${id}") ;;
            manual) command=(/usr/bin/amethystora-manual "${manual}") ;;
            *) command=("${run[@]}") ;;
        esac
        runuser -u "${user}" -- env "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus" \
            "XDG_RUNTIME_DIR=/run/user/${uid}" systemd-run --user --collect --quiet "${command[@]}" || true
    done <<<"${ANSWERS}"
# The fix last: a tab is whitespace to read, which would close up an empty field in the middle
done 3< <(jq -r '.findings[] | [.id, .kind, .device, .text, .manual, (.fix // "")] | @tsv' <<<"${STATUS}")
exit 0
