#!/usr/bin/python3 -I
# Where the private things in a screenshot are (R7-67, the screenshot bar's Hide what's private): reads a PNG on standard
# input, has Tesseract read it on this computer, and prints as JSON where e-mail addresses, card numbers, phone numbers
# and bank account numbers sit, in the picture's pixels, each with its kind. Run as the account by Amethystora UI, which
# draws a solid box over each.
#
#   amethystora-cover-private        a PNG on stdin; {"boxes": [{"kind", "x", "y", "w", "h"}, ...]} on stdout
#   amethystora-cover-private tsv    the same from Tesseract's own TSV on stdin, for the build's test
#
# The words themselves stay in memory here and never leave: not on stdout, in a log or in a file. The picture travels
# through pipes alone. A few fixed patterns: it will miss things (a name, a street address, a number the reading got
# wrong), which is why the bar says "check before you send".

import ctypes
import json
import re
import resource
import subprocess
import sys

TESSERACT = '/usr/bin/tesseract'
# Sparse text: a screen is not a page of paragraphs
ARGS = [TESSERACT, 'stdin', 'stdout', '-l', 'eng', '--psm', '11', 'tsv']
TIMEOUT_S = 25
# The most a picture's reading may say, and how far a box reaches beyond its words
MOST_TSV = 16 * 1024 * 1024
PADDING = 2
# A picture is made twice as large only when that leaves it at most this many pixels: the reading of a larger one would
# not keep to the memory the scope it runs in allows (400 MB, with Python and the picture)
MOST_ENLARGED_PIXELS = 4_000_000
# A run of digits with more groups than this is judged whole; a shorter one is searched for the card, phone or account
# number inside it, the longest first
MOST_GROUPS = 12
# Two threads at most: a button pressed once should not take the whole machine
ENV = {'OMP_THREAD_LIMIT': '2', 'LC_ALL': 'C.UTF-8', 'PATH': '/usr/bin'}

EMAIL = re.compile(r"[\w.+'-]+@[\w-]+(?:\.[\w-]+)+", re.UNICODE)
DIGIT_RUN = re.compile(r'(?<![\w.,/-])\+?\(?\d[\d ().-]{6,}\d(?![\w])')
FOUR_BY_FOUR = re.compile(r'^\d{4}([ -])\d{4}\1\d{4}\1\d{3,7}$')
IBAN = re.compile(r'\b[A-Z]{2}\d{2}(?: ?[A-Z0-9]{2,4}){3,8}\b')
# After these words, the last digits of a card are still somebody's card
CARD_END = re.compile(r'\b(?:card|ending(?: in)?)\b\D{0,12}(\d{4,19}(?:[ -]\d{4}){0,3})\b', re.IGNORECASE)
IPV4 = re.compile(r'^\d{1,3}(?:\.\d{1,3}){3}$')
DATE = re.compile(r'^(?:\d{4}[-./ ]\d{1,2}[-./ ]\d{1,2}|\d{1,2}[-./ ]\d{1,2}[-./ ]\d{2,4})$')


def luhn(digits):
    total = 0
    for i, char in enumerate(reversed(digits)):
        value = int(char)
        if i % 2:
            value = value * 2 - 9 if value > 4 else value * 2
        total += value
    return total % 10 == 0


def iban_valid(text):
    compact = text.replace(' ', '')
    if not 15 <= len(compact) <= 34:
        return False
    moved = compact[4:] + compact[:4]
    return int(''.join(str(int(char, 36)) for char in moved)) % 97 == 1


def kind_of_digits(text):
    digits = re.sub(r'\D', '', text)
    if 13 <= len(digits) <= 19 and (FOUR_BY_FOUR.match(text) or luhn(digits)):
        return 'card'
    if DATE.match(text) or IPV4.match(text) or not 8 <= len(digits) <= 15:
        return None
    # Long bare numbers are mostly not phones: a phone says so with a plus, a leading 00, brackets or groups
    if text.startswith('+') or digits.startswith('00') or '(' in text or re.search(r'\d[ .-]\d', text):
        return 'phone' if len(digits) >= 9 or text.startswith('+') else None
    return None


def in_run(run):
    """The private numbers inside one run of digits, as (start, end, kind) in the run: a card is often followed on its
    line by an expiry or a code, which make the whole run something else. Every stretch from a group of digits to a
    group's end is tried, the longest first, and what is taken is not taken twice."""
    groups = [m.span() for m in re.finditer(r'\d+', run)]
    if len(groups) > MOST_GROUPS:
        kind = kind_of_digits(run)
        return [(0, len(run), kind)] if kind else []
    # The run's own start is kept for the first group: a plus or a bracket before it says phone
    starts = [0] + [first for first, _ in groups[1:]]
    candidates = [(starts[i], groups[j][1]) for i in range(len(groups)) for j in range(i, len(groups))]
    taken = []
    for start, end in sorted(candidates, key=lambda c: c[0] - c[1]):
        if any(start < last and first < end for first, last, _ in taken):
            continue
        kind = kind_of_digits(run[start:end])
        # A part of a run is a card, or a phone number that says so from its start: bare groups of digits are not
        if kind == 'phone' and (start, end) != (0, len(run)) and not (start == 0 and run.startswith(('+', '(', '00'))):
            continue
        if kind:
            taken.append((start, end, kind))
    return taken


def accounts(line):
    """Bank account numbers: an IBAN may be followed by words that fit its pattern (a BIC, a currency), so the words are
    taken off the end until the check digits are right."""
    found = []
    for m in IBAN.finditer(line):
        text = m.group()
        for word in reversed(list(re.finditer(r'\S+', text))):
            if iban_valid(text[:word.end()]):
                found.append((m.start(), m.start() + word.end(), 'account'))
                break
    return found


def spans(line):
    """What is private in one line of text: (start, end, kind), the earlier and longer kept where they overlap."""
    found = [(m.start(), m.end(), 'address') for m in EMAIL.finditer(line)]
    found += accounts(line)
    found += [(m.start(1), m.end(1), 'card') for m in CARD_END.finditer(line)]
    for m in DIGIT_RUN.finditer(line):
        found += [(m.start() + start, m.start() + end, kind) for start, end, kind in in_run(m.group())]
    kept = []
    for start, end, kind in sorted(found, key=lambda s: (s[0], s[0] - s[1])):
        if not kept or start >= kept[-1][1]:
            kept.append((start, end, kind))
    return kept


def lines_of(tsv):
    """Tesseract's words, by line: {line: [(text, left, top, width, height), ...]}."""
    lines = {}
    for row in tsv.splitlines()[1:]:
        fields = row.split('\t', 11)
        # A word is level 5, and has its text
        if len(fields) < 12 or fields[0] != '5' or not fields[11].strip():
            continue
        try:
            box = [int(value) for value in fields[6:10]]
        except ValueError:
            continue
        lines.setdefault(tuple(fields[1:5]), []).append((fields[11].strip(), *box))
    return lines


def boxes_of(tsv, scale=1):
    boxes = []
    for words in lines_of(tsv).values():
        text = ''
        places = []
        for word in words:
            places.append((len(text), len(text) + len(word[0]), word))
            text += word[0] + ' '
        for start, end, kind in spans(text):
            inside = [word for first, last, word in places if first < end and last > start]
            if not inside:
                continue
            # In the picture's own pixels again, always a little over rather than under
            left = max(0, min(word[1] for word in inside) // scale - PADDING)
            top = max(0, min(word[2] for word in inside) // scale - PADDING)
            right = max(word[1] + word[3] for word in inside) // scale + 1 + PADDING
            bottom = max(word[2] + word[4] for word in inside) // scale + 1 + PADDING
            boxes.append({'kind': kind, 'x': left, 'y': top, 'w': right - left, 'h': bottom - top})
    return boxes


def enlarged(png):
    """The picture, twice as large where it is small enough: Tesseract misreads the 11-pixel digits of a screen."""
    import gi
    gi.require_version('GdkPixbuf', '2.0')
    from gi.repository import GdkPixbuf
    loader = GdkPixbuf.PixbufLoader.new_with_type('png')
    loader.write(png)
    loader.close()
    picture = loader.get_pixbuf()
    width, height = picture.get_width(), picture.get_height()
    if width * height * 4 > MOST_ENLARGED_PIXELS:
        return png, 1
    large = picture.scale_simple(width * 2, height * 2, GdkPixbuf.InterpType.BILINEAR)
    return large.save_to_bufferv('png', [], [])[1], 2


def read_picture():
    picture, scale = enlarged(sys.stdin.buffer.read())
    libc = ctypes.CDLL(None)

    def die_with_parent():
        # PR_SET_PDEATHSIG with SIGKILL: Tesseract goes when this program does, however that comes about
        libc.prctl(1, 9)

    done = subprocess.run(ARGS, input=picture, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=ENV,
                          timeout=TIMEOUT_S, check=True, preexec_fn=die_with_parent)
    return done.stdout[:MOST_TSV].decode('utf-8', 'replace'), scale


def gi_error():
    # GLib's error, only once GLib has been loaded by a picture being read
    module = sys.modules.get('gi.repository.GLib')
    return module.Error if module else OSError


def main():
    # What it reads must not reach the disk through a core dump of this program or of Tesseract, which inherits it
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    try:
        tsv, scale = (sys.stdin.read(), 1) if sys.argv[1:] == ['tsv'] else read_picture()
    except (OSError, ValueError, subprocess.SubprocessError, gi_error()):
        # Nothing about why on stdout, and the reason never names what the picture holds
        print(json.dumps({'error': 'unreadable'}))
        return 1
    print(json.dumps({'boxes': boxes_of(tsv, scale)}))
    return 0


if __name__ == '__main__':
    sys.exit(main())
