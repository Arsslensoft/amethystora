#!/usr/bin/bash
# What this machine sends by itself, outside the features the owner chose in security.conf: to whom, when and
# what stops working without it, each with the command that switches it. The security report's "What this
# machine sends" group (amethystora-security-status), the Security app and `ame security sends` read it.
#
#   amethystora-sends            the list, for a terminal
#   amethystora-sends --json     the same as records: id, state (on while it sends, off while it does not),
#                                title, text, details and command
#
# Run as the user: the location setting is the account's own. Nothing here changes anything.

set -uo pipefail

export TEXTDOMAIN=amethystora
# shellcheck source=/dev/null
source gettext.sh

JSON=false
[[ "${1:-}" == "--json" ]] && JSON=true

HARDENING=/usr/libexec/amethystora-hardening
RECORDS=()

# row ID STATE TITLE TEXT COMMAND [DETAIL...]
row() {
    local id="$1" state="$2" title="$3" text="$4" command="$5"
    shift 5
    RECORDS+=("$(jq -nc --arg id "sends-${id}" --arg state "${state}" --arg title "${title}" --arg text "${text}" \
        --arg command "${command}" '{$id, $state, $title, $text, details: $ARGS.positional,
        command: (if $command == "" then null else $command end)}' --args "$@")")
}

sealed() { [[ -e /usr/share/amethystora/sealed ]]; }
# A switch of amethystora-hardening that is on, as the machine's owner left it
switch_on() { "${HARDENING}" is-on "$1" 2>/dev/null; }

# --- Fedora's count of its machines -----------------------------------------------------------------------

if systemctl is-enabled --quiet rpm-ostree-countme.timer 2>/dev/null; then COUNTME=on; else COUNTME=off; fi
COUNTME_DETAIL="$(gettext "Without it, Fedora counts one machine fewer and nothing on this machine changes.")"
sealed && COUNTME_DETAIL="$(gettext "This machine is sealed, and its image does not send it.")"
row countme "${COUNTME}" "$(gettext "Fedora's count of its machines")" \
    "$(gettext "Once a week at most, Fedora's mirror list is told this is Amethystora, which Fedora version and image it runs, and how many weeks it has been counted. No identifier is sent, but Fedora sees the address.")" \
    "ame security countme" "${COUNTME_DETAIL}"

# --- The connectivity check ---------------------------------------------------------------------------------

# The setting NetworkManager really uses: GNOME Settings changes it too, and its choice is kept apart from the
# files of /etc, so the switch alone does not say
CHECK="$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
    org.freedesktop.NetworkManager ConnectivityCheckEnabled 2>/dev/null | awk '{ print $2 }')"
case "${CHECK}" in
    true) CONNECTIVITY=on ;;
    false) CONNECTIVITY=off ;;
    *) if switch_on connectivity-check; then CONNECTIVITY=on; else CONNECTIVITY=off; fi ;;
esac
row connectivity-check "${CONNECTIVITY}" "$(gettext "Network connectivity check")" \
    "$(gettext "At each connection and every five minutes, NetworkManager fetches fedoraproject.org/static/hotspot.txt over plain HTTP, which every network on the way sees, to learn whether the network reaches the internet or wants a login.")" \
    "ame security connectivity-check" \
    "$(gettext "Without it, the login page of a hotel or train network is not offered by itself, and GNOME does not warn when a network has no internet.")"

# --- Where a connection breaks (Amethystora UI's tools module, on, and only ever while a network menu is open) -------

REACH="$(gsettings get org.gnome.shell.extensions.amethystora-ui.tools network-reach 2>/dev/null || true)"
if [[ "${REACH}" == true || "${REACH}" == false ]]; then
    row network-reach "$([[ "${REACH}" == true ]] && echo on || echo off)" "$(gettext "Where a connection breaks")" \
        "$(gettext "Each time you open the Wi-Fi or wired menu, one ping goes to your router. While the network connectivity check above is on, and for the connection the internet goes through, one lookup of the name that check already asks goes to the name server this machine already uses; with that check off, no name is looked up. Nothing else is contacted, and nothing runs while the menu is closed.")" \
        "ame desktop network-check" \
        "$(gettext "Without it, the menus do not draw where the connection breaks.")"
fi

# --- Location ---------------------------------------------------------------------------------------------

LOCATION="$(gsettings get org.gnome.system.location enabled 2>/dev/null || true)"
if [[ "${LOCATION}" == true || "${LOCATION}" == false ]]; then
    row location "$([[ "${LOCATION}" == true ]] && echo on || echo off)" "$(gettext "Location services")" \
        "$(gettext "When an app such as Weather, Maps or the automatic time zone asks where you are, the Wi-Fi networks in reach and their signal go to BeaconDB (api.beacondb.net), and the address alone when none is in reach.")" \
        "ame security location" \
        "$(gettext "Without it, those apps guess or ask you.")"
fi

# --- The weather beside the clock (Amethystora UI's today module, off until chosen) --------------------------

WEATHER="$(gsettings get org.gnome.shell.extensions.amethystora-ui.today weather 2>/dev/null || true)"
if [[ "${WEATHER}" == true || "${WEATHER}" == false ]]; then
    # GNOME's client asks three services (libgweather's METAR, MET_NO and OWM providers). Fedora's libgweather has no
    # OpenWeatherMap key, so that service refuses the request, but the place has gone to it. While the switch is off
    # the client is held still, except as the session starts and while the screen is locked, when no extension runs.
    row weather "$([[ "${WEATHER}" == true ]] && echo on || echo off)" "$(gettext "Weather")" \
        "$(gettext "The place you chose in Weather goes to api.met.no (MET Norway) and api.openweathermap.org, and the code of the nearest airport to aviationweather.gov (NOAA), each time the weather is shown.")" \
        "ame desktop weather" \
        "$(gettext "Whether this is on or off, GNOME Shell asks them once as you log in, and when Weather's place changes while the screen is locked, if Weather has a place.")"
fi

# --- The features of security.conf that fetch or send, once they are on --------------------------------------

CONFIG=/usr/libexec/amethystora-security-config
SETTINGS="$("${CONFIG}" --list --json 2>/dev/null || echo '{"settings":[]}')"
while IFS=$'\t' read -r setting key title sends explain; do
    [[ -n "${key}" ]] || continue
    if [[ "${sends}" == downloads ]]; then
        row "${setting}" on "${title}" "$(gettext "Fetches its signatures, rules or lists from the internet. Nothing about this machine is sent.")" \
            "ame security settings ${setting}"
    else
        row "${setting}" on "${title}" "$(gettext "Sends something away to a service you chose, which its explanation says.")" \
            "ame security settings ${setting}" "${explain}"
    fi
done < <(jq -r '.settings[] | select(.sends != "none" and .value != "off") | [.setting, .key, .title, .sends, (.explain // "")] | @tsv' <<<"${SETTINGS}")

# --- Updates ------------------------------------------------------------------------------------------------

if systemctl is-enabled --quiet uupd.timer 2>/dev/null || systemctl is-enabled --quiet rpm-ostreed-automatic.timer 2>/dev/null; then
    UPDATES=on
else
    UPDATES=off
fi
row auto-updates "${UPDATES}" "$(gettext "Automatic updates")" \
    "$(gettext "Every day, this machine asks ghcr.io for its image and its signature, and Flathub, Homebrew and the containers' registries for what is installed from them.")" \
    "ame system auto-updates" \
    "$(gettext "Without them, nothing is updated until you start it in Updates.")"

# The daily look for updates (amethystora-update-check), which installs nothing. A sealed image does not look.
if ! sealed; then
    if systemctl is-enabled --quiet amethystora-update-check.timer 2>/dev/null; then UPDATE_CHECK=on; else UPDATE_CHECK=off; fi
    row update-check "${UPDATE_CHECK}" "$(gettext "Looking for updates")" \
        "$(gettext "Once a day and after each start, this machine asks ghcr.io whether its image has a newer version, and, when packages were added to the system with rpm-ostree install, Fedora's mirrors for their package lists. Nothing is installed.")" \
        "ame update check" \
        "$(gettext "Without it, System Updates says what is waiting only once you press Check now, and nobody is told while automatic updates are off.")"
fi

if command -v flatpak >/dev/null; then
    # shellcheck source=/dev/null
    OS_INFO="$(. /etc/os-release && echo "${ID};${VERSION_ID};$(uname -m)")"
    FLATPAK_DETAIL="$(eval_gettext "Flathub is told which app is installed or updated and its version, and the system as \${OS_INFO}. Taking the system out is a file: /etc/flatpak/no-report-os-info.")"
    row flatpak on "$(gettext "Flatpak installs and updates")" \
        "$(gettext "When an app is installed or updated, which is on the first start with a network and then with updates, Flathub counts it.")" \
        "" "${FLATPAK_DETAIL}"
fi

if command -v fwupdmgr >/dev/null; then
    if switch_on firmware-metadata; then FIRMWARE=on; else FIRMWARE=off; fi
    row firmware-metadata "${FIRMWARE}" "$(gettext "Firmware catalogue")" \
        "$(gettext "Once a day at most, the list of firmware updates is fetched from the Linux Vendor Firmware Service. Nothing about this machine is sent.")" \
        "ame security firmware-metadata" \
        "$(gettext "Without it, Updates offers no firmware.")"
    if switch_on network-daemons; then SHARING=off; else SHARING=on; fi
    row firmware-sharing "${SHARING}" "$(gettext "Firmware sharing")" \
        "$(gettext "Machines on the same network are offered the firmware updates this machine downloaded, which are the same for every machine.")" \
        "ame security network-daemons" \
        "$(gettext "Turning it off also stops Avahi and ModemManager. Without it, each machine downloads its own firmware updates.")"
fi

# --- The clock ----------------------------------------------------------------------------------------------

if switch_on time; then
    CLOCK="$(gettext "The clock is set from time servers that prove who they are (NTS), and from no server a network suggests.")"
else
    CLOCK="$(gettext "The clock is set from 2.fedora.pool.ntp.org and from the time servers each network names, in plain NTP.")"
fi
row clock on "$(gettext "The clock")" "${CLOCK}" "ame security time" \
    "$(gettext "Without a time server, the clock drifts.")"

# --- What is off already, and what runs only once it was set up ------------------------------------------------

if grep -qx 'HOMEBREW_NO_ANALYTICS=1' /etc/homebrew/brew.env 2>/dev/null; then BREW=off; else BREW=on; fi
row homebrew-analytics "${BREW}" "$(gettext "Homebrew's analytics")" \
    "$(gettext "Homebrew would send the commands you run and the packages you install to analytics.brew.sh. They are off for every account.")" ""

# Only where Tailscale was turned on or the machine had joined a tailnet
if /usr/libexec/amethystora-tailscale wanted 2>/dev/null; then
    row tailscale on "$(gettext "Tailscale")" \
        "$(gettext "Tailscale's coordination server and relays, and the machines of your tailnet, are in touch with this machine. Its log upload is off.")" \
        "ame system tailscale"
fi

# Only for an account with containers
if [[ -d "${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/amethystora/pkg/containers" ]]; then
    if systemctl --user is-enabled --quiet amethystora-pkg-upgrade.timer 2>/dev/null; then CONTAINERS=on; else CONTAINERS=off; fi
    row containers "${CONTAINERS}" "$(gettext "Containers' upgrades")" \
        "$(gettext "Every day, each container asks its distribution's mirrors for its package list.")" ""
fi

# Only once live captions or dictation were set up: each language's speech model came from the internet once, when it
# was chosen, and nothing goes out since (English in captions/model, any other in captions/model-LANG)
CAPTIONS_DIR="${XDG_DATA_HOME:-${HOME:-/nonexistent}/.local/share}/amethystora/captions"
SPEECH=()
[[ -f "${CAPTIONS_DIR}/model/conf/model.conf" ]] && SPEECH+=(en)
for model in "${CAPTIONS_DIR}"/model-*; do
    [[ -f "${model}/conf/model.conf" || -f "${model}/mfcc.conf" ]] && SPEECH+=("${model##*/model-}")
done
if [[ ${#SPEECH[@]} -gt 0 ]]; then
    LANGUAGES="${SPEECH[*]}"
    row captions off "$(gettext "Live captions")" \
        "$(eval_gettext "The speech models of these languages were each downloaded once from alphacephei.com, when they were chosen: \${LANGUAGES}. Captions and dictation are made on this computer and nothing is sent.")" \
        "ame desktop captions"
fi

# Amethystora Vault. A logo for each authenticator account is asked of that account's own website, once the person chose it
# (`ame vault logos on`, the marker below): the site learns that someone at this address has an account there. A hidden vault is
# never looked up, so it is never in this row.
VAULT_LOGOS="${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/amethystora/vault-logos"
if [[ -e "${VAULT_LOGOS}" ]]; then
    row vault-logos on "$(gettext "Amethystora Vault's logos")" \
        "$(gettext "For each authenticator account in the vault you can see, the vault asks that account's own website for its icon (/favicon.ico or /apple-touch-icon.png), and only the host name goes out. The website learns that someone at this address has an account there.")" \
        "ame vault logos off" \
        "$(gettext "Without it, each account shows a letter on a colour, and nothing is asked of any website.")"
fi

# Amethystora Vault's sync, once a server was connected to the vault. The service says so while the vault is open; closed, the
# marker `ame vault sync` keeps in the account's own folder (an address is nothing secret) is all there is to go by.
VAULT_SYNC="${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/amethystora/vault-sync"
SYNC_ADDRESS=""
if [[ -x /usr/libexec/amethystora-vault-cli ]]; then
    SYNC_ADDRESS="$(timeout 5 /usr/libexec/amethystora-vault-cli sync status 2>/dev/null | awk -F'	' '$1=="connected"{c=$2} $1=="address"{a=$2} END{if(c=="yes")print a}' | tr -d '[:cntrl:]' | cut -c1-200)"
fi
if [[ -z "${SYNC_ADDRESS}" && -s "${VAULT_SYNC}" ]]; then
    SYNC_ADDRESS="$(head -n1 -- "${VAULT_SYNC}" | tr -d '[:cntrl:]' | cut -c1-200)"
fi
if [[ -n "${SYNC_ADDRESS}" ]]; then
    row vault-sync on "$(gettext "Amethystora Vault's sync")" \
        "$(eval_gettext "While the vault is open, what it holds that syncs (passwords, authenticator codes and backup codes, and keys, certificates and protected files where you chose it, plain or sealed, with files for what is larger than a note) is sent to \${SYNC_ADDRESS}, encrypted with the account's key, and the account's changes are fetched, on opening, after a change and every 15 minutes. The server sees how many items there are, of which kind, how long each is and when it changed.")" \
        "ame vault sync off" \
        "$(gettext "Without it, the server's copy stops being updated and nothing else changes: the vault is the source.")"
fi

# Warp, once Send to anyone was turned on or Warp was fetched (R7-66): nothing is sent by itself. When a file is sent in its window, a
# public server of the Magic Wormhole project learns that two computers made contact, and a public relay of the same project sees the
# addresses and the size when the two cannot reach each other; the file is encrypted end to end and neither can read it.
if [[ -e "${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/amethystora/send-anyone" ]] || { command -v flatpak >/dev/null && flatpak info app.drey.Warp >/dev/null 2>&1; }; then
    row warp off "$(gettext "Warp (Send to anyone)")" \
        "$(gettext "Only when you send a file in Warp's window: the three words are agreed through a public server of the Magic Wormhole project, which sees that two computers made contact and their addresses, and the file goes straight to the other computer or, when they cannot reach each other, through a public relay of the same project, which sees the addresses and how much passes. The file is encrypted end to end: neither can read it. Nothing is kept, and Warp's preferences let you choose your own servers.")" \
        "ame desktop send-anyone off" \
        "$(gettext "Without Send to anyone, Warp is not offered in Files, and nothing is ever fetched or run.")"
fi

# Only once translation for the screenshot bar was set up (R7-47): the translator was built here from its source (Fedora's
# container and packages, and its source from GitHub), and each language came once, when it was chosen. What is translated
# goes nowhere
TRANSLATE_DIR="${XDG_DATA_HOME:-${HOME:-/nonexistent}/.local/share}/amethystora/translate"
if [[ -d "${TRANSLATE_DIR}" ]]; then
    row translate off "$(gettext "Translation in the screenshot bar")" \
        "$(gettext "The translator was built on this computer once, from a Fedora container (registry.fedoraproject.org) and its packages (Fedora's mirrors) and its source on github.com. Its models were each downloaded once from Mozilla's servers (firefox-settings-attachments.cdn.mozilla.net), and the data to read another script from GitHub (raw.githubusercontent.com), when a language was chosen. What you translate goes nowhere.")" \
        "ame desktop translate"
fi

# Only once camera effects were set up (R7-68): the one model came from the internet once, and the video goes nowhere
CAMERA_DIR="${XDG_DATA_HOME:-${HOME:-/nonexistent}/.local/share}/amethystora/camera"
if [[ -d "${CAMERA_DIR}" ]]; then
    row camera off "$(gettext "Camera effects")" \
        "$(gettext "The model that finds you in the picture was downloaded once from media.githubusercontent.com. Your video is made on this computer and never written or sent.")" \
        "ame desktop camera"
fi

# Only once the photo index was set up (R7-63): its model came from the internet once, and no photo goes anywhere
PHOTOS_DIR="${XDG_DATA_HOME:-${HOME:-/nonexistent}/.local/share}/amethystora/photos"
if [[ -d "${PHOTOS_DIR}" ]]; then
    row photos off "$(gettext "Photos by what is in them")" \
        "$(gettext "The model that understands pictures and words was downloaded once from huggingface.co and its content network (cdn.hf.co). Your photos are read on this computer, and what is worked out is sealed in the Vault. Nothing is sent.")" \
        "ame desktop search photos"
fi

# Each plugin of the account's that was given a host (plans/PLAN-plugins.md): only while it runs, only to those hosts, through the
# plugins' proxy, which counts what goes out and stops it at the hour's limit. Its name and hosts are its own words, cleaned; the
# count is the host's, kept in the account's sent.json as each run ends.
SENT="${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/amethystora/plugins/sent.json"
if [[ -x /usr/libexec/amethystora-plugin-host ]]; then
    while IFS=$'\x1f' read -r plugin name hosts blocked counted; do
        [[ "${plugin}" =~ ^[a-z0-9][a-z0-9.-]{0,127}$ ]] || continue
        name="$(/usr/libexec/amethystora-security-text --max 80 "${name}")"
        hosts="$(/usr/libexec/amethystora-security-text --max 400 "${hosts}")"
        state=on
        [[ "${blocked}" == true ]] && state=off
        details=()
        [[ -n "${counted}" ]] && details+=("$(eval_gettext "Sent this hour: \${counted}")")
        row "plugin-${plugin}" "${state}" "$(eval_gettext "Plugin \${name}")" \
            "$(eval_gettext "Each time it runs, it may send to \${hosts}, through the plugins' proxy, which counts what goes out and stops it at the hour's limit (1 MiB unless you allowed more).")" \
            "ame plugin block ${plugin}" "${details[@]}"
    done < <(timeout 20 /usr/libexec/amethystora-plugin-host list --json 2>/dev/null | jq -r --slurpfile sent <(cat "${SENT}" 2>/dev/null || echo '{}') \
        '.[]? | select(.draft != true) | [.granted[]? | select(startswith("network=")) | sub("^network="; "")] as $hosts
        | select($hosts | length > 0) | ($sent[0][.id].hour // {}) as $hour
        | [.id, .name, ($hosts | join(", ")), (.blocked | tostring),
           ([$hour | to_entries[] | select(.value > 0) | "\(.key) \(.value) B"] | join(", "))]
        | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\u001f")' 2>/dev/null)
fi

if command -v firefox >/dev/null; then
    row firefox on "$(gettext "Firefox")" \
        "$(gettext "Firefox has its own settings for what it sends, under Privacy & Security in its settings.")" \
        "ame security browser"
fi

if [[ "${JSON}" == true ]]; then
    printf '%s\n' "${RECORDS[@]}" | jq -s .
else
    echo
    printf '  %s\n' "$(gettext "What this machine sends by itself")"
    for record in "${RECORDS[@]}"; do
        jq -r --arg on "$(gettext "sends")" --arg off "$(gettext "not sent")" \
            '"   \(.title): \(if .state == "on" then $on else $off end)\n      \(.text)\(.details | map("\n      " + .) | join(""))\(if .command then "\n      " + .command else "" end)"' <<<"${record}"
    done
    echo
fi
