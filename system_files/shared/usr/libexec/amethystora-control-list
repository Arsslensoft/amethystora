declare -A PATTERN_NAMES=(
    [facets]="${ gettext "Facets"; }" [waves]="${ gettext "Waves"; }" [contour]="${ gettext "Contour"; }"
    [mesh]="${ gettext "Mesh"; }" [grain]="${ gettext "Grain"; }" [dots]="${ gettext "Dots"; }" [bands]="${ gettext "Bands"; }"
