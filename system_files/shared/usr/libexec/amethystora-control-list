# Earlier versions and the card for a file nothing opens (the tools module, plans/ui-ideas/r7/spec-files.md)
TOOLS_ALL="${ said ui-tools-all; }"
tools_switch() {
    local key="$1" page="$2" id="$3" title="$4" text="$5" manual="$6"
    shift 6
    [[ "${ ended ui-tools-all; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
    switch_choices false "$@"
    USAGE="$* on|off"
    item "${page}" "${id}" switch "${title}" "${text}" "${ onoff_of "${TOOLS_ALL}" "${key}"; }" "${manual}"
}
tools_switch earlier-versions desktop earlier-versions "${ gettext "Earlier versions in Files"; }" \
    "${ gettext "Files' Scripts menu has Earlier versions: each version the snapshots and the backup keep of a file, to look at or keep beside it."; }" \
    desktop#earlier-versions ame desktop earlier-versions
tools_switch open-anything desktop open-anything "${ gettext "A file nothing opens says what it is"; }" \
    "${ gettext "Opening a kind of file nothing here opens says what it is and offers the app on Flathub that does, from the list already on this computer. Off, GNOME says there is no app."; }" \
    desktop#a-file-nothing-opens ame desktop open-anything
GROUP=""

