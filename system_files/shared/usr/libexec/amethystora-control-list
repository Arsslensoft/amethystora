# The audio module (org.gnome.shell.extensions.amethystora-ui.audio): the players paused when the headphones come off,
# Clear voice and the sound presets; the last two through amethystora-sound, which starts their PipeWire units
AUDIO="${ said audio; }"
audio_onoff() { [[ "${ value_of "${AUDIO}" "$1" "(.*)\$"; }" == true ]] && echo on || echo off; }
audio_reason() { [[ "${ ended audio; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"; }
audio_reason
switch_choices false ame desktop pause-on-unplug
USAGE="ame desktop pause-on-unplug on|off"
item appearance pause-on-unplug switch "${ gettext "Pause when the headphones come off"; }" \
    "${ gettext "Every player pauses when the headphones or a headset in use go away, so nothing plays out loud."; }" \
    "${ audio_onoff pause-on-unplug; }" desktop#pause-when-the-headphones-come-off
audio_reason
switch_choices false ame desktop clear-voice
USAGE="ame desktop clear-voice on|off"
item appearance clear-voice switch "${ gettext "Clear voice"; }" \
    "${ gettext "The microphone without background noise and echo, in every app, through PipeWire's own processing. Only while an app records."; }" \
    "${ audio_onoff clear-voice; }" desktop#clear-voice
audio_reason
switch_choices false ame desktop sound-presets
USAGE="ame desktop sound-presets on|off"
item appearance sound-presets switch "${ gettext "Sound presets"; }" \
    "${ gettext "The output menu offers Flat, Laptop, Speech and Bass for each output. A preset changes every app's sound."; }" \
    "${ audio_onoff sound-presets; }" desktop#sound-presets
# The preset of the output in use, as the key has it for that output's node name
SINK="${ said sink; }"
SINK="${SINK%%$'\n'*}"
PRESET=flat
if [[ "${SINK}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.:+-]*$ ]]; then
    presets="${ value_of "${AUDIO}" presets "(.*)\$"; }"
    # What follows this output's quoted name, when the key names it (matched as it is: a node name has dots)
    rest="${presets#*"'${SINK}': '"}"
    if [[ "${rest}" != "${presets}" ]]; then
        found="${rest%%"'"*}"
        [[ "${found}" =~ ^(laptop|speech|bass)$ ]] && PRESET="${found}"
    fi
else
    REASON="${ gettext "No sound output is in use."; }"
fi
audio_reason
[[ "${ audio_onoff sound-presets; }" == on ]] || REASON="${ gettext "Sound presets are off."; }"
choice flat "${ gettext "Flat"; }" "${ gettext "As it comes"; }" false ame desktop sound-preset flat
choice laptop "${ gettext "Laptop"; }" "${ gettext "Fills out thin speakers"; }" false ame desktop sound-preset laptop
choice speech "${ gettext "Speech"; }" "${ gettext "Voices and podcasts clearer"; }" false ame desktop sound-preset speech
choice bass "${ gettext "Bass"; }" "${ gettext "More bass, for music"; }" false ame desktop sound-preset bass
USAGE="ame desktop sound-preset PRESET"
item appearance sound-preset choice "${ gettext "Preset of the output in use"; }" \
    "${ gettext "Kept for this output only."; }" "${PRESET}" desktop#sound-presets
GROUP=""

