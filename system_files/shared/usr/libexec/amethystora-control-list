GROUP="${ gettext "Camera"; }"
choice on "${ON}" "" true ame desktop camera on
choice off "${OFF}" "" false ame desktop camera off
USAGE="ame desktop camera on|off"
if [[ -L "${HOME}/.config/systemd/user/graphical-session.target.wants/amethystora-camera.service" ]]; then CAMERA=on; else CAMERA=off; fi
