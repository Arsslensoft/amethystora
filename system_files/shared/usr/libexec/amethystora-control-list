# Desks (desks module): a set of screens brings back the sound output, the dock's place, Focus and the power mode
DESKS="${ said desks; }"
desks_onoff() { [[ "${ value_of "${DESKS}" "$1" "(.*)\$"; }" == true ]] && echo on || echo off; }
desks_reason() { [[ "${ ended desks; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"; }
GROUP="${ gettext "Desks"; }"
desks_reason
switch_choices false ame desktop desks
USAGE="ame desktop desks on|off"
item desktop desks switch "${ gettext "Desks"; }" \
    "${ gettext "At a set of screens you know, the sound output, the dock, Focus and the power mode come back, with a toast to undo it. The first time, a card asks."; }" \
    "${ desks_onoff desks; }" desktop#desks
desks_reason
switch_choices false ame desktop desks windows
USAGE="ame desktop desks windows on|off"
item desktop desk-windows switch "${ gettext "Screens come back as you left them"; }" \
    "${ gettext "When a set of screens comes back, every window goes back to its screen, place and size. It needs no desk set up."; }" \
    "${ desks_onoff desk-windows; }" desktop#screens-come-back-as-you-left-them
if [[ "${ desks_onoff desks; }" == on ]]; then
    desks_reason
    switch_choices false ame desktop desks learn
    USAGE="ame desktop desks learn on|off"
    item desktop desks-learn switch "${ gettext "Learn from what I change here"; }" \
        "${ gettext "Picking another sound output or moving the dock at a desk asks whether the desk should remember it."; }" \
        "${ desks_onoff desks-learn; }" desktop#desks
    # Each desk set up, by its name and what it sets; never its screens' serial numbers
    # (its copy while the file itself cannot be read, as the shell and the recipe read it)
    DESKS_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/amethystora/desks.json"
    jq -e 'type == "object"' "${DESKS_FILE}" >/dev/null 2>&1 || DESKS_FILE+=.bak
    if [[ -s "${DESKS_FILE}" ]]; then
        # Apart by the unit separator, which is no white space: an empty field stays a field
        while IFS=$'\x1f' read -r desk_id desk_name desk_screens desk_first desk_sound desk_edge desk_where desk_focus \
            desk_power desk_saved; do
            [[ "${desk_id}" =~ ^[0-9a-f]{12}$ ]] || continue
            if [[ -z "${desk_name}" ]]; then
                case "${desk_screens}" in
                    0) desk_name="${ gettext "The laptop alone"; }" ;;
                    1) desk_name="${desk_first}" ;;
                    *) desk_name="${ eval_ngettext "\${desk_screens} screen" "\${desk_screens} screens" "${desk_screens}"; }" ;;
                esac
            fi
            desk_sets=()
            [[ -n "${desk_sound}" ]] && desk_sets+=("${desk_sound}")
            case "${desk_edge}:${desk_where}" in
                bottom:primary) desk_sets+=("${ gettext "the dock at the bottom of the main screen"; }") ;;
                bottom:*) desk_sets+=("${ gettext "the dock at the bottom"; }") ;;
                left:primary) desk_sets+=("${ gettext "the dock on the left of the main screen"; }") ;;
                left:*) desk_sets+=("${ gettext "the dock on the left"; }") ;;
                right:primary) desk_sets+=("${ gettext "the dock on the right of the main screen"; }") ;;
                right:*) desk_sets+=("${ gettext "the dock on the right"; }") ;;
            esac
            case "${desk_focus}" in
                work) desk_sets+=("${ gettext "Work"; }") ;;
                games) desk_sets+=("${ gettext "Games"; }") ;;
                sleep) desk_sets+=("${ gettext "Sleep"; }") ;;
            esac
            case "${desk_power}" in
                balanced) desk_sets+=("${ gettext "Balanced"; }") ;;
                performance) desk_sets+=("${ gettext "Performance"; }") ;;
                power-saver) desk_sets+=("${ gettext "Power saver"; }") ;;
            esac
            [[ -n "${desk_saved}" ]] && desk_sets+=("${ eval_gettext "asks: \${desk_saved}"; }")
            desks_reason
            DETAIL=""
            for value in "${desk_sets[@]}"; do
                DETAIL+="${DETAIL:+ · }${value}"
            done
            COMMAND=(ame desktop desks forget "${desk_id}")
            TERMINAL=false
            BUTTON="${ gettext "Forget"; }"
            USAGE="ame desktop desks forget ${desk_id}"
            item desktop "desk-${desk_id}" action "${desk_name}" \
                "${ gettext "Forgetting a desk leaves what it set as it is."; }" "" desktop#desks
            if ((${#FOCUS_SETS[@]} > 0)); then
                desks_reason
                choice none "${ gettext "None"; }" "" false ame desktop desks saved "${desk_id}" none
                for value in "${FOCUS_SETS[@]}"; do
                    choice "${value}" "${value}" "" false ame desktop desks saved "${desk_id}" "${value}"
                done
                USAGE="ame desktop desks saved ${desk_id} NAME|none"
                item desktop "desk-${desk_id}-saved" choice "${ gettext "A saved set"; }" \
                    "${ gettext "Offered, after asking, when the computer arrives at this desk."; }" "${desk_saved:-none}" desktop#desks
            fi
        done < <(jq -r '.desks[]? | [.id, (.name // ""), (.screens | length), (.screens[0].name // ""),
            (.set.sound.label // ""), (.set.dock.edge // ""), (.set.dock.screens // ""), (.set.focus // ""),
            (.set.power // ""), (.set.saved // "")] | map(tostring | gsub("[\\t\\n\\r\u001e\u001f]"; " ")) | join("\u001f")' \
            "${DESKS_FILE}" 2>/dev/null | head -n 24)
    fi
fi
# Privacy (org.gnome.shell.extensions.amethystora-ui.privacy): the share guard, the shield and network by app. Walk-away
# lock is a security switch, in Security.
PRIVACY="${ said ui-privacy; }"
privacy_key() {
    local value
    value="${ value_of "${PRIVACY}" "$1" "(.*)\$"; }"
    [[ "${value}" =~ ^\'(.*)\'$ ]] && value="${BASH_REMATCH[1]}"
    printf '%s\n' "${value}"
}
privacy_reason() { [[ "${ ended ui-privacy; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"; }
GROUP="${ gettext "Privacy"; }"
privacy_reason
choice blur "${ gettext "Blur"; }" "${ gettext "The window blurred, its words unreadable"; }" false ame desktop share-guard blur
choice card "${ gettext "Card"; }" "${ gettext "A solid card over the window"; }" false ame desktop share-guard card
choice off "${ gettext "Off"; }" "${ gettext "A shared screen shows every window"; }" false ame desktop share-guard off
USAGE="ame desktop share-guard blur|card|off"
item desktop share-guard choice "${ gettext "Share guard"; }" \
    "${ gettext "While the whole screen is shared, the windows of the apps chosen are covered, for everyone and on your screen too. A window shared on its own is uncovered as soon as that is known."; }" \
    "${ privacy_key share-guard; }" desktop#share-guard
privacy_reason
DETAIL="${ privacy_key share-guard-apps; }"
DETAIL="${DETAIL//[]\[\']/}"
DETAIL="${DETAIL#@as }"
COMMAND=(ame desktop share-guard apps)
BUTTON="${ gettext "Choose"; }"
USAGE="ame desktop share-guard apps [APP.desktop...]"
item desktop share-guard-apps action "${ gettext "Apps covered while sharing"; }" \
    "${ gettext "Notes, Security, Backups, Help and the password managers, as the image ships."; }" "" desktop#share-guard
privacy_reason
switch_choices false ame desktop share-guard private
USAGE="ame desktop share-guard private on|off"
if [[ "${ privacy_key share-guard-private; }" == true ]]; then value=on; else value=off; fi
item desktop share-guard-private switch "${ gettext "The Private folder's windows"; }" \
    "${ gettext "Files windows showing the Private folder are covered while sharing."; }" "${value}" desktop#share-guard
privacy_reason
choice tile "${ gettext "Tile"; }" "${ gettext "In quick settings"; }" false ame desktop shield tile
choice mark "${ gettext "Mark in the bar"; }" "${ gettext "A shield beside the system's icons"; }" false ame desktop shield mark
choice attention "${ gettext "Only when needed"; }" "${ gettext "The mark, only when something needs a look"; }" false \
    ame desktop shield attention
choice off "${ gettext "Off"; }" "" false ame desktop shield off
USAGE="ame desktop shield tile|mark|attention|off"
item desktop shield choice "${ gettext "The shield"; }" \
    "${ gettext "How the machine's protection stands, in one look. It changes nothing: every line opens Security."; }" \
    "${ privacy_key shield; }" desktop#the-shield
privacy_reason
switch_choices false ame desktop network-apps
USAGE="ame desktop network-apps on|off"
if [[ "${ privacy_key network-apps; }" == true ]]; then value=on; else value=off; fi
item desktop network-apps switch "${ gettext "Network by app"; }" \
    "${ gettext "The network meter's menu lists which apps are talking to the network, and to where, while it is open. Nothing is sent anywhere."; }" \
    "${value}" desktop#network-by-app
privacy_reason
switch_choices false ame desktop zone-notice
USAGE="ame desktop zone-notice on|off"
if [[ "${ privacy_key zone-notice; }" == true ]]; then value=on; else value=off; fi
item desktop zone-notice switch "${ gettext "A new network's zone"; }" \
    "${ gettext "The first time a network is joined, a notification says which firewall zone it is in, with Open Security. It changes nothing."; }" \
    "${value}" desktop#a-new-networks-zone
GROUP=""

