        done < <(said patterns)
    } | jq -Rc 'split("\t") | {value: .[0], title: .[1], text: null, terminal: false,
        command: ["ame", "desktop", "pattern", .[0]], thumbnail: (if .[2] == "" then null else .[2] end)}'
