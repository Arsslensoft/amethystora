    "${ gettext "Each command opens in a terminal, where you read it and type your password for sudo"; }" true ame agent root terminal
USAGE="ame agent root session|minutes|each|terminal"
item agent agent-root choice "${ gettext "Root commands"; }" \
    "${ gettext "How the agent may run a command as root, once you let it make changes. It asks you first every time, in the agent."; }" \
