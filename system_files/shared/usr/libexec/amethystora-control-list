    "${ gettext "Select text in any window and press Super+Shift+A: the agent gets it, quoted as data, with your question, in a terminal."; }" \
    "${SELECTION}" ai-agent#asking-about-a-selection
[[ "${ ended agent-ui; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
[[ "${AGENTIC}" == true ]] || REASON="${ gettext "The agentic features are off."; }"
