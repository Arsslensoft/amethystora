# Light by day, dark by night: the theme module's keys
DAY_NIGHT=off
[[ "${ said look; }" =~ \ day-night\ true ]] && DAY_NIGHT=on
[[ "${ said look; }" =~ \ day-night-times\ \'hours\' ]] && [[ "${DAY_NIGHT}" == on ]] && DAY_NIGHT=hours
[[ "${DAY_NIGHT}" == on ]] && DAY_NIGHT=night-light
DAY_STARTS=7 NIGHT_STARTS=19
[[ "${ said look; }" =~ \ day-starts\ ([0-9]+)(\.[0-9]+)? ]] && DAY_STARTS="${BASH_REMATCH[1]}"
[[ "${ said look; }" =~ \ night-starts\ ([0-9]+)(\.[0-9]+)? ]] && NIGHT_STARTS="${BASH_REMATCH[1]}"
[[ "${ ended look; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
