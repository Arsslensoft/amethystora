# How old what is in the trash gets before GNOME's housekeeping empties it (org.gnome.desktop.privacy)
TRASH=""
PRIVACY="${ said privacy; }"
if [[ "${ ended privacy; }" != 0 ]]; then
    REASON="${ gettext "GNOME's privacy settings could not be read."; }"
elif [[ "${PRIVACY}" =~ remove-old-trash-files\ true ]]; then
    [[ "${PRIVACY}" =~ old-files-age\ (uint32\ )?([0-9]+) ]] && TRASH="${BASH_REMATCH[2]}"
else
    TRASH=off
fi
# A message for each, which gettext() finds without a process of its own: a plural form took four
choice 7 "${ gettext "After 7 days"; }" "" false ame desktop privacy trash 7
choice 14 "${ gettext "After 14 days"; }" "" false ame desktop privacy trash 14
choice 30 "${ gettext "After 30 days"; }" "" false ame desktop privacy trash 30
choice 60 "${ gettext "After 60 days"; }" "" false ame desktop privacy trash 60
choice off "${ gettext "Never"; }" "${ gettext "Only when you empty it"; }" false ame desktop privacy trash off
GROUP="${ gettext "Privacy"; }"
USAGE="ame desktop privacy trash DAYS|off"
item desktop trash choice "${ gettext "Empty the trash"; }" \
    "${ gettext "What was deleted longer ago than this leaves the trash by itself, checked every hour while you are logged in. The snapshots and the backup still have it."; }" \
    "${TRASH}" desktop#the-trash

# Plugins (ame plugin): everything that was added, what the agent made, and what the image ships. A plugin runs in a sandbox of its own and
# reaches only what was allowed; its words are its own, shown as they come
if [[ "${ ended agent; }" == 0 ]]; then AGENTIC=true; else AGENTIC=false; fi
if [[ "${ ended plugins; }" == 0 ]] && jq -e 'type == "array"' "${WORK}/plugins" >/dev/null 2>&1; then
    PLUGINS_LIST="${ said plugins; }"
else
    PLUGINS_LIST='[]'
    REASON="${ gettext "The plugins could not be listed."; }"
fi
# One row for each plugin or draft (the filter: all, or the ones the agent made): where it shows, whose it is, when, and what can be done
plugin_rows() {
    jq -c --argjson agentic "${AGENTIC}" --arg filter "$1" \
        --arg t_draft "${ gettext "Draft"; }" --arg t_changed "${ gettext "Changed"; }" --arg t_on "${ gettext "On"; }" --arg t_off "${ gettext "Off"; }" \
        --arg p_pill "${ gettext "Pill"; }" --arg p_bar "${ gettext "Top bar"; }" --arg p_desktop "${ gettext "Desktop"; }" --arg p_tile "${ gettext "Quick settings"; }" \
        --arg p_search "${ gettext "Search"; }" --arg p_dock "${ gettext "Dock"; }" \
        --arg w_agent "${ gettext "Made by the agent"; }" --arg w_image "${ gettext "Made for Amethystora"; }" --arg w_you "${ gettext "Added by you"; }" \
        --arg a_keep "${ gettext "Keep…"; }" --arg a_throw "${ gettext "Throw away"; }" --arg a_change "${ gettext "Change…"; }" --arg a_fix "${ gettext "Fix…"; }" \
        --arg a_pause "${ gettext "Pause"; }" --arg a_resume "${ gettext "Turn on"; }" --arg a_remove "${ gettext "Remove"; }" \
        --arg changed "${ gettext "Its files are not what you approved: it is stopped."; }" '
        def place: {"pill": $p_pill, "bar": $p_bar, "desktop": $p_desktop, "tile": $p_tile, "search": $p_search, "dock": $p_dock}[.] // empty;
        def day: if .since then (.since | strflocaltime("%Y-%m-%d")) else empty end;
        [.[] | select($filter == "all" or .author == "Agent")
            | . as $p | {
            id: .id,
            title: .name,
            text: ([(.contributes | map(place) | join(", ")), (if .draft and .author == "Agent" or .author == "Agent" then $w_agent elif .shipped then $w_image else $w_you end), day,
                    (if .verified == false then $changed else empty end)] | map(select(. != "")) | join(" · ")),
            state: (if .verified == false then "check" else "plain" end),
            tag: (if .draft then $t_draft elif .verified == false then $t_changed elif .enabled then $t_on else $t_off end),
            actions: (if .draft then
                    [{id: "keep", title: $a_keep, terminal: true, command: ["ame", "plugin", "keep", .id]}]
                    + (if $agentic then [{id: "change", title: $a_change, terminal: true, command: ["ame", "plugin", "change", .id]}] else [] end)
                    + [{id: "discard", title: $a_throw, terminal: false, command: ["ame", "plugin", "discard", .id]}]
                else
                    [(if .enabled then {id: "off", title: $a_pause, terminal: false, command: ["ame", "plugin", "off", .id]}
                      else {id: "on", title: $a_resume, terminal: false, command: ["ame", "plugin", "on", .id]} end)]
                    + (if $agentic then [{id: "fix", title: $a_fix, terminal: true, command: ["ame", "plugin", "fix", .id]}] else [] end)
                    + [{id: "remove", title: $a_remove, terminal: true, command: ["ame", "plugin", "remove", .id]}]
                end)
        }] as $rows | {rows: $rows, count: ($rows | length)}' <<<"${PLUGINS_LIST}" 2>/dev/null
}
GROUP="${ gettext "Plugins"; }"
if EXTRA="${ plugin_rows all; }" && [[ -n "${EXTRA}" ]]; then
    count="${EXTRA##*\"count\":}"
    count="${count%\}}"
    DETAIL="${ eval_ngettext "\${count} plugin" "\${count} plugins" "${count:-0}"; }"
else
    EXTRA='{"rows": []}'
fi
USAGE="ame plugin list|add|keep|remove|on|off"
item desktop plugins rows "${ gettext "Plugins"; }" \
    "${ gettext "Everything that shows in the pill, the top bar, quick settings, search, the dock and the desktop. Each runs in a sandbox and reaches only what you allowed."; }" \
    "" plugins
if EXTRA="${ plugin_rows agent; }" && [[ -n "${EXTRA}" ]]; then
    count="${EXTRA##*\"count\":}"
    count="${count%\}}"
    DETAIL="${ eval_ngettext "\${count} thing the agent made" "\${count} things the agent made" "${count:-0}"; }"
else
    EXTRA='{"rows": []}'
fi
USAGE="ame plugin make REQUEST"
item desktop plugins-agent rows "${ gettext "Made by the agent"; }" \
    "${ gettext "What the AI agent wrote for you, who made it and when. A draft runs with nothing allowed until you keep it. Nothing the agent makes stays without you."; }" \
    "" plugins#made-by-the-agent
if [[ "${AGENTIC}" == true ]]; then
    COMMAND=(ame plugin remove-agent-made)
    TERMINAL=true
    BUTTON="${ gettext "Remove all…"; }"
    USAGE="ame plugin remove-agent-made"
    item desktop plugins-remove-agent action "${ gettext "Remove everything the agent made"; }" \
        "${ gettext "Each plugin and draft it wrote, with what they kept. Asks first, in a terminal."; }" "" plugins#made-by-the-agent
fi
# The plugins the image ships, not added yet: one click each, after you read what it asks for
SHIPPED_ROWS="${ jq -c --argjson list "${PLUGINS_LIST}" --arg add "${ gettext "Add…"; }" --arg tag "${ gettext "Ready"; }" \
    --arg you "${ gettext "Made for Amethystora. None is on until you add it."; }" -n '
    [inputs] | map(select(. as $m | $list | map(.id) | index($m.id) | not))
    | {rows: map({id: .id, title: .name, text: $you, state: "plain", tag: $tag,
        actions: [{id: "add", title: $add, terminal: true, command: ["ame", "plugin", "add", .id]}]})}' \
    /usr/share/amethystora/plugins/*/manifest.json 2>/dev/null; }"
EXTRA="${SHIPPED_ROWS}"
[[ -n "${EXTRA}" ]] || EXTRA='{"rows": []}'
USAGE="ame plugin shipped"
item desktop plugins-shipped rows "${ gettext "Ready to add"; }" \
    "${ gettext "The plugins that come with Amethystora: its own code, which cannot change. You read what each asks for before it is added."; }" \
    "" plugins
# Whether plugins are drawn at all (org.gnome.shell.extensions.amethystora-ui.plugins)
if [[ "${ said pluginsshow; }" == false ]]; then PLUGINS_SHOW=off; else PLUGINS_SHOW=on; fi
[[ "${ ended pluginsshow; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
switch_choices false ame desktop plugins
USAGE="ame desktop plugins on|off"
item desktop plugins-show switch "${ gettext "Show plugins"; }" \
    "${ gettext "Draw what plugins and scripts show: in the live pill, the top bar, quick settings, search, the dock and on the desktop. Off, nothing of them is drawn."; }" \
    "${PLUGINS_SHOW}" plugins
GROUP="${ gettext "Plugins"; }"
