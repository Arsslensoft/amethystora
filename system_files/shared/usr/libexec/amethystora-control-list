#!/usr/bin/bash
# Amethystora's own settings outside security: what each one is now, and the `ame` command that changes
# it. Amethystora Control (amethystora-control) shows this list and runs those commands; `ame control`
# prints it. Nothing here changes anything, and it asks for no password.
#
#   amethystora-control-list          the list, for a terminal (`ame control`)
#   amethystora-control-list --json   the same list, for the window
#
# One list for both, so that the terminal and the window cannot disagree. Every change is an `ame`
# command, so that whatever the window does a terminal can do too; a command that asks something,
# explains a risk or needs a password says "terminal": true, and the window opens it in one. Security's
# settings are not here: they are Amethystora Security's, and `ame security status` lists them.
#
# Each entry is made by item():
#
#   {page, id, kind, group, title, text, state, detail, available, reason, manual, usage, choices, ...}
#
# where kind is switch (its choices are on and off), choice, range, action, link, themes, theme-maker, wallpapers,
# widgets, webapps, shortcuts, trust-image or setup, each of which the window knows how to draw. A choice is
# {value, title, text, terminal, command}, made by choice(). A command is an argument vector, which the
# window runs as it is: the page only ever sends back an entry's id and one of the values listed for it.

set -uo pipefail

# Its words, in the session's language where there is a translation of them (po/, compiled into
# /usr/share/locale by 14-security.sh), as the security report's are. A message names its values as
# shell variables, which eval_gettext fills in.
export TEXTDOMAIN=amethystora
# shellcheck source=/dev/null
source gettext.sh
# Without a process for every message, which made up most of the list's time: bash looks a $"..." string up
# in the same catalog itself. A message with a quote, a dollar, a backquote or a backslash in it, which that
# would not keep as it is, goes to the gettext program. eval_gettext, from gettext.sh, uses this one too.
# Its callers, and those of the other functions here that only print, take what it printed with bash 5.3's
# ${ ...; }, which runs it in this shell: $(...) forked one for each of the seven hundred, which doubled the time.
# Where no catalog of these words is there for any of the session's languages (English has none), every message is
# its own translation, and none needs a lookup, the gettext program or envsubst: eval_gettext alone forked four
# processes. Where one might apply, the words go through gettext as before.
UNTRANSLATED=true
if [[ -n "${TEXTDOMAINDIR:-}" ]]; then
    UNTRANSLATED=false
else
    IFS=: read -ra languages <<<"${LANGUAGE:-}:${LC_ALL:-}:${LC_MESSAGES:-}:${LANG:-}"
    for language in "${languages[@]}"; do
        language="${language%%[_.@]*}"
        [[ -n "${language}" ]] || continue
        for catalog in "/usr/share/locale/${language}"{,_*,.*,@*}"/LC_MESSAGES/${TEXTDOMAIN}.mo"; do
            [[ -e "${catalog}" ]] && UNTRANSLATED=false
        done
    done
fi
gettext() {
    if [[ "${UNTRANSLATED}" == true ]]; then
        printf '%s' "$1"
        return
    fi
    if [[ "$1" == *[\"\$\`\\]* ]]; then
        command gettext -- "$1"
        return
    fi
    local text
    eval "text=\$\"$1\""
    printf '%s' "${text}"
}
# A message's $NAME and ${NAME} filled in with the values of those variables, nothing for one that is not set, as
# envsubst fills them in for eval_gettext
fill_in() {
    # Names of their own, which no message names
    local fill_in_rest="$1" fill_in_out="" fill_in_name
    while [[ "${fill_in_rest}" == *'$'* ]]; do
        fill_in_out+="${fill_in_rest%%\$*}"
        fill_in_rest="${fill_in_rest#*\$}"
        fill_in_name="${fill_in_rest#\{}"
        fill_in_name="${fill_in_name%%[!A-Za-z0-9_]*}"
        if [[ -z "${fill_in_name}" || "${fill_in_name}" == [0-9]* ]]; then
            fill_in_out+='$'
            continue
        fi
        if [[ "${fill_in_rest}" == \{* ]]; then
            if [[ "${fill_in_rest}" != "{${fill_in_name}}"* ]]; then
                fill_in_out+='$'
                continue
            fi
            fill_in_rest="${fill_in_rest#"{${fill_in_name}}"}"
        else
            fill_in_rest="${fill_in_rest#"${fill_in_name}"}"
        fi
        fill_in_out+="${!fill_in_name-}"
    done
    printf '%s' "${fill_in_out}${fill_in_rest}"
}
eval "gettext_sh_${ declare -f eval_gettext; }"
eval "gettext_sh_${ declare -f eval_ngettext; }"
eval_gettext() {
    if [[ "${UNTRANSLATED}" == true ]]; then
        fill_in "$1"
    else
        gettext_sh_eval_gettext "$@"
    fi
}
# Untranslated, the singular for a count of one, as ngettext reads a count, and the plural for any other
eval_ngettext() {
    if [[ "${UNTRANSLATED}" != true ]]; then
        gettext_sh_eval_ngettext "$@"
    elif [[ "$3" =~ ^[[:space:]]*[+]?0*1$ ]]; then
        fill_in "$1"
    else
        fill_in "$2"
    fi
}
# theme_list, theme_current, the theme folders and CONFIG_DIR, as amethystora-theme has them
# shellcheck source=../lib/amethystora/theme/lib.sh
source /usr/lib/amethystora/theme/lib.sh

JSON=false
[[ "${1:-}" == "--json" ]] && JSON=true

IMAGE_INFO=/usr/share/amethystora/image-info.json
SEALED=false
[[ -e /usr/share/amethystora/sealed ]] && SEALED=true

ITEMS=()
CHOICES=()
# Set before item() and cleared by it: an action's command, whether it opens in a terminal and the words
# on its button, what else the window needs to draw the entry (a JSON object), why it is not available
# here, a sentence under its state, and the command to type for the same thing in a terminal. GROUP, the
# sub-heading on the page, stays until it is set again.
COMMAND=()
TERMINAL=true
BUTTON=""
EXTRA=""
REASON=""
DETAIL=""
GROUP=""
USAGE=""

# A choice of a setting: its value, its words, whether it opens a terminal, and the command that sets it
choice() {
    local IFS=$'\x1f'
    # One record for item()'s jq to make the object of, its fields apart by the unit separator: a jq of its
    # own for every choice made the list slow
    CHOICES+=("$*")
}

# An entry of the list, with the choices made for it since the last one.
item() {
    local page="$1" id="$2" kind="$3" title="$4" text="$5" state="$6" manual="$7" extra="${EXTRA:-}"
    [[ -n "${extra}" ]] || extra='{}'
    # A record of its fields apart by the record separator, then how many choices, the choices and the
    # command's words, which items_json makes the objects of, with one jq for the whole list
    local IFS=$'\x1e'
    local fields=("${page}" "${id}" "${kind}" "${GROUP}" "${title}" "${text}" "${state}" "${DETAIL}" "${REASON}"
        "${manual}" "${USAGE}" "${BUTTON}" "${TERMINAL}" "${extra}" "${#CHOICES[@]}" "${CHOICES[@]}" "${COMMAND[@]}")
    ITEMS+=("${fields[*]}")
    CHOICES=()
    COMMAND=()
    TERMINAL=true
    BUTTON=""
    EXTRA=""
    REASON=""
    DETAIL=""
    USAGE=""
}

# The two choices of a switch: the command given, with on or off after it
ON="${ gettext "On"; }"
OFF="${ gettext "Off"; }"
switch_choices() {
    local terminal="$1"
    shift
    choice on "${ON}" "" "${terminal}" "$@" on
    choice off "${OFF}" "" "${terminal}" "$@" off
}

# "tokyo-night" as "Tokyo Night": a theme's or a picture's name, which is a name and not translated
pretty() {
    local s="${1//[-_]/ }" out="" c prev=" " i
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        [[ "${prev}" == " " && "${c}" == [a-z] ]] && c="${c^}"
        out+="${c}"
        prev="${c}"
    done
    printf '%s\n' "${out}"
}

# A string as JSON in REPLY, for the small objects made here without a jq of their own (a list of choices still has one
# jq: in bash, a dozen of them took longer than its start): items_json's jq reads each object again, so only what it
# holds counts, not how it is written. Taken with ${| ...; }, which needs neither a process nor a file.
BACKSLASH='\'
CONTROLS=()
ESCAPES=()
for ((code = 1; code < 32; code++)); do
    printf -v escape '%s%03o' "${BACKSLASH}" "${code}"
    printf -v character "${escape}"
    CONTROLS+=("${character}")
    printf -v escape '%su%04x' "${BACKSLASH}" "${code}"
    ESCAPES+=("${escape}")
done
json() {
    REPLY="$1"
    if [[ "${REPLY}" == *[\"\\[:cntrl:]]* ]]; then
        local i
        REPLY="${REPLY//"${BACKSLASH}"/"${BACKSLASH}${BACKSLASH}"}"
        REPLY="${REPLY//\"/"${BACKSLASH}\""}"
        for ((i = 0; i < 31; i++)); do
            REPLY="${REPLY//"${CONTROLS[i]}"/"${ESCAPES[i]}"}"
        done
    fi
    REPLY="\"${REPLY}\""
}
# The words of a command as a JSON list, in REPLY
words() {
    local word out=""
    for word in "$@"; do
        json "${word}"
        out+="${out:+, }${REPLY}"
    done
    REPLY="[${out}]"
}
# An object of KEY VALUE pairs, in that order, each VALUE already JSON, in REPLY
object() {
    local out=""
    while (($# >= 2)); do
        out+="${out:+, }\"$1\": $2"
        shift 2
    done
    REPLY="{${out}}"
}

# The slow reads, all at once: each writes what it said, and how it ended, to a file of its own
WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT
declare -A READERS=()
read_in_background() {
    local name="$1"
    shift
    { timeout 20 "$@" >"${WORK}/${name}" 2>/dev/null; echo "$?" >"${WORK}/${name}.code"; } &
    READERS["${name}"]=$!
}
# Waits for one of them, the first time the list needs what it said: the list goes on while the slow ones (the Python
# helpers, a tenth of a second each before they read anything) still run, where waiting for all of them first cost it a
# quarter of a second. Only this shell can wait, so what a subshell reads (a pipeline, a < <(...)) is waited for first.
need() {
    [[ -n "${READERS["$1"]:-}" ]] || return 0
    ((BASHPID == $$)) || return 0
    wait "${READERS["$1"]}" 2>/dev/null
    unset 'READERS["$1"]'
}
# What each said and how it ended, read by bash itself rather than by cat
said() {
    need "$1"
    local text=""
    IFS= read -r -d '' text 2>/dev/null <"${WORK}/$1"
    printf '%s' "${text}"
}
ended() {
    need "$1"
    local code=1
    [[ -e "${WORK}/$1.code" ]] && IFS= read -r -d '' code <"${WORK}/$1.code"
    printf '%s' "${code}"
}
# The value of key $2 in what gsettings list-recursively printed ($1), as the extended expression $3 after the
# schema's name and the key takes it (its first group), on a line of its own for every line that matches: what
# sed -n 's/^[^ ]* KEY .../\1/p' printed, without a process. The lines are split by the shell's word splitting (with
# no globbing), which is quick where taking them off one by one is not, and only a line with the key in it is matched.
value_of() {
    local - IFS=$'\n' line expression="^[^ ]* $2 $3"
    set -f
    for line in $1; do
        [[ "${line}" == *" $2 "* && "${line}" =~ ${expression} ]] && printf '%s\n' "${BASH_REMATCH[1]}"
    done
}
# A Flatpak app installed for the machine or the account, as flatpak keeps it: what flatpak info answers,
# without loading every installation, which took a third of a second with many apps
installed() {
    [[ -e "/var/lib/flatpak/app/$1/current/active" || -e "${XDG_DATA_HOME:-${HOME}/.local/share}/flatpak/app/$1/current/active" ]]
}
# The first line of a file that starts with a /, as grep -m1 '^/' prints it, without a process
first_path() {
    local line
    while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ "${line}" == /* ]]; then
            printf '%s\n' "${line}"
            return 0
        fi
    done <"$1"
    return 1
} 2>/dev/null
# GNOME's settings, all from one gsettings list-recursively: a gsettings of its own for each of the sixty-odd below took
# two thirds of a second of processor time, and on four cores slowed everything else the list runs. Each name gets
# what `gsettings get SCHEMA KEY` printed, or `gsettings list-recursively SCHEMA` without a KEY, and how it ended (1 for
# a schema or key that is not there), in a file of its own as read_in_background writes them. The whole list holds each
# schema's own keys only, so a schema with children of its own (org.gnome.mutter) keeps a gsettings of its own.
# The list starts before the readers do, on a pipe the split below reads once every name is known. Reading needs no
# session bus, which GSettings would ask to watch each of the two hundred schemas: half of the list's time.
NO_BUS=(env DBUS_SESSION_BUS_ADDRESS=disabled:)
# The whole list holds the schemas of the first folder GLib reads them from only, not those of the folders behind it:
# it is used only while one compiled folder is all there is (GSETTINGS_SCHEMA_DIR, then XDG_DATA_HOME's and every
# XDG_DATA_DIRS one, as GLib finds them). With another, each name is read by a gsettings of its own, as before.
ONE_SOURCE=false
gsettings_start() {
    local dir first="" compiled
    local -a dirs=()
    IFS=: read -ra dirs <<<"${GSETTINGS_SCHEMA_DIR:-}"
    for dir in "${dirs[@]}"; do
        [[ -n "${dir}" ]] || return 0
        compiled="${dir}/gschemas.compiled"
        [[ -e "${compiled}" ]] || continue
        [[ -z "${first}" ]] && first="${compiled}"
        [[ "${compiled}" -ef "${first}" ]] || return 0
    done
    IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-${HOME}/.local/share}:${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}"
    for dir in "${dirs[@]}"; do
        [[ "${dir}" == /* ]] || return 0
        compiled="${dir}/glib-2.0/schemas/gschemas.compiled"
        [[ -e "${compiled}" ]] || continue
        [[ -z "${first}" ]] && first="${compiled}"
        [[ "${compiled}" -ef "${first}" ]] || return 0
    done
    [[ -n "${first}" ]] || return 0
    ONE_SOURCE=true
    exec {GSETTINGS_LIST}< <(DBUS_SESSION_BUS_ADDRESS=disabled: timeout 20 gsettings list-recursively 2>/dev/null)
}
GSETTINGS_READS=()
gsettings_read() {
    GSETTINGS_READS+=("$*")
}
gsettings_in_background() {
    local entry
    local -a fields
    if [[ "${ONE_SOURCE}" != true ]]; then
        for entry in "${GSETTINGS_READS[@]}"; do
            read -ra fields <<<"${entry}"
            if ((${#fields[@]} > 2)); then
                read_in_background "${fields[0]}" gsettings get "${fields[1]}" "${fields[2]}"
            else
                read_in_background "${fields[0]}" gsettings list-recursively "${fields[1]}"
            fi
        done
        return 0
    fi
    {
        awk -v work="${WORK}" -v reads="${ printf '%s\n' "${GSETTINGS_READS[@]}"; }" '
            BEGIN {
                n = split(reads, lines, "\n")
                for (i = 1; i <= n; i++) {
                    if (split(lines[i], f, " ") < 2) continue
                    name[i] = f[1]; schema[i] = f[2]; key[i] = f[3]; text[i] = ""; found[i] = 0
                    of[f[2]] = of[f[2]] " " i
                }
            }
            $1 in of {
                m = split(of[$1], ids, " ")
                for (j = 1; j <= m; j++) {
                    i = ids[j]
                    if (key[i] == "") { text[i] = text[i] $0 "\n"; found[i] = 1 }
                    else if (key[i] == $2) { text[i] = substr($0, length($1) + length($2) + 3) "\n"; found[i] = 1 }
                }
            }
            END {
                for (i in name) {
                    file = work "/" name[i]
                    printf "%s", text[i] >file
                    close(file)
                    print (found[i] ? 0 : 1) >(file ".code")
                    close(file ".code")
                }
            }' <&"${GSETTINGS_LIST}"
    } &
    exec {GSETTINGS_LIST}<&-
    for entry in "${GSETTINGS_READS[@]}"; do
        READERS["${entry%% *}"]=$!
    done
}

gsettings_start
