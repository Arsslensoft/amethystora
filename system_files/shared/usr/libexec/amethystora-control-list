item agent agent-pill switch "${ gettext "The agent's changes in the live pill"; }" \
    "${ gettext "While the agent may make changes, the live pill lists each one as it is made, with its own Undo, and Stop."; }" \
    "${ onoff_of "${AGENT_UI}" pill; }" ai-agent#its-changes-in-the-live-pill

