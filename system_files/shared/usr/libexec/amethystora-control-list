if [[ "${ ended captions; }" == 0 && "${ captions_key enabled; }" == true ]]; then CAPTIONS=on; else CAPTIONS=off; fi
# The recognizer is GStreamer's vosk element: its file says it is there, with no Python and no GStreamer started
