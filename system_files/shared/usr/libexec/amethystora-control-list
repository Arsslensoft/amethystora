# The language captions and dictation hear (plans/ui-ideas/spec-later.md, R6-32): one not on this computer yet opens a
# terminal, which says what it downloads and asks; one that is here is chosen at once. The names are the languages' own
CAPTIONS_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/amethystora/captions"
for language in en:English fr:Français es:Español de:Deutsch it:Italiano tr:Türkçe pt:Português nl:Nederlands \
    ru:Русский pl:Polski; do
    code="${language%%:*}"
    model="${CAPTIONS_DIR}/model-${code}"
    [[ "${code}" == en ]] && model="${CAPTIONS_DIR}/model"
    if [[ -f "${model}/conf/model.conf" || -f "${model}/mfcc.conf" ]]; then
        choice "${code}" "${language#*:}" "" false ame desktop captions language "${code}"
    else
        choice "${code}" "${language#*:}" "${ gettext "Downloaded once when chosen, about 40 MB"; }" true ame desktop captions language "${code}"
    fi
done
