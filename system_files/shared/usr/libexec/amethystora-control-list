# The pools of disks, as `amethystora-raid status --json` has them, and the system's disks when it spans
# several: each with the actions that fit it, every command made here from the status, so that the page
# never names a disk or a pool. Each asks which disk, asks for ERASE or needs a password, so all of them
# open in a terminal. How a pool is doing is shown here and nowhere else: Security's report has none.
RAID="${ said raid; }"
if [[ "${ ended raid; }" == 0 ]] && jq -e '.version == 1' <<<"${RAID}" >/dev/null 2>&1; then
    # Sizes as disk makers give them: 1.0 TB is 10^12 bytes
    bytes() {
        awk -v b="${1:-0}" 'BEGIN { split("B kB MB GB TB PB", u, " "); i = 1
            while (b >= 1000 && i < 6) { b /= 1000; i++ }
            s = sprintf(i == 1 ? "%d" : "%.1f", b); sub(/\.0$/, "", s); print s, u[i] }'
    }
    pool_action() {
        local id="$1" title="$2"
        shift 2
        jq -nc --arg id "${id}" --arg title "${title}" '{$id, $title, terminal: true, command: $ARGS.positional}' --args "$@"
    }
    # What the rest reads of the status, in one jq: each as jq -r printed it, nothing where it could not
    mapfile -t -d '' RAID_SAID < <(jq -j 'def said(f): (try (f | if type == "string" then sub("\n+\\z"; "") else tojson end)
            catch ""), "\u0000";
        said(.spare | length), said(.mirror_onto.reason // (if .mirror_onto.possible == true then "possible" else "" end)),
        said(.system_single), said(.raid), said(.scrub_timer // ""), said(.scrubbing)' <<<"${RAID}" 2>/dev/null)
    SPARE="${RAID_SAID[0]:-}"
    ROWS=()
    while IFS=$'\x1f' read -r name system managed mountpoint layout count encrypted size used mounted missing survives \
        problems busy scrubbed; do
        case "${layout}" in
            raid1) words="${ gettext "Two copies"; }" ;;
            raid1c3) words="${ gettext "Three copies"; }" ;;
            raid1c4) words="${ gettext "Four copies"; }" ;;
            raid10) words="${ gettext "Striped two copies"; }" ;;
            raid5) words="${ gettext "Parity"; }" ;;
            raid6) words="${ gettext "Double parity"; }" ;;
            single) if [[ "${system}" == true ]]; then words="${ gettext "One copy"; }"; else words="${ gettext "Combined"; }"; fi ;;
            *) words="" ;;
        esac
        TEXT=()
        [[ -n "${words}" ]] && TEXT+=("$(eval_ngettext "\${words}, on \${count} disk." "\${words}, on \${count} disks." "${count}")")
        [[ "${encrypted}" == true ]] && TEXT+=("${ gettext "Encrypted."; }")
        if [[ -n "${size}" && -n "${used}" ]]; then
            used_words="$(bytes "${used}")" size_words="$(bytes "${size}")"
            TEXT+=("${ eval_gettext "\${used_words} used of \${size_words}."; }")
        fi
        # How it is: the worst of what the status found
        if [[ -n "${busy}" ]]; then
            if [[ "${busy}" == *-replace-* ]]; then
                TEXT+=("${ gettext "Replacing a disk now."; }")
            elif [[ "${busy}" == *-scrub-* ]]; then
                TEXT+=("${ gettext "Checking every copy now."; }")
            else
                TEXT+=("${ gettext "Putting its copies where they belong now."; }")
            fi
        elif [[ ",${problems}," == *,mirror-failed,* ]]; then
            TEXT+=("${ gettext "Mirroring it onto the new disk stopped before the restart from that disk worked. Every file is on both disks."; }")
        elif [[ ",${problems}," == *,restart,* ]]; then
            TEXT+=("${ gettext "Restart to finish: the machine starts once from the new disk, then the first disk joins it for good."; }")
        elif [[ "${mounted}" == false ]]; then
            TEXT+=("${ gettext "Not open, perhaps because one of its disks is missing. Its files are still on its disks."; }")
        elif [[ ",${problems}," == *,missing,* ]] && ((missing <= survives)); then
            TEXT+=("${ gettext "A disk is missing. Every file is still there, with one copy fewer until the disk is replaced."; }")
        elif [[ ",${problems}," == *,missing,* ]]; then
            TEXT+=("${ gettext "A disk is missing, and the files that were on it cannot be read until it is back."; }")
        elif [[ ",${problems}," == *,failing,* ]]; then
            TEXT+=("${ gettext "A disk says it is failing: replace it before it stops."; }")
        elif [[ ",${problems}," == *,scrub,* ]]; then
            TEXT+=("${ gettext "The last check found damage it could not repair."; }")
        elif [[ ",${problems}," == *,errors,* ]]; then
            TEXT+=("${ gettext "A disk has counted read or write errors."; }")
        elif [[ ",${problems}," == *,returned,* ]]; then
            TEXT+=("${ gettext "A disk that was missing is back, with old copies of what was written while it was away."; }")
        elif [[ ",${problems}," == *,degraded,* ]]; then
            TEXT+=("${ gettext "Part of it has one copy, written while a disk was missing."; }")
        elif [[ ",${problems}," == *,boot,* ]]; then
            TEXT+=("${ gettext "Its boot files have one copy, so it starts from one of its disks only."; }")
        elif [[ ",${problems}," == *,unprotected,* ]]; then
            TEXT+=("${ gettext "Either disk failing loses everything."; }")
        else
            TEXT+=("${ gettext "Fine."; }")
        fi
        if [[ -n "${layout}" && "${layout}" != single ]]; then
            if [[ -n "${scrubbed}" ]]; then
                when="$(date -d "@${scrubbed}" +%x)"
                TEXT+=("${ eval_gettext "Every copy last checked on \${when}."; }")
            else
                TEXT+=("${ gettext "Every copy not checked yet."; }")
            fi
        fi
        [[ "${layout}" == raid5 || "${layout}" == raid6 ]] && TEXT+=("${ gettext "After a power cut, check every copy."; }")
        ACTIONS=()
        # The system keeps copies once mirrored, and is then mended as a pool is
        if [[ "${system}" == true && -n "${layout}" && "${layout}" != single ]]; then
            if [[ ",${problems}," == *,mirror-failed,* ]]; then
                ACTIONS+=("$(pool_action mirror "${ gettext "Restart from the new disk…"; }" ame system raid mirror)")
            elif [[ ",${problems}," == *,restart,* ]]; then
                :
            elif [[ ",${problems}," =~ ,(missing|failing|errors), ]]; then
                ACTIONS+=("$(pool_action replace "${ gettext "Replace a disk…"; }" ame system raid replace system)")
            elif [[ ",${problems}," =~ ,(degraded|returned|boot), ]]; then
                ACTIONS+=("$(pool_action replace "${ gettext "Put the copies back…"; }" ame system raid replace system)")
            fi
        fi
        if [[ "${managed}" == true ]]; then
            if [[ ",${problems}," =~ ,(missing|failing|errors), ]]; then
                ACTIONS+=("$(pool_action replace "${ gettext "Replace a disk…"; }" ame system raid replace "${name}")")
            elif [[ ",${problems}," =~ ,(degraded|returned), ]]; then
                ACTIONS+=("$(pool_action replace "${ gettext "Put the copies back…"; }" ame system raid replace "${name}")")
            fi
            [[ "${mounted}" == false ]] &&
                ACTIONS+=("$(pool_action mount "${ gettext "Open it with a disk missing…"; }" ame system raid mount "${name}")")
            [[ "${mounted}" == true && "${SPARE}" -gt 0 ]] &&
                ACTIONS+=("$(pool_action add "${ gettext "Add a disk…"; }" ame system raid add "${name}")")
            ACTIONS+=("$(pool_action forget "${ gettext "Forget…"; }" ame system raid forget "${name}")")
        fi
        if [[ "${system}" == true ]]; then title="${ gettext "The system's disks"; }"; else title="${ eval_gettext "\${name}, at \${mountpoint}"; }"; fi
        STATE=ok
        [[ -n "${problems}" ]] && STATE=check
        ROWS+=("$(jq -nc --arg id "${name}" --arg title "${title}" --arg text "${TEXT[*]}" --arg state "${STATE}" \
            '{$id, $title, $text, $state, actions: [$ARGS.positional[] | fromjson]}' --args "${ACTIONS[@]}")")
    done < <(jq -r '.pools[] | [.name, .system, .managed, .mountpoint, (.layout // ""), (.devices | length), .encrypted,
        (.size // ""), (.used // ""), .mounted, (.missing // 0), (.survives // 0), (.problems | join(",")),
        ((.busy | join(",")) + (.operation // "")), (.scrub.time // "")] | map(tostring) | join("\u001f")' <<<"${RAID}")
    if [[ ${#ROWS[@]} -gt 0 ]]; then
        EXTRA="$(printf '%s\n' "${ROWS[@]}" | jq -sc '{disks: .}')"
        GROUP="${ gettext "Disks"; }"
        USAGE="ame system raid status"
        item system disks disks "${ gettext "Pools of disks"; }" \
            "${ gettext "Disks that keep copies of each other, so that one can fail without taking a file with it."; }" \
            "" hardware#pools-of-disks-raid
    fi

    [[ "${SPARE}" -ge 2 ]] || REASON="${ gettext "Needs two disks besides the system's."; }"
    COMMAND=(ame system raid create)
    BUTTON="${ gettext "Make a pool…"; }"
    GROUP="${ gettext "Disks"; }"
    USAGE="ame system raid create"
    item system raid-create action "${ gettext "Make a pool from spare disks"; }" \
        "${ gettext "Two or more disks that keep copies of each other, or join into one, in a folder under /var/mnt. It asks which disks, how to lay them out and whether to encrypt them, and erases them only once you type ERASE."; }" \
        "" hardware#pools-of-disks-raid

    # A system on one disk, laid out as the installer does it, copied onto a new disk at least as large (2b)
    ONTO="${RAID_SAID[1]:-}"
    if [[ "${ONTO}" == possible || "${ONTO}" == no-disk ]]; then
        [[ "${ONTO}" == no-disk ]] && REASON="${ gettext "Needs a spare disk at least as large as the system's."; }"
        COMMAND=(ame system raid mirror)
        BUTTON="${ gettext "Mirror…"; }"
        GROUP="${ gettext "Disks"; }"
        USAGE="ame system raid mirror DISK"
        item system raid-mirror-disk action "${ gettext "Mirror the system onto a new disk"; }" \
            "${ gettext "Copies the system onto a spare disk at least as large as its own, its EFI partition and /boot included, so that the machine starts from either disk and goes on with one dead. It erases that disk once you type ERASE, then restarts once from it."; }" \
            "" hardware#the-systems-own-disks
    fi

    if [[ "${RAID_SAID[2]:-}" == true ]]; then
        COMMAND=(ame system raid mirror)
        BUTTON="${ gettext "Protect…"; }"
        GROUP="${ gettext "Disks"; }"
        USAGE="ame system raid mirror"
        item system raid-mirror action "${ gettext "Protect the system's disks"; }" \
            "${ gettext "The system is spread over several disks with one copy of each file, so either one failing loses everything. This keeps a copy on each, erasing nothing. The machine starts from its first disk, or with another disk dead from the boot menu's Start with a disk missing."; }" \
            "" hardware#the-systems-own-disks
    fi

    if [[ "${RAID_SAID[3]:-}" == true ]]; then
        if [[ "${RAID_SAID[4]:-}" == enabled ]]; then SCRUB=on; else SCRUB=off; fi
        switch_choices true ame system raid scrub
        GROUP="${ gettext "Disks"; }"
        USAGE="ame system raid scrub on|off"
        item system raid-scrub switch "${ gettext "Monthly check of every copy"; }" \
            "${ gettext "Reads everything on the pools once a month, on mains power, and repairs a damaged copy from a good one."; }" \
            "${SCRUB}" hardware#pools-of-disks-raid

        [[ "${RAID_SAID[5]:-}" == true ]] && REASON="${ gettext "A check is running now."; }"
        COMMAND=(ame system raid scrub now)
        BUTTON="${ gettext "Check now…"; }"
        GROUP="${ gettext "Disks"; }"
        USAGE="ame system raid scrub now"
        item system raid-scrub-now action "${ gettext "Check every copy now"; }" \
            "${ gettext "The same check, now, in the background. After a power cut, do it for a pool with parity."; }" \
            "" hardware#pools-of-disks-raid
    fi
fi

# The warning before the system's disk fails: its timer is the switch, which a link says without asking systemd
if [[ -L /etc/systemd/system/timers.target.wants/amethystora-disk-health.timer ]]; then DISK_WARNING=on; else DISK_WARNING=off; fi
switch_choices true ame system disk-warning
GROUP="${ gettext "Disks"; }"
USAGE="ame system disk-warning on|off"
item system disk-warning switch "${ gettext "A warning before the disk fails"; }" \
    "${ gettext "Reads the health of the system's disk each hour, leaving it asleep if it sleeps, and says once if it begins to fail."; }" \
    "${DISK_WARNING}" hardware#when-a-disk-may-be-failing
GROUP=""

# What the notice after a night's battery kept from waking the computer, with the way back here: that notice is said once,
# and a dismissed one is gone. The helper's names are plain text; a device with no name shows its ID
if [[ "${ ended wake-devices; }" == 0 ]]; then
    while IFS=$'\t' read -r wake_id wake_name; do
        [[ -n "${wake_id}" ]] || continue
        COMMAND=(ame system wake-device on "${wake_id}")
        BUTTON="${ gettext "Let it wake…"; }"
        GROUP="${ gettext "Sleep"; }"
        USAGE="ame system wake-device on ID"
        item system "wake-device-${wake_id//:/-}" action "${ eval_gettext "Let \${wake_name} wake the computer again"; }" \
            "${ eval_gettext "It was kept from waking the computer (\${wake_id}). This asks for an administrator's password and puts it back."; }" \
            "" desktop#power-you-can-see
    done <<<"${ said wake-devices; }"
    GROUP=""
fi

# Settings back as the image ships them, files and accounts kept: the step before starting over
COMMAND=(ame system reset-settings)
BUTTON="${ gettext "Reset settings…"; }"
GROUP="${ gettext "Start over"; }"
USAGE="ame system reset-settings"
item system reset-settings action "${ gettext "Reset settings"; }" \
    "${ gettext "Puts your account's desktop settings, the machine's settings in /etc, or both back as the image ships them. Your files, apps and accounts stay, and so do your language, networks and everything Security sets. Each is saved first, and the same button can undo it."; }" \
    "" troubleshooting#resetting-settings

# A new installation beside this one: nothing is erased, and the old system can still be started. Not
# on a sealed machine until it has been tried there.
[[ "${SEALED}" == true ]] && REASON="${ gettext "Not on a sealed machine yet: it has not been tried on one."; }"
COMMAND=(ame system powerwash)
BUTTON="${ gettext "Start over…"; }"
EXTRA='{"danger": true}'
GROUP="${ gettext "Start over"; }"
USAGE="ame system powerwash"
item system powerwash action "${ gettext "Start over"; }" \
    "${ gettext "Makes a new installation of this image beside this one, without your accounts, settings or files. Nothing is erased: the old system stays on the disk, and the boot menu can still start it. Experimental. It asks twice."; }" \
    "" troubleshooting#starting-over
GROUP=""

# --- Keyboard --------------------------------------------------------------------------------------

# Every shortcut, as /usr/libexec/amethystora-keybindings lists them: each with its schema and key, whose they are, what
# they are set to and what they clash with. The window sends back a schema and key the list named and a combination it
# recorded, which control-core checks before the command runs, and the helper again. Without what each ships with, which
# the window does not show: the entry is one argument of items_json's jq, which the kernel keeps under 128 KiB
GROUP="${ gettext "Shortcuts"; }"
# Read by jq from the reader's own file, which a here-string of eighty kilobytes would have jq read through another
KEYBINDINGS="${WORK}/keybindings"
if [[ "${ ended keybindings; }" != 0 ]] || ! jq -e '.bindings | type == "array"' "${KEYBINDINGS}" >/dev/null 2>&1; then
    KEYBINDINGS=/dev/stdin
    REASON="${ gettext "The shortcuts could not be read."; }"
fi
EXTRA="$(jq -c '{keybindings: [.bindings[] | del(.default)], tiling: (.tiling == true), commands: {
    set: {terminal: false, command: ["ame", "desktop", "shortcut", "set", "{schema}", "{key}", "{accel}"]},
    clear: {terminal: false, command: ["ame", "desktop", "shortcut", "clear", "{schema}", "{key}"]},
    reset: {terminal: false, command: ["ame", "desktop", "shortcut", "reset", "{schema}", "{key}"]}}}' \
    "${KEYBINDINGS}" <<<'{"tiling": false, "bindings": []}')"
USAGE="ame desktop shortcut set SCHEMA KEY ACCEL"
item keyboard keyboard-shortcuts keybindings "${ gettext "Every shortcut"; }" \
    "${ gettext "GNOME's, the desktop's, the tiling's and your own, in one list. Change one by pressing the new keys; a clash is marked with both names."; }" \
    "" desktop#every-shortcut

GROUP="${ gettext "Keyboard"; }"
XKB="${ value_of "${ said kb-input; }" xkb-options "(.*)\$"; }"
KB="${ said kb-keyboard; }"
kb_key() {
    local value
    value="${ value_of "${KB}" "$1" "(.*)\$"; }"
    value="${value%$'\n'}"
    printf '%s' "${value#uint32 }"
}
CAPS=normal
case "${XKB}" in
    *"'caps:escape'"*) CAPS=escape ;;
    *"'ctrl:nocaps'"*) CAPS=ctrl ;;
    *"'caps:backspace'"*) CAPS=backspace ;;
    *"'caps:none'"*) CAPS=none ;;
esac
choice normal "${ gettext "Caps Lock"; }" "" false ame desktop keyboard caps normal
choice escape "${ gettext "Escape"; }" "" false ame desktop keyboard caps escape
choice ctrl "${ gettext "Ctrl"; }" "" false ame desktop keyboard caps ctrl
choice backspace "${ gettext "Backspace"; }" "" false ame desktop keyboard caps backspace
choice none "${ gettext "Nothing"; }" "" false ame desktop keyboard caps none
USAGE="ame desktop keyboard caps normal|escape|ctrl|backspace|none"
item keyboard keyboard-caps choice "${ gettext "Caps Lock acts as"; }" \
    "${ gettext "Escape suits a text editor; Ctrl a hand that reaches for shortcuts."; }" "${CAPS}" desktop#keyboard-settings
COMPOSE=off
[[ "${XKB}" =~ \'compose:(ralt|rctrl|menu|rwin|caps)\' ]] && COMPOSE="${BASH_REMATCH[1]}"
choice off "${ gettext "None"; }" "" false ame desktop keyboard compose off
choice ralt "${ gettext "Right Alt"; }" "" false ame desktop keyboard compose ralt
choice rctrl "${ gettext "Right Ctrl"; }" "" false ame desktop keyboard compose rctrl
choice menu "${ gettext "Menu"; }" "" false ame desktop keyboard compose menu
choice rwin "${ gettext "Right Super"; }" "" false ame desktop keyboard compose rwin
choice caps "${ gettext "Caps Lock"; }" "" false ame desktop keyboard compose caps
USAGE="ame desktop keyboard compose off|ralt|rctrl|menu|rwin|caps"
item keyboard keyboard-compose choice "${ gettext "Compose key"; }" \
    "${ gettext "Compose, then ' and e, types é."; }" "${COMPOSE}" desktop#keyboard-settings
SUPER_ALONE="${ said kb-super; }"
SUPER_ALONE="${SUPER_ALONE//\'/}"
[[ "${ ended kb-super; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
choice overview "${ gettext "The overview"; }" "" false ame desktop keyboard super overview
choice search "${ gettext "The search box"; }" "" false ame desktop keyboard super search
choice nothing "${ gettext "Nothing"; }" "" false ame desktop keyboard super nothing
USAGE="ame desktop keyboard super overview|search|nothing"
item keyboard keyboard-super choice "${ gettext "Super on its own opens"; }" \
    "${ gettext "Pressing and letting go of Super, with no other key. Super's shortcuts work either way."; }" \
    "${SUPER_ALONE:-overview}" desktop#keyboard-settings
switch_choices false ame desktop keyboard middle-paste
USAGE="ame desktop keyboard middle-paste on|off"
item keyboard keyboard-middle-paste switch "${ gettext "Middle click pastes"; }" \
    "${ gettext "The middle button pastes the last text selected, anywhere. Off, nothing is pasted by a stray click."; }" \
    "${ [[ "${ said kb-paste; }" == true ]] && echo on || echo off; }" desktop#keyboard-settings
switch_choices false ame desktop keyboard numlock
USAGE="ame desktop keyboard numlock on|off"
item keyboard keyboard-numlock switch "${ gettext "Num Lock on at start"; }" \
    "${ gettext "Off, Num Lock starts as it was left."; }" \
    "${ [[ "${ kb_key remember-numlock-state; }" == false && "${ kb_key numlock-state; }" == true ]] && echo on || echo off; }" \
    desktop#keyboard-settings
EXTRA='{"min": 150, "max": 1000, "step": 50, "unit": "ms", "terminal": false,
    "command": ["ame", "desktop", "keyboard", "repeat-delay", "{value}"]}'
USAGE="ame desktop keyboard repeat-delay 150..1000"
item keyboard keyboard-repeat-delay range "${ gettext "Repeat after"; }" \
    "${ gettext "How long a key is held before it repeats, in milliseconds."; }" "${ kb_key delay; }" desktop#keyboard-settings
switch_choices false ame desktop keyboard per-window
USAGE="ame desktop keyboard per-window on|off"
item keyboard keyboard-per-window switch "${ gettext "Each window keeps its keyboard layout"; }" \
    "${ gettext "The layout chosen in a window comes back when you return to it: one language in a chat, another in mail."; }" \
    "${ [[ "${ value_of "${ said kb-input; }" per-window "(.*)\$"; }" == true ]] && echo on || echo off; }" desktop#a-layout-for-each-window

GROUP="${ gettext "Typing"; }"
[[ "${ ended kb-accents; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
switch_choices false ame desktop accents
USAGE="ame desktop accents on|off"
item keyboard keyboard-accents switch "${ gettext "Hold a key for accents"; }" \
    "${ gettext "Hold a letter in an app and its accented forms appear over the text cursor; a number types one. Not in terminals or games. It looks at what you type, keeps none of it, and is off until you turn it on."; }" \
    "${ [[ "${ said kb-accents; }" == true ]] && echo on || echo off; }" desktop#hold-a-key-for-accents
GROUP=""

# --- Your setup ------------------------------------------------------------------------------------

SETUP="${CONFIG_DIR}/setup.json"
SAVED=""
[[ -f "${SETUP}" ]] && SAVED="$(stat -c %Y "${SETUP}" 2>/dev/null)"
EXTRA="$(jq -nc --arg file "${SETUP}" --arg saved "${SAVED}" '{$file,
    saved: (if $saved == "" then null else ($saved | tonumber) end), commands: {
        save: {terminal: false, command: ["ame", "setup", "save"]},
        apply: {terminal: true, command: ["ame", "setup", "apply"]}}}')"
USAGE="ame setup save|diff|apply"
item setup setup-file setup "${ gettext "Your setup file"; }" \
    "${ gettext "Your image, apps, containers, extensions, theme and the settings you changed, in one file to keep, compare and apply here or on another machine."; }" \
    "${ [[ -n "${SAVED}" ]] && echo saved; }" setup

if [[ -r "${CONFIG_DIR}/backup.env" ]]; then
    COMMAND=(ame restore-setup)
    BUTTON="${ gettext "Restore…"; }"
    USAGE="ame restore-setup"
    item setup restore-setup action "${ gettext "Make the setup again from a backup"; }" \
        "${ gettext "On a new machine: the image, apps, containers and theme of your last backup, each step chosen first."; }" \
        "" security#backups
fi

# --- Elsewhere -------------------------------------------------------------------------------------

# Automatic updates are the Updates window's to switch, and backups the Backups window's, where it is
# installed: the window links to them, with the first one's state
# uupd's timer where the image has it (is-enabled says nothing of a unit there is not), rpm-ostree's otherwise
TIMER_STATE="${ said uupd; }"
[[ -n "${TIMER_STATE}" ]] || TIMER_STATE="${ said rpm-ostree; }"
if [[ "${TIMER_STATE}" == enabled ]]; then UPDATES=on; else UPDATES=off; fi
BACKUPS=false
[[ -x /usr/bin/amethystora-backups ]] && BACKUPS=true

# Every entry as the object the window reads, one a line, from item()'s records: as arguments, since jq -R
# breaks a character that its reads of standard input cut in two
ITEM='def text: if . == "" then null else . end;
    def item: split("\u001e") as $f
        | ($f[14] | tonumber) as $count
        | ($f[15:$count + 15] | map(if startswith("{") then fromjson else split("\u001f")
            | {value: .[0], title: .[1], text: (.[2] | text), terminal: (.[3] == "true"), command: .[4:]} end)) as $choices
        | $f[$count + 15:] as $command
        | {page: $f[0], id: $f[1], kind: $f[2], group: ($f[3] | text), title: $f[4], text: ($f[5] | text),
           state: ($f[6] | text), detail: ($f[7] | text), available: ($f[8] == ""), reason: ($f[8] | text),
           manual: ($f[9] | text), usage: ($f[10] | text)}
        + (if $count > 0 then {$choices} else {} end)
        + (if ($command | length) > 0 then {terminal: ($f[12] | fromjson), $command, button: ($f[11] | text)} else {} end)
        + ($f[13] | fromjson);'
items_json() {
    jq -nc "${ITEM}"' $ARGS.positional[] | item' --args "${ITEMS[@]}"
}
# Any reader the list did not need this time ends before its folder goes
wait

# The window's list in one jq, which items_json's lines read again by a second took a thirtieth of a second longer: up
# to the first entry it cannot make, as the two of them stopped there
if [[ "${JSON}" == true ]]; then
    jq -n --argjson sealed "${SEALED}" --arg updates "${UPDATES}" --argjson backups "${BACKUPS}" "${ITEM}"'
        {version: 1, $sealed, elsewhere: {automatic_updates: $updates, $backups},
         items: [label $stop | $ARGS.positional[] | try item catch break $stop]}' --args "${ITEMS[@]}"
    exit 0
fi
ITEMS_JSON="$(items_json)"

# For a terminal: each setting with what it is now, and the command that changes it
declare -A HEADINGS=(
    [appearance]="${ gettext "Appearance"; }"
    [desktop]="${ gettext "Desktop"; }"
    [apps]="${ gettext "Apps"; }"
    [agent]="${ gettext "The AI agent"; }"
    [system]="${ gettext "System"; }"
    [keyboard]="${ gettext "Keyboard"; }"
    [setup]="${ gettext "Your setup"; }"
)
for page in appearance desktop keyboard apps agent system setup; do
    printf '\n  %s\n' "${HEADINGS[${page}]}"
    jq -r --arg page "${page}" \
        'select(.page == $page and .kind != "link")
         | (.state as $state | (.choices // []) | map(select(.value == $state)) | first | .title) as $chosen
         | "   \(.title)" + (if .available | not then ": \(.reason)"
             elif .kind == "range" and .state != null then ": \(.state) \(.unit)"
             elif $chosen != null and .kind != "wallpapers" then ": \($chosen)"
             else "" end),
           (if .usage != null then "          \(.usage)" else empty end)' <<<"${ITEMS_JSON}"
done
echo
echo "${ gettext "Security settings are in Amethystora Security: ame security status"; }"
