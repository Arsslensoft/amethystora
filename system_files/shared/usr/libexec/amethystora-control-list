# --- Make it yours (rounds 5 and 6): a theme of your own, a look in one file, drawn wallpapers, light by day ---------

# Make a theme: every theme's whole palette to start from, and the wallpaper's colours over the current theme's (later
# keys win), each colour only one of a palette's keys. The window checks every colour and the name again before it sends
# them, and the helper once more.
THEME_KEYS='["background","foreground","accent","cursor","selection_foreground","selection_background","color0","color1","color2","color3","color4","color5","color6","color7","color8","color9","color10","color11","color12","color13","color14","color15"]'
# Each palette a head (its value, title and lightness) and a file, read by one awk: the wallpaper's is the current theme's
# file and then what the wallpaper gave, under one head
MAKER_HEADS=()
MAKER_FILES=()
while read -r slug; do
    [[ -n "${slug}" ]] || continue
    light=false
    theme_source_is_light "${slug}" && light=true
    MAKER_HEADS+=("${slug}"$'\x1e'"${ pretty "${slug}"; }"$'\x1e'"${light}")
    MAKER_FILES+=("${ theme_source_dir "${slug}"; }/colors.toml")
done <<<"${THEME_LIST}"
if [[ "${ ended wallpaper-start; }" == 0 && -n "${THEME}" ]]; then
    light=false
    theme_source_is_light "${THEME}" && light=true
    MAKER_HEADS+=(wallpaper$'\x1e'"${ gettext "The wallpaper"; }"$'\x1e'"${light}" "")
    MAKER_FILES+=("${ theme_source_dir "${THEME}"; }/colors.toml" "${WORK}/wallpaper-start")
fi
EXTRA="$(
    awk -v heads="$(printf '%s\n' "${MAKER_HEADS[@]}")" 'BEGIN { split(heads, H, "\n") }
        BEGINFILE { f++; if (H[f] != "") print "\036" H[f] }
        match($0, /^[[:space:]]*([a-z0-9_]+)[[:space:]]*=[[:space:]]*"(#[0-9a-fA-F]{6})"/, m) { print m[1] " " m[2] }' \
        "${MAKER_FILES[@]}" 2>/dev/null |
        jq -Rnc --argjson keys "${THEME_KEYS}" '[inputs] | reduce .[] as $line ([];
            if ($line | startswith("\u001e")) then ($line[1:] | split("\u001e")) as $head
                | . + [{value: $head[0], title: $head[1], light: ($head[2] == "true"), colors: {}}]
            else ($line | split(" ")) as $kv
                | if ($keys | index($kv[0])) then .[-1].colors[$kv[0]] = ($kv[1] | ascii_downcase) else . end end)
        | {starts: ., commands: {
            save: {terminal: false, command: ["ame", "desktop", "theme", "save", "{name}"]},
            import: {terminal: true, command: ["ame", "desktop", "theme", "import", "{file}"]}}}'
)"
USAGE="ame desktop theme save NAME"
item appearance theme-maker theme-maker "${ gettext "Make a theme"; }" \
    "${ gettext "Start from a theme or the wallpaper, pick the ground, the text, the accent, the selection and the terminal's sixteen colours, and see each pair measured as you pick."; }" \
    "" themes#make-a-theme

