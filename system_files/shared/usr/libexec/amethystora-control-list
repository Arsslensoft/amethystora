# The glass in use, its blur and its tint (R6-28), as a share of its own; each glass keeps its own
for KIND in blur tint; do
    [[ "${ ended glass; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
    VALUE="${ value_of "${ said glass; }" "${KIND}-${GLASS:-prism}" "(.*)\$"; }"
    EXTRA="${| object min 50 max 150 step 5 unit '"%"' terminal false \
        command "${| words ame desktop glass-strength "${KIND}" "{value}" "${GLASS:-prism}"; }"; }"
    USAGE="ame desktop glass-strength ${KIND} 50..150 [frost|prism|clear]"
    STATE="$(awk -v a="${VALUE}" 'BEGIN { if (a != "") printf "%.0f", a * 100 }')"
    if [[ "${KIND}" == blur ]]; then
        item appearance glass-blur range "${ gettext "Glass blur"; }" \
            "${ gettext "How deep the glass in use blurs the wallpaper, from light to deep."; }" "${STATE}" themes#glass
    else
        item appearance glass-tint range "${ gettext "Glass tint"; }" \
            "${ gettext "How dense its tint is, from clear to dense. Text on it stays readable at every strength."; }" \
            "${STATE}" themes#glass
    fi
done

