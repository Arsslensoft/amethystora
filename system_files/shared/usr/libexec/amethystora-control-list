    "${COMMAND_DONE}" terminal#told-when-a-command-ends
if [[ -e "${CONFIG_DIR}/missing-command" ]]; then MISSING=on; else MISSING=off; fi
switch_choices false ame desktop missing-command
GROUP="${ gettext "Terminal"; }"
USAGE="ame desktop missing-command on|off"
item desktop missing-command switch "${ gettext "Where a missing command comes from"; }" \
    "${ gettext "A command this computer lacks says where it can come from: Homebrew, a container or Flathub. It never installs anything. In new terminals."; }" \
    "${MISSING}" terminal#a-missing-command

