# --- The AI agent ----------------------------------------------------------------------------------

if [[ "${AGENTIC}" == true ]]; then AGENT_STATE=on; else AGENT_STATE=off; fi
# The account's own level and what the administrator allows it (amethystora-agent policy, agent.conf's one reader),
# in one read. The defaults are jq's, so that no field is empty for read to run two of them together.
need policy
IFS=$'\t' read -r CEILING CHANGES_ON ROOT_MODE ALLOW < <(jq -r 'if type == "object" then . else {} end
    | [.ceiling // "act", .tools // false, .root // "session", .allow // "act"] | @tsv' <<<"${ said policy; }" 2>/dev/null)
[[ -n "${CEILING:-}" ]] || { CEILING=act CHANGES_ON=false ROOT_MODE=session ALLOW=act; }
[[ "${CEILING}" != off ]] || REASON="${ gettext "An administrator turned the AI agent off for this account."; }"
switch_choices false ame agent toggle
USAGE="ame agent toggle on|off"
item agent agent switch "${ gettext "Agentic features"; }" \
    "${ gettext "An AI agent that knows this system, off until you turn it on: Super+Ctrl+Shift+A, Ask the agent in Updates, Security and Logs, and the skills that tell it how Amethystora works."; }" \
    "${AGENT_STATE}" ai-agent#turning-it-on-and-off

# Level 2: the tools that change things, which need level 1 and an administrator allowing them
if [[ "${CHANGES_ON}" == true ]]; then CHANGES=on; else CHANGES=off; fi
if [[ "${AGENTIC}" != true ]]; then
    REASON="${ gettext "Turn the agentic features on first."; }"
elif [[ "${CEILING}" != act ]]; then
    REASON="${ gettext "An administrator allows the agent only to know on this machine."; }"
fi
switch_choices false ame agent tools
USAGE="ame agent tools on|off"
item agent agent-tools switch "${ gettext "Let the agent make changes"; }" \
    "${ gettext "Its tools set Amethystora's settings, install apps, and hand you commands to run, as root too, each asked for every time in the agent and recorded so that it can be undone."; }" \
    "${CHANGES}" ai-agent#what-it-can-do

# "Agentic features: on (claude)", or "(cursor-agent, not installed yet)"
CHOSEN="${ while IFS= read -r line; do
    [[ "${line}" =~ ^Agentic\ features:\ on\ \(([a-z-]*) ]] && printf '%s\n' "${BASH_REMATCH[1]}"
done <<<"${ said agent; }"; }"
# The chosen agent's name while it is not installed yet
MISSING=""
# Each agent amethystora-agent offers, as it finds them: "codex<TAB>installed|missing<TAB>Codex"
need agents
while IFS=$'\t' read -r agent state title; do
    [[ -n "${agent}" ]] || continue
    if [[ "${state}" == installed ]]; then words="${ gettext "Installed"; }"; else words="${ gettext "Not installed yet"; }"; fi
    choice "${agent}" "${title}" "${words}" false ame agent use "${agent}"
    [[ "${agent}" != "${CHOSEN}" || "${state}" == installed ]] || MISSING="${title}"
done < <(said agents)
[[ "${AGENTIC}" == true ]] || REASON="${ gettext "The agentic features are off."; }"
AGENT_IDS=""
first=true
while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${first}" == true ]] || AGENT_IDS+="|"
    first=false
    AGENT_IDS+="${line%%$'\t'*}"
done < <(said agents)
USAGE="ame agent use ${AGENT_IDS}"
item agent agent-choice choice "${ gettext "Which agent"; }" \
    "${ gettext "The agent that Super+Ctrl+Shift+A and Ask the agent open. Each installs the first time you open it, and is kept up to date."; }" \
    "${CHOSEN}" ai-agent#installing-and-updating

if [[ "${AGENTIC}" == true && -n "${MISSING}" ]]; then
    name="${MISSING}"
    words="${ gettext "With its maker's installer, into your home, where it keeps itself up to date."; }"
    COMMAND=(ame agent install)
    BUTTON="${ gettext "Install…"; }"
    USAGE="ame agent install"
    item agent agent-install action "${ eval_gettext "Install \${name}"; }" "${words}" "" ai-agent#installing-and-updating
fi

COMMAND=(ame agent history)
TERMINAL=false
BUTTON="${ gettext "Show"; }"
USAGE="ame agent history"
[[ "${AGENTIC}" == true ]] || REASON="${ gettext "The agentic features are off."; }"
item agent agent-history action "${ gettext "What the agent changed"; }" \
    "${ gettext "Every change the agent's tools made, newest first, each with its id for undoing it."; }" "" ai-agent#history-and-undo

# The agent on the desktop (org.gnome.shell.extensions.amethystora-ui.agent): Super+Shift+A, and its changes in the
# live pill. The agent's own tools may not change either (never.rs)
AGENT_UI="${ said agent-ui; }"
