read_in_background wallpaper-start bash -c 'source /usr/lib/amethystora/theme/lib.sh
    slug="$(theme_current)" && own="$(theme_source_dir "${slug}")" && picture="$(readlink -f "${CURRENT_BACKGROUND}")" &&
    [[ -f "${picture}" ]] || exit 1
    mode=dark; theme_source_is_light "${slug}" && mode=light
    # Kept in the account'"'"'s cache by what it was worked from, so that the list reads the picture once
    cache="${XDG_CACHE_HOME:-${HOME}/.cache}/amethystora/maker-wallpaper.toml"
    stamp="# stamp ${mode} ${picture} $(stat -c "%Y %s" -- "${picture}") ${own}"
    if [[ "$(head -n1 "${cache}" 2>/dev/null)" == "${stamp}" ]]; then exec cat "${cache}"; fi
    mkdir -p "${cache%/*}"
    { echo "${stamp}"; /usr/libexec/amethystora-wallpaper-colours --print --way vivid --mode "${mode}" \
        --background "$(colors_get "${own}" background | tr "[:upper:]" "[:lower:]")" \
        --foreground "$(colors_get "${own}" foreground | tr "[:upper:]" "[:lower:]")" "${picture}"; } >"${cache}.new" &&
        mv "${cache}.new" "${cache}" && exec cat "${cache}"
    rm -f "${cache}.new"
    exit 1'
