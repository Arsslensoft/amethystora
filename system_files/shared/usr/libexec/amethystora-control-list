# --- System ----------------------------------------------------------------------------------------

IMAGE_NAME=""
IMAGE_TAG=""
{ IFS= read -r IMAGE_NAME; IFS= read -r IMAGE_TAG; } < <(jq -r '."image-name" // "", ."image-tag" // ""' "${IMAGE_INFO}" 2>/dev/null)
CHOICES_JSON="${ said image; }"
jq -e . <<<"${CHOICES_JSON}" >/dev/null 2>&1 || CHOICES_JSON='{"images": [], "streams": []}'

# The image with the stream it follows now: the helper still asks, with these chosen, and confirms
while read -r image; do
    [[ -n "${image}" ]] || continue
    case "${image}" in
        amethystora) choice "${image}" "Amethystora" "${ gettext "The desktop"; }" true ame system rebase "${image}" "${IMAGE_TAG}" ;;
        amethystora-dx) choice "${image}" "Amethystora DX" "${ gettext "With the developer tools"; }" true \
            ame system rebase "${image}" "${IMAGE_TAG}" ;;
        amethystora-nvidia-open) choice "${image}" "${ gettext "Amethystora with NVIDIA"; }" "${ gettext "With NVIDIA's open driver"; }" true \
            ame system rebase "${image}" "${IMAGE_TAG}" ;;
        amethystora-dx-nvidia-open) choice "${image}" "${ gettext "Amethystora DX with NVIDIA"; }" \
            "${ gettext "The developer tools, and NVIDIA's open driver"; }" true ame system rebase "${image}" "${IMAGE_TAG}" ;;
        amethystora-nvidia-lts) choice "${image}" "${ gettext "Amethystora with NVIDIA, older cards"; }" \
            "${ gettext "With NVIDIA's driver for the GeForce 900 and 10 series"; }" true ame system rebase "${image}" "${IMAGE_TAG}" ;;
        amethystora-dx-nvidia-lts) choice "${image}" "${ gettext "Amethystora DX with NVIDIA, older cards"; }" \
            "${ gettext "The developer tools, and NVIDIA's driver for the GeForce 900 and 10 series"; }" true \
            ame system rebase "${image}" "${IMAGE_TAG}" ;;
        *) choice "${image}" "${image}" "" true ame system rebase "${image}" "${IMAGE_TAG}" ;;
    esac
done < <(jq -r '.images[]' <<<"${CHOICES_JSON}")
GROUP="${ gettext "The system"; }"
USAGE="ame system rebase IMAGE STREAM"
item system image choice "${ gettext "Image"; }" \
    "${ gettext "The system this machine runs. Switching downloads it, checks its signature, and takes effect at the next restart."; }" \
    "${IMAGE_NAME}" updates#switching-streams-and-images

while read -r stream; do
    [[ -n "${stream}" ]] || continue
    case "${stream}" in
        stable) choice stable "${ gettext "Stable"; }" "${ gettext "Built every week"; }" true ame system rebase "${IMAGE_NAME}" stable ;;
        stable-daily) choice stable-daily "${ gettext "Stable, daily"; }" "${ gettext "The same, built every day"; }" true \
            ame system rebase "${IMAGE_NAME}" stable-daily ;;
        latest) choice latest "${ gettext "Latest"; }" "${ gettext "The newest Fedora, for testers"; }" true \
            ame system rebase "${IMAGE_NAME}" latest ;;
        stable-sealed) choice stable-sealed "${ gettext "Sealed"; }" "${ gettext "Stable, with every file checked as it is read"; }" true \
            ame system rebase "${IMAGE_NAME}" stable-sealed ;;
        *) choice "${stream}" "${stream}" "" true ame system rebase "${IMAGE_NAME}" "${stream}" ;;
    esac
done < <(jq -r '.streams[]' <<<"${CHOICES_JSON}")
[[ "${SEALED}" == true ]] && REASON="${ gettext "This machine is sealed, so it follows the sealed stream only."; }"
GROUP="${ gettext "The system"; }"
# If it's lost, it says whose it is (R7-71): written in a terminal, which says first who can read it
COMMAND=(ame system if-found)
TERMINAL=true
BUTTON="${ gettext "Write the line"; }"
USAGE="ame system if-found [LINE|off]"
item system if-found action "${ gettext "If it's lost, it says whose it is"; }" \
    "${ gettext "One line of yours on the login and lock screens, for an honest finder. Anyone holding the computer can read it."; }" \
    "" hardware#if-its-lost
GROUP="${ gettext "The system"; }"
USAGE="ame system rebase IMAGE STREAM"
item system stream choice "${ gettext "Stream"; }" "${ gettext "How new the builds this machine follows are."; }" \
    "${IMAGE_TAG}" updates#streams

# Restart while you're away: the night time System Updates offers beside Restart now (amethystora-night-restart)
NIGHT=""
[[ -r "${CONFIG_DIR}/night-restart" ]] && IFS= read -r NIGHT <"${CONFIG_DIR}/night-restart"
[[ "${NIGHT}" =~ ^(0[2-4]:[0-5][0-9]|05:00)$ ]] || NIGHT=off
choice off "${OFF}" "${ gettext "Restart now only, when you choose"; }" false ame update night-restart off
for time in 02:00 03:00 04:00 05:00; do
    choice "${time}" "${time}" "" false ame update night-restart "${time}"
done
case "${NIGHT}" in
    off | 02:00 | 03:00 | 04:00 | 05:00) ;;
    *) DETAIL="${ eval_gettext "Set from a terminal: \${NIGHT}."; }" ;;
esac
GROUP="${ gettext "The system"; }"
USAGE="ame update night-restart off|HH:MM"
item system night-restart choice "${ gettext "Restart while you're away"; }" \
    "${ gettext "Updates offers Tonight beside Restart now: the computer restarts at this time only if the screen is locked, no app holds the logout and it is on mains power."; }" \
    "${NIGHT}" updates#restarting-while-youre-away

# An update that does not start goes back by itself (amethystora-boot-guard), off until its owner asks: it writes to the
# boot partition, so it asks for a password in a terminal
[[ -e /usr/share/amethystora/sealed ]] && REASON="${ gettext "A sealed image starts through another boot loader."; }"
switch_choices true ame update boot-guard
USAGE="ame update boot-guard on|off"
item system boot-guard switch "${ gettext "If an update does not start, go back"; }" \
    "${ gettext "After a few tries the computer goes back by itself to the system before the update, and says so. Your files and apps are not touched."; }" \
    "${ [[ -e /var/lib/amethystora/boot-guard/on ]] && echo on || echo off; }" updates#if-an-update-does-not-start

# amethystora-dx and amethystora-dx-nvidia-open are the developer images
if grep -qE -e "-dx(-|$)" <<<"${IMAGE_NAME}"; then DEVMODE=on; else DEVMODE=off; fi
switch_choices true ame system devmode
GROUP="${ gettext "The system"; }"
USAGE="ame system devmode on|off"
item system devmode switch "${ gettext "Developer mode"; }" \
    "${ gettext "The developer image: VSCodium, Docker and Podman, Incus and virtual machines, and tools for profiling and debugging. Switching takes effect at the next restart."; }" \
    "${DEVMODE}" developer#turning-it-on

# The groups are offered, never joined for anyone: three of them amount to root without a password. The
# list is the one the recipe and the security report read.
if [[ "${DEVMODE}" == on ]]; then
    # The account's groups as the group database has them, as the recipe reads them: this process keeps the
    # ones its session started with until the next login
    joined=()
    mine=" ${ id -nG "${ id -un; }" 2>/dev/null; } "
    while read -r group _; do
        [[ "${mine}" == *" ${group} "* ]] && joined+=("${group}")
    done < <(grep -v '^#' /usr/share/amethystora/developer-groups | awk NF)
    if [[ ${#joined[@]} -gt 0 ]]; then
        GROUPS_JOINED="${joined[*]}"
        DETAIL="${ eval_gettext "Your account is in: \${GROUPS_JOINED}"; }"
    fi
    COMMAND=(ame system dx-group)
    BUTTON="${ gettext "Choose…"; }"
    GROUP="${ gettext "The system"; }"
    USAGE="ame system dx-group [GROUP...]"
    item system dx-group action "${ gettext "Developer groups"; }" \
        "${ gettext "Docker, Incus and virtual machines without sudo, and serial devices. Docker, Incus and libvirt each let any program you run become root without your password."; }" \
        "" developer#groups
fi

# The repository and the key come from the window, which checks the one against the rule
# amethystora-trust-image applies to it and takes the other from a file dialog of its own
COMMAND=(ame system trust-image "{repository}" "{key}")
BUTTON="${ gettext "Trust…"; }"
[[ "${SEALED}" == true ]] && REASON="${ gettext "A sealed machine follows Amethystora's sealed images only."; }"
GROUP="${ gettext "The system"; }"
USAGE="ame system trust-image REPOSITORY KEY"
item system trust-image trust-image "${ gettext "An image of your own"; }" \
    "${ gettext "Takes images from your repository only when your key checks their signature. Do this before switching to an image built from the image template."; }" \
    "" developer#an-image-of-your-own

SCHEDULER=""
if [[ -d /sys/kernel/sched_ext ]]; then
    # What the kernel itself says runs: "enabled", and the scheduler's name, while a sched-ext one does
    SCHEDULER=kernel
    if [[ "$(cat /sys/kernel/sched_ext/state 2>/dev/null)" == enabled ]]; then
        ops="$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null)"
        for name in lavd bpfland flash; do
            [[ "${ops}" == "${name}"* ]] && SCHEDULER="${name}"
        done
    fi
else
    REASON="${ gettext "This kernel cannot hand the scheduling to another program."; }"
fi
choice kernel "${ gettext "The kernel's own"; }" "${ gettext "Suits nearly everything (the default)"; }" true ame system scheduler kernel
choice lavd lavd "${ gettext "Keeps games smooth while other work runs"; }" true ame system scheduler lavd
choice bpfland bpfland "${ gettext "Keeps the desktop responsive while something heavy builds or renders"; }" true ame system scheduler bpfland
choice flash flash "${ gettext "Steady timing, for audio and music work"; }" true ame system scheduler flash
GROUP="${ gettext "Hardware"; }"
USAGE="ame system scheduler NAME"
item system scheduler choice "${ gettext "CPU scheduler"; }" "${ gettext "What decides which program runs on the CPU next."; }" \
    "${SCHEDULER}" games#a-faster-cpu-scheduler-for-games

# What ame system zram chose, in the file it writes; the image's own otherwise
ZRAM="$(sed -n 's/^# mode: //p' /etc/systemd/zram-generator.conf.d/90-amethystora-choice.conf 2>/dev/null)"
choice default "${ gettext "Quick, then repacked"; }" \
    "${ gettext "The most memory left and the quickest return, for a little work every hour on mains power (the default)"; }" \
    true ame system zram default
choice fast "${ gettext "Quick"; }" "${ gettext "Nothing runs in the background, but it takes more memory"; }" true ame system zram fast
choice compact "${ gettext "Compact"; }" "${ gettext "Small from the start, but a program that was moved out comes back half as quickly"; }" \
    true ame system zram compact
GROUP="${ gettext "Hardware"; }"
USAGE="ame system zram MODE"
item system zram choice "${ gettext "Swapped-out memory"; }" \
    "${ gettext "How what programs are not using is compressed when RAM runs short. From the next restart."; }" \
    "${ZRAM:-default}" hardware#memory

# How long it takes to start, one number a start: what was measured and its graph, whatever they say, and whether to go
# on measuring. The words and the numbers are the helper's: title, text, the points of the graph, whether it got slower.
# What changed is not read here, for the list never waits on the deployments: a button asks for it, once it did get slower.
# An account that may not read the history (not an administrator) gets no card.
START_TIMES="${ said start-times; }"
mapfile -t START_FIELDS <<<"${START_TIMES}"
if [[ "${ ended start-times; }" == 0 && ${#START_FIELDS[@]} -ge 4 ]]; then
    GROUP="${ gettext "Starting up"; }"
    USAGE="ame system start-times"
    TERMINAL=false
    EXTRA="{\"points\": ${START_FIELDS[2]}}"
    item system start-times graph "${START_FIELDS[0]}" "${START_FIELDS[1]}" "" hardware#how-long-it-takes-to-start
    if [[ "${START_FIELDS[3]}" == true ]]; then
        COMMAND=(ame system start-times why)
        BUTTON="${ gettext "What changed"; }"
        USAGE="ame system start-times why"
        item system start-times-why action "${ gettext "What it got slower with"; }" \
            "${ gettext "The update it came with, if there was one, and what took longest in this start."; }" "" hardware#how-long-it-takes-to-start
    fi
fi
switch_choices true ame system start-times
GROUP="${ gettext "Starting up"; }"
USAGE="ame system start-times on|off"
item system start-times-measure switch "${ gettext "Measure each start"; }" \
    "${ gettext "One number each time the computer starts, kept on this computer and never sent."; }" \
    "${ [[ -e /etc/systemd/system/multi-user.target.wants/amethystora-start-times.service ]] && echo on || echo off; }" hardware#how-long-it-takes-to-start
