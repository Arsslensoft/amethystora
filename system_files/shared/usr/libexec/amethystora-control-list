    DETAIL="${ gettext "This theme has no light and dark pair, so it stays as it is: Amethystora and Amethystora Light, and Catppuccin Mocha and Latte, have one."; }"
fi
choice off "${OFF}" "" false ame desktop day-night off
choice night-light "${ gettext "Night Light's times"; }" "${ gettext "Sunrise and sunset, or Night Light's own hours"; }" false \
    ame desktop day-night night-light
choice hours "${ gettext "Hours you choose"; }" "${ gettext "The two hours below"; }" false \
    ame desktop day-night hours "${DAY_STARTS}" "${NIGHT_STARTS}"
USAGE="ame desktop day-night on|off|hours FROM TO"
item appearance day-night choice "${ gettext "Light by day, dark by night"; }" \
    "${ gettext "A theme with a light and a dark side switches to its light side when the day starts and to its dark side when the night does."; }" \
    "${DAY_NIGHT}" themes#light-by-day-dark-by-night
for which in day night; do
    [[ "${DAY_NIGHT}" == hours ]] || REASON="${ gettext "Choose Hours you choose first."; }"
    if [[ "${which}" == day ]]; then
        EXTRA="${| object min 0 max 23 step 1 unit '"h"' terminal false \
            command "${| words ame desktop day-night hours "{value}" "${NIGHT_STARTS}"; }"; }"
        USAGE="ame desktop day-night hours FROM TO"
        item appearance day-starts range "${ gettext "The day starts at"; }" "${ gettext "The hour, from 0 to 23."; }" \
            "${DAY_STARTS}" themes#light-by-day-dark-by-night
    else
        EXTRA="${| object min 0 max 23 step 1 unit '"h"' terminal false \
            command "${| words ame desktop day-night hours "${DAY_STARTS}" "{value}"; }"; }"
        USAGE="ame desktop day-night hours FROM TO"
        item appearance night-starts range "${ gettext "The night starts at"; }" "${ gettext "The hour, from 0 to 23."; }" \
            "${NIGHT_STARTS}" themes#light-by-day-dark-by-night
    fi
done

