#!/usr/bin/bash
# Saving data on a connection that counts it (plans/ui-ideas/spec-restart.md 3). On a connection NetworkManager calls
# metered (yes, or guessed yes: a phone's hotspot, mobile broadband, a network marked so in Settings), the updates that
# start by themselves wait for one that does not: the system update with the apps and Homebrew (uupd.service), the
# containers' upgrade (amethystora-pkg-upgrade.service) and a backup to the network (amethystora-backup.service). Each
# unit asks this in its ExecCondition, so a skipped run is neither a failure nor a retry. Never longer than a week: the
# first run that waited is kept in a stamp, and once that is seven days old the run goes whatever the connection. A run
# that worked takes the stamp away (each unit's ExecStartPost).
#
#   metered        exits 0 when the connection counts data
#   wait WHAT      ExecCondition: 0 to run, 1 to wait. A run a person started (no $TRIGGER_UNIT: Update now, Back up
#                  now, ame update) always runs, as does a backup to a disk of this machine.
#   done WHAT      ExecStartPost: the stamp taken away
#   status --json  {"metered": true|false, "waiting": {"system": SECONDS|null, "containers": ..., "backup": ...}}
#
# WHAT is system (as root: the stamp in /var/lib/amethystora/metered, readable by everyone, so that the pill and System
# Updates can say since when), containers or backup (as the account: in ~/.local/state/amethystora/metered).

set -euo pipefail

WEEK=$((7 * 24 * 3600))
SYSTEM_DIR=/var/lib/amethystora/metered
USER_DIR="${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/amethystora/metered"
BACKUP_ENV="${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/amethystora/backup.env"
# Filesystems that are another machine's disk
NETWORK_FS='^(nfs|nfs4|cifs|smb3|smbfs|9p|ceph|glusterfs|davfs|fuse\.(sshfs|rclone|s3fs|davfs2|gvfsd-fuse))$'

usage() {
    echo "usage: ${0##*/} metered | wait system|containers|backup | done system|containers|backup | status --json" >&2
    exit 2
}

# NMMetered: 1 yes, 3 guessed yes (4 guessed no, 2 no, 0 unknown)
metered() {
    [[ "$(busctl --system get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
        org.freedesktop.NetworkManager Metered 2>/dev/null)" =~ ^u\ (1|3)$ ]]
}

stamp_of() {
    case "$1" in
        system) echo "${SYSTEM_DIR}/system" ;;
        containers | backup) echo "${USER_DIR}/$1" ;;
        *) usage ;;
    esac
}

# Whether the backup goes to this machine's own disks: a path (or local:path) on a filesystem that is not a share
backup_is_local() {
    local repository path fstype
    [[ -r "${BACKUP_ENV}" ]] || return 1
    # Read, never run: the line as `ame backup` writes it, quotes and all
    repository="$(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?RESTIC_REPOSITORY=//p' "${BACKUP_ENV}" | tail -n1)"
    repository="${repository%\"}"
    repository="${repository#\"}"
    repository="${repository%\'}"
    repository="${repository#\'}"
    path="${repository#local:}"
    [[ "${path}" == /* ]] || return 1
    while [[ ! -e "${path}" && "${path}" != / ]]; do path="$(dirname -- "${path}")"; done
    fstype="$(findmnt -n -o FSTYPE --target "${path}" 2>/dev/null | head -n1)"
    [[ -n "${fstype}" && ! "${fstype}" =~ ${NETWORK_FS} ]]
}

do_wait() {
    local what="$1" stamp first now
    stamp="$(stamp_of "${what}")"
    # Started by a person, not by its timer
    [[ -n "${TRIGGER_UNIT:-}" ]] || return 0
    if [[ "${what}" == backup ]] && backup_is_local; then
        return 0
    fi
    if ! metered; then
        rm -f -- "${stamp}"
        return 0
    fi
    now="$(date +%s)"
    if [[ -s "${stamp}" ]]; then
        first="$(head -c 32 -- "${stamp}" | tr -dc 0-9)"
        if [[ -n "${first}" && $((now - first)) -ge ${WEEK} ]]; then
            echo "This connection counts data, but this has waited a week for another: it runs now."
            return 0
        fi
    else
        mkdir -p -m 0755 -- "$(dirname -- "${stamp}")"
        printf '%s\n' "${now}" >"${stamp}"
        chmod 0644 -- "${stamp}"
    fi
    echo "This connection counts data: waiting for one that does not (at most a week). It runs at once when started by hand."
    return 1
}

stamp_json() {
    local stamp first
    stamp="$(stamp_of "$1")"
    first="$(head -c 32 -- "${stamp}" 2>/dev/null | tr -dc 0-9)" || true
    if [[ -n "${first}" ]]; then echo "${first}"; else echo null; fi
}

[[ $# -ge 1 ]] || usage
case "$1" in
    metered)
        [[ $# -eq 1 ]] || usage
        metered
        ;;
    wait)
        [[ $# -eq 2 ]] || usage
        do_wait "$2"
        ;;
    done)
        [[ $# -eq 2 ]] || usage
        rm -f -- "$(stamp_of "$2")"
        ;;
    status)
        [[ $# -eq 2 && "$2" == --json ]] || usage
        if metered; then on=true; else on=false; fi
        printf '{"metered":%s,"waiting":{"system":%s,"containers":%s,"backup":%s}}\n' "${on}" \
            "$(stamp_json system)" "$(stamp_json containers)" "$(stamp_json backup)"
        ;;
    *) usage ;;
esac
