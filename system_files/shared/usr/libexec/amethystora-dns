#!/usr/bin/bash
# Encrypted DNS (ame security dns): every name this machine looks up goes over DNS-over-TLS to one
# resolver its owner chose, so the network it is on neither sees the names nor answers for them.
#
#   amethystora-dns status                 on or off
#   amethystora-dns name                   the resolver's name, or the servers' names for one's own
#   amethystora-dns list                   id, name, who runs it, a note or "-", servers: one a line, by tabs
#   amethystora-dns paused                 exit 0 while a pause lasts
#   amethystora-dns on RESOLVER            as root: send lookups to one of the list's
#   amethystora-dns on custom SERVER...    as root: ...or to servers of one's own, each ADDRESS#NAME
#   amethystora-dns off                    as root: back to the network's own DNS servers
#   amethystora-dns pause                  as root: the network's own servers, in plain text, for ten minutes
#   amethystora-dns resume                 as root: end a pause
#   amethystora-dns watch                  as the user, in the session: offer a pause on a network that
#                                          wants a login first (amethystora-dns-portal.service, a user unit)
#   amethystora-dns domains                as root: take the search domains a Wi-Fi or wired network
#                                          handed out off it, but those only a network can have (see below)
#   amethystora-dns domains-watch          as root: `domains` again whenever NetworkManager reports a change
#                                          (amethystora-dns-domains.service, started by `on`, stopped by `off`)
#
# The switch is two files, and nothing in /etc/amethystora/security.conf:
#
#   /etc/systemd/resolved.conf.d/60-amethystora-dns.conf  the servers, DNSOverTLS=yes, and the route-only
#       domain "~.", which makes them the best match for every name that is on no network's own
#       domains, so that no network's servers are asked for those (systemd-resolved.service(8))
#   /etc/NetworkManager/conf.d/60-amethystora-dns.conf     the network's own servers in plain text, for
#       what still goes to them: names on that network (a printer's), a VPN's own names, and
#       NetworkManager's connectivity check, which asks each network's servers and would otherwise find
#       every network offline. Tailscale sets the same on its own interface.
#
# What a network hands out over DHCP or in a router advertisement (its domain name and search list) reaches
# systemd-resolved as that network's search domains, and a search domain is also a routing domain: a name goes to
# the network whose domain matches it with the most labels, and the global "~." matches with none. A hostile
# network that hands out "com", or the name of a bank, would take every lookup under it back, in plain text, and
# answer it. NetworkManager has no setting that drops a lease's domains and keeps its servers (ignore-auto-dns
# drops both, and the servers are what the connectivity check and a login page's pause need), and a dispatcher
# script is not used here, so `domains` (run by a root service that wakes on `nmcli monitor`, as the portal's
# watcher does) takes the search domains a lease or router advertisement gave a Wi-Fi or wired network off it, but those under a name
# only a network has (DOMAINS_KEPT). Never touched: a VPN's or Tailscale's, the connection's own DNS search domains
# (ipv4.dns-search, ipv6.dns-search) and a domain routed on purpose, which begins with "~".
#
# A pause is a third file, in /run, after the first in order and so over it: it empties the servers and
# the route-only domain, and amethystora-dns-resume.timer takes it away again after ten minutes, as a
# restart does. DNSSEC is left as systemd-resolved has it, off: its allow-downgrade mode breaks too many
# networks to turn on for everyone.

set -euo pipefail

RESOLVED_DROP_IN=/etc/systemd/resolved.conf.d/60-amethystora-dns.conf
NM_DROP_IN=/etc/NetworkManager/conf.d/60-amethystora-dns.conf
NM_SHIPPED=/usr/share/amethystora/network/60-amethystora-dns.conf
PAUSE=/run/systemd/resolved.conf.d/99-amethystora-dns-pause.conf

# The resolvers offered, each with DNS-over-TLS on every address it publishes. The note is said before
# choosing it.
RESOLVERS="quad9	Quad9	the Quad9 Foundation, in Switzerland	It also refuses to look up sites known for malware.	9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
mullvad	Mullvad	Mullvad VPN AB, in Sweden	-	194.242.2.2#dns.mullvad.net 2a07:e340::2#dns.mullvad.net
cloudflare	Cloudflare	Cloudflare, Inc., in the United States	-	1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com
google	Google	Google LLC, in the United States	Google keeps the address each lookup came from for a day or two.	8.8.8.8#dns.google 8.8.4.4#dns.google 2001:4860:4860::8888#dns.google 2001:4860:4860::8844#dns.google"

usage() {
    echo "usage: ${0##*/} status|name|list|paused|on RESOLVER|on custom ADDRESS#NAME...|off|pause|resume|watch|domains|domains-watch" >&2
    exit 64
}

# A server of one's own: an IPv4 or IPv6 address, then the name its certificate is for, which strict
# DNS-over-TLS checks
valid_server() {
    local address="${1%%#*}" name="${1#*#}" octet
    [[ "$1" == *#* ]] || return 1
    if [[ "${address}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        for octet in ${address//./ }; do
            ((10#${octet} <= 255)) || return 1
        done
    elif [[ ! "${address}" =~ ^[0-9a-fA-F:]+$ || "${address}" != *:*:* ]]; then
        return 1
    fi
    [[ "${name}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]]
}

# A reload, never a restart. On reload systemd-resolved re-reads its files and keeps what was set on each
# network over D-Bus, by NetworkManager and by Tailscale, as it keeps everything on a link systemd-networkd
# does not manage (resolved-manager.c, manager_dispatch_reload_signal; resolved-link.c,
# link_read_settings). A restart would forget it all. Its unit reloads from systemd 256 on
# (Type=notify-reload), which 20-tests.sh checks.
apply_resolved() {
    systemctl is-active --quiet systemd-resolved.service || return 0
    systemctl reload systemd-resolved.service
}

# NetworkManager builds a network's DNS settings, DNS-over-TLS among them, when it connects, from the
# connection and then from the defaults in NetworkManager.conf. A changed default reaches the networks
# connected already only through a change to their running connection: `nmcli device reapply` with none
# rebuilds nothing (nm-device.c, check_and_reapply_connection). So each is changed there alone, with
# `nmcli device modify`, which leaves the saved profile and the DHCP lease as they are: to "no" when this
# turns on, and when it turns off to "no" and then back to "default", which is a change whichever it ran
# with, so that NetworkManager builds the settings again from defaults without this file. A network whose
# own settings choose DNS-over-TLS keeps its choice. Should a change be refused, the network connects
# again, which builds everything afresh. A VPN that runs through a plugin takes it up when it next connects.
apply_networks() {
    local mode="$1" device type state uuid own
    systemctl is-active --quiet NetworkManager.service || return 0
    nmcli general reload conf
    while IFS=: read -r device type state uuid; do
        [[ "${state}" == connected && "${type}" =~ ^(ethernet|wifi|wireguard)$ && -n "${uuid}" ]] || continue
        # -g prints this setting as a number, -1 for "default" (nm-meta-setting-desc.c)
        own="$(nmcli -g connection.dns-over-tls connection show "${uuid}" 2>/dev/null || true)"
        [[ "${own}" =~ ^(-1|default) ]] || continue
        if nmcli device modify "${device}" connection.dns-over-tls no >/dev/null &&
            { [[ "${mode}" == on ]] || nmcli device modify "${device}" connection.dns-over-tls default >/dev/null; }; then
            continue
        fi
        echo "Connecting ${device} again, to apply it there" >&2
        nmcli connection up "${uuid}" ifname "${device}" >/dev/null ||
            echo "${device} could not connect again: it takes this up when it next connects" >&2
    done < <(nmcli -t -f DEVICE,TYPE,STATE,CON-UUID device 2>/dev/null)
}

# A notification in the session, and on its button `ame security dns pause` in a terminal, which asks for
# the password: pausing on the network's say-so alone would let any network turn the encryption off.
# Critical, so that it stays on the screen with its button until it is answered: GNOME Shell shows a
# normal one for a few seconds, collapsed, without its button, and the network is of no use until then.
offer_pause() {
    local answer
    command -v gdbus >/dev/null && gdbus wait --session --timeout 60 org.freedesktop.Notifications >/dev/null 2>&1
    answer="$(notify-send --app-name=Amethystora --icon=network-wireless --urgency=critical --wait \
        --action=pause="Pause for ten minutes…" \
        "This network wants you to log in first" \
        "Encrypted DNS keeps its login page from loading. Pausing it lets the network's own DNS servers answer, in plain text, for ten minutes." ||
        true)"
    [[ "${answer}" == pause ]] || return 0
    systemd-run --user --collect --quiet /usr/libexec/amethystora-in-terminal ame security dns pause
}

# What only a network can have for a name: those the standards keep out of the public DNS, and what routers and offices use
DOMAINS_KEPT='(^|\.)(local|lan|home|home\.arpa|internal|intranet|private|corp|localdomain|in-addr\.arpa|ip6\.arpa)$'

# The search domains of each connected Wi-Fi and wired network that came from its lease or router advertisement, but those under
# a name only a network has: see the top. Not a VPN's or Tailscale's (other kinds of device), nor those the connection itself
# lists in its DNS search domains (ipv4.dns-search, ipv6.dns-search), nor the ones routed on purpose, which begin with "~".
# Idempotent, and quiet when there is nothing to take off; resolved keeps what is set until the network goes away or
# NetworkManager sets its domains again, which is when the watcher runs this once more.
domains() {
    local device type state uuid line own domain regex='^Link [0-9]+ \(([^)]+)\):(.*)$' all kept current
    command -v resolvectl >/dev/null || return 0
    command -v nmcli >/dev/null || return 0
    while IFS=: read -r device type state uuid; do
        [[ "${state}" == connected && "${type}" =~ ^(ethernet|wifi)$ && -n "${uuid}" ]] || continue
        # What the connection itself lists, one domain to a word, whatever separates them
        own=" $(nmcli -g ipv4.dns-search,ipv6.dns-search connection show "${uuid}" 2>/dev/null | tr ',\n' '  ' | tr '[:upper:]' '[:lower:]') "
        # `--` so that nothing a network or a connection names is taken for an option
        current="$(resolvectl domain -- "${device}")" || { echo "Could not read the search domains of ${device}" >&2; continue; }
        line="$(grep -m1 -E "${regex}" <<<"${current}" || true)"
        [[ "${line}" =~ ${regex} ]] || continue
        read -ra all <<<"${BASH_REMATCH[2]}"
        kept=()
        for domain in "${all[@]}"; do
            if [[ "${domain}" == "~"* || "${domain,,}" =~ ${DOMAINS_KEPT} || "${own}" == *" ${domain,,} "* ]]; then kept+=("${domain}"); fi
        done
        ((${#kept[@]} < ${#all[@]})) || continue
        # An empty string clears the list
        if ((${#kept[@]})); then resolvectl domain -- "${device}" "${kept[@]}"; else resolvectl domain -- "${device}" ""; fi ||
            echo "Could not take the search domains off ${device}" >&2
    done < <(nmcli -t -f DEVICE,TYPE,STATE,CON-UUID device 2>/dev/null)
}

# As root, from amethystora-dns-domains.service. NetworkManager sets a network's domains just before it reports the network
# connected, and again at its next change, so each event is followed by two passes, one second and four seconds after it.
domains_watch() {
    local _
    command -v nmcli >/dev/null || exit 0
    while read -r _; do
        [[ -e "${RESOLVED_DROP_IN}" ]] || exit 0
        sleep 1
        domains
        sleep 3
        domains
        # What came in meanwhile is the same change
        while read -r -t 0.2 _; do :; done
    done < <(LC_ALL=C nmcli monitor 2>/dev/null)
    # nmcli monitor ends only when it fails, and the unit starts this again
    exit 1
}

case "${1:-}" in
    status)
        if [[ -e "${RESOLVED_DROP_IN}" ]]; then echo on; else echo off; fi
        ;;
    name)
        id="$(sed -n 's/^# amethystora-resolver: //p' "${RESOLVED_DROP_IN}" 2>/dev/null || true)"
        if [[ "${id}" == custom ]]; then
            sed -n 's/^DNS=//p' "${RESOLVED_DROP_IN}" | tr ' ' '\n' | sed 's/^[^#]*#//' | sort -u | paste -sd' ' -
        else
            awk -F'\t' -v id="${id}" '$1 == id { print $2 }' <<<"${RESOLVERS}"
        fi
        ;;
    list)
        printf '%s\n' "${RESOLVERS}"
        ;;
    paused)
        [[ -e "${RESOLVED_DROP_IN}" && -e "${PAUSE}" ]]
        ;;
    on)
        id="${2:-}"
        [[ -n "${id}" ]] || usage
        if [[ "${id}" == custom ]]; then
            shift 2
            [[ $# -ge 1 && $# -le 8 ]] || usage
            for server in "$@"; do
                valid_server "${server}" || { echo "Not ADDRESS#NAME: ${server}" >&2; exit 65; }
            done
            name="your own servers"
            servers="$*"
        else
            line="$(awk -F'\t' -v id="${id}" '$1 == id' <<<"${RESOLVERS}")"
            [[ -n "${line}" ]] || { echo "No resolver called ${id}" >&2; exit 65; }
            IFS=$'\t' read -r _ name _ _ servers <<<"${line}"
        fi
        install -Dpm0644 "${NM_SHIPPED}" "${NM_DROP_IN}"
        apply_networks on
        mkdir -p "${RESOLVED_DROP_IN%/*}"
        cat >"${RESOLVED_DROP_IN}.new" <<EOF
# Written by ame security dns (/usr/libexec/amethystora-dns), which says what this is and turns it off.
# Every name on no network's own domains goes to ${name}, over DNS-over-TLS, and to nobody else.
# amethystora-resolver: ${id}
[Resolve]
DNS=${servers}
DNSOverTLS=yes
Domains=~.
EOF
        chmod 0644 "${RESOLVED_DROP_IN}.new"
        mv "${RESOLVED_DROP_IN}.new" "${RESOLVED_DROP_IN}"
        apply_resolved
        # Restarted, it takes the domains of the networks connected now off at once
        systemctl restart amethystora-dns-domains.service 2>/dev/null || true
        ;;
    off)
        # Stopped first: the changes below make NetworkManager give each network's own domains back, which it must not take off again
        systemctl stop amethystora-dns-domains.service 2>/dev/null || true
        # A reload forgets the servers but not the route-only domain, which only an empty Domains= clears
        mkdir -p "${RESOLVED_DROP_IN%/*}"
        printf '[Resolve]\nDomains=\n' >"${RESOLVED_DROP_IN}"
        rm -f "${PAUSE}"
        systemctl stop amethystora-dns-resume.timer 2>/dev/null || true
        apply_resolved
        rm -f "${RESOLVED_DROP_IN}"
        apply_resolved
        rm -f "${NM_DROP_IN}"
        apply_networks off
        ;;
    pause)
        [[ -e "${RESOLVED_DROP_IN}" ]] || { echo "Encrypted DNS is off: there is nothing to pause." >&2; exit 1; }
        mkdir -p "${PAUSE%/*}"
        cat >"${PAUSE}" <<'EOF'
# Written by ame security dns pause: the network's own DNS servers answer, in plain text, until
# amethystora-dns-resume.timer takes this away, ten minutes after it was written, or the next restart.
[Resolve]
DNS=
Domains=
DNSOverTLS=no
EOF
        # Restarted, the timer counts its ten minutes from now
        systemctl restart amethystora-dns-resume.timer
        apply_resolved
        ;;
    resume)
        rm -f "${PAUSE}"
        systemctl stop amethystora-dns-resume.timer 2>/dev/null || true
        apply_resolved
        ;;
    domains) domains ;;
    domains-watch)
        [[ -e "${RESOLVED_DROP_IN}" ]] || exit 0
        domains
        domains_watch
        ;;
    watch)
        # As the user, in the graphical session (amethystora-dns-portal.service, a user unit): every change
        # NetworkManager reports wakes it, and when the machine's connectivity turns to "portal", a network
        # that wants a login first, it offers the pause. nmcli reads NetworkManager's state as any user may,
        # and with -t prints it untranslated (nmcli/common.c). It stops once encrypted DNS is turned off.
        command -v notify-send >/dev/null || exit 0
        last=""
        check() {
            local state
            [[ -e "${RESOLVED_DROP_IN}" ]] || exit 0
            state="$(nmcli -t -f CONNECTIVITY general 2>/dev/null || true)"
            if [[ "${state}" == portal && "${last}" != portal && ! -e "${PAUSE}" ]]; then
                offer_pause &
            fi
            last="${state}"
        }
        check
        while read -r _; do
            check
        done < <(LC_ALL=C nmcli monitor 2>/dev/null)
        # nmcli monitor ends only when it fails, and the unit starts this again
        exit 1
        ;;
    *) usage ;;
esac
