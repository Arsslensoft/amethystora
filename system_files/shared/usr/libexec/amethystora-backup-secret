#!/usr/bin/bash
# What the backup to another computer (R7-35) keeps secret, sealed in the Vault under its `background` key, which the Vault serves with the vault closed,
# so that a night's backup needs no one: this account's client key for the other computer, and the repository's password.
#
#   amethystora-backup-secret store-client       < PEM (certificate and key)   seal it
#   amethystora-backup-secret store-password    < password                    seal it
#   amethystora-backup-secret password                                        the repository's password on standard output (RESTIC_PASSWORD_COMMAND)
#   amethystora-backup-secret client DIR                                      the client certificate and key, as DIR/client.pem (0600): the caller makes DIR
#                                                                             in $XDG_RUNTIME_DIR and removes it (lib/backup-secrets.sh)
#
# The sealed files are ~/.local/share/amethystora/backup-other/{client,password}.avs: ciphertext only. Nothing here is an argument, an environment
# variable or a log line. Status: 0 done, 3 the Vault is closed (nothing is asked: say "Open Vault"), 4 no Vault is set up, 1 anything else.
# Without the `background` key (no TPM) the Vault answers closed whenever it is, and a night's run waits for it.

set -euo pipefail

KEEP=/usr/libexec/amethystora-vault-keep
DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/amethystora/backup-other"
PURPOSE=background

say() { printf '%s\n' "$*" >&2; }

# Vault's refusal as this program's: 3 closed, 4 not set up
refused() {
    case "$1" in
        3) say "The Vault is closed." ; exit 3 ;;
        4) say "No Vault is set up." ; exit 4 ;;
        *) say "The Vault did not answer." ; exit 1 ;;
    esac
}

seal() {
    local record="$1" file="$2" tmp
    mkdir -p "${DIR}"
    chmod 0700 "${DIR}"
    tmp="$(umask 077 && mktemp "${DIR}/.${file}.XXXXXX")"
    if "${KEEP}" seal "${PURPOSE}" "${record}" >"${tmp}"; then
        mv -f -- "${tmp}" "${DIR}/${file}"
    else
        local code=$?
        rm -f -- "${tmp}"
        refused "${code}"
    fi
}

unseal() {
    local record="$1" file="$2"
    [[ -r "${DIR}/${file}" ]] || { say "Nothing is sealed for the backup to the other computer."; exit 1; }
    "${KEEP}" open "${PURPOSE}" "${record}" <"${DIR}/${file}" || refused $?
}

case "${1:-}" in
    store-client) seal backup-client-key client.avs ;;
    store-password) seal backup-repo-password password.avs ;;
    password) unseal backup-repo-password password.avs ;;
    client)
        [[ -n "${2:-}" && -d "${2}" ]] || { say "usage: ${0##*/} client DIR"; exit 2; }
        (umask 077 && unseal backup-client-key client.avs >"${2}/client.pem")
        ;;
    *) say "usage: ${0##*/} store-client|store-password|password|client DIR"; exit 2 ;;
esac
