#!/usr/bin/bash
# Another screen from what you have, and help from someone you trust (R7-26, R7-50), both on GNOME's own remote desktop
# (gnome-remote-desktop, RDP), run as the account, on the home network only, and off until asked:
#
#   amethystora-share-screen second-screen on|off   an old laptop or tablet as a second screen: its own virtual monitor
#                                                   next to this one (`screen-share-mode extend`), keyboard and touch from the other side
#   amethystora-share-screen help on|off            someone you trust sees this screen and nothing more (`mirror-primary`,
#                                                   view only), until you stop it, lock the screen, or an hour has gone
#   amethystora-share-screen help control on|off    let them use the mouse and keyboard too, or take that back
#   amethystora-share-screen status                 as JSON: the mode, the address and port, whether the code was made now
#   amethystora-share-screen watch                  (run by `help on`) ends the share when the screen locks, or after an hour
#
# What it does, and no more: RDP is turned on with a certificate made here for this one purpose, a user name and a
# new eight-digit code every time (shown to the person at this computer, who says it to the other), the one port
# opened in the firewall's home zone for as long as it lasts (runtime only: a reload or a restart closes it, and on a network
# that is not named home it is not reachable at all), and every setting put back when it ends. Across the internet it cannot work
# without a relay, which Amethystora does not run: reach this computer only from the home network, or over a VPN you run
# yourself. Nothing is sent anywhere by this program; GNOME's remote desktop shows its own indicator in the top bar while
# anyone is connected, and the share guard covers private windows while the whole screen is shared.

set -euo pipefail

export TEXTDOMAIN=amethystora
# shellcheck source=/dev/null
source gettext.sh

SCHEMA=org.gnome.desktop.remote-desktop.rdp
STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/amethystora/share-screen"
KEYS="${XDG_DATA_HOME:-${HOME}/.local/share}/amethystora/share-screen"
ZONE=amethystora-home
SERVICE=ms-wbt
PORT=3389
USER_NAME=amethystora
# An hour, in seconds, for the help
LIMIT=3600

usage() {
    echo "usage: amethystora-share-screen second-screen on|off | help on|off | help control on|off | status | watch" >&2
    exit 64
}

mode() { cat "${STATE}/mode" 2>/dev/null || echo off; }

# Eight digits from the kernel's random numbers, said by the person at this computer to the other
new_code() {
    local number
    number="$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')"
    printf '%08d' "$((number % 100000000))"
}

# The certificate RDP needs, made once for this and nothing else
make_keys() {
    [[ -s "${KEYS}/rdp.crt" && -s "${KEYS}/rdp.key" ]] && return 0
    mkdir -p -m 0700 "${KEYS}"
    openssl req -x509 -newkey rsa:3072 -nodes -days 3650 -subj "/CN=$(hostname)" -keyout "${KEYS}/rdp.key" -out "${KEYS}/rdp.crt" 2>/dev/null
    chmod 0600 "${KEYS}/rdp.key"
}

# The port, in the home zone only and for now only
open_port() { firewall-cmd --zone="${ZONE}" --add-service="${SERVICE}" >/dev/null; }
close_port() { firewall-cmd --zone="${ZONE}" --remove-service="${SERVICE}" >/dev/null 2>&1 || true; }

# The settings as they were, kept to put back: only what this changes
remember() {
    mkdir -p -m 0700 "${STATE}"
    {
        echo "screen-share-mode=$(gsettings get "${SCHEMA}" screen-share-mode)"
        echo "view-only=$(gsettings get "${SCHEMA}" view-only)"
        echo "enable=$(gsettings get "${SCHEMA}" enable)"
        echo "negotiate-port=$(gsettings get "${SCHEMA}" negotiate-port)"
    } >"${STATE}/before"
}

restore() {
    local key value
    [[ -f "${STATE}/before" ]] || return 0
    while IFS== read -r key value; do
        case "${key}" in
            screen-share-mode | view-only | enable | negotiate-port) gsettings set "${SCHEMA}" "${key}" "${value}" ;;
        esac
    done <"${STATE}/before"
    rm -f "${STATE}/before"
}

start() { # MODE VIEW_ONLY(true|false)
    local want="$1" view="$2" code share
    command -v grdctl >/dev/null || { gettext "GNOME's remote desktop is not installed."; echo; exit 1; }
    [[ "$(mode)" == off ]] || stop quiet
    case "${want}" in
        second-screen) share=extend ;;
        *) share=mirror-primary ;;
    esac
    remember
    make_keys
    code="$(new_code)"
    gsettings set "${SCHEMA}" screen-share-mode "${share}"
    gsettings set "${SCHEMA}" view-only "${view}"
    gsettings set "${SCHEMA}" negotiate-port false
    grdctl rdp set-port "${PORT}"
    grdctl rdp set-tls-cert "${KEYS}/rdp.crt"
    grdctl rdp set-tls-key "${KEYS}/rdp.key"
    grdctl rdp set-auth-methods credentials
    # The code lives in GNOME's keyring, as the settings app's own does, and is made again every time
    grdctl rdp set-credentials "${USER_NAME}" "${code}"
    if ! open_port; then
        grdctl rdp clear-credentials || true
        restore
        gettext "The firewall did not open the port, so nothing was shared."; echo
        exit 1
    fi
    grdctl rdp enable
    systemctl --user enable --now gnome-remote-desktop.service 2>/dev/null || systemctl --user start gnome-remote-desktop.service
    echo "${want}" >"${STATE}/mode"
    date +%s >"${STATE}/since"
    if [[ "${want}" == help ]]; then
        # Ends when the screen locks, and after an hour, by a transient user unit of its own
        systemd-run --user --quiet --collect --unit=amethystora-share-screen-watch "$(readlink -f "$0")" watch >/dev/null
    fi
    local address
    address="$(hostname -I 2>/dev/null | awk '{print $1}')"
    local port="${PORT}"
    echo "$(eval_gettext "Connect with an RDP client to \${address} port \${port}.")"
    echo "$(eval_gettext "User name: \${USER_NAME}")"
    echo "$(eval_gettext "Code: \${code}")"
}

stop() { # [quiet] [inside]
    grdctl rdp clear-credentials 2>/dev/null || true
    grdctl rdp disable 2>/dev/null || true
    systemctl --user stop gnome-remote-desktop.service 2>/dev/null || true
    close_port
    restore
    rm -f "${STATE}/mode" "${STATE}/since"
    [[ "${1:-}" == quiet ]] || { gettext "Sharing is off, and the code no longer works."; echo; }
    # The watcher last, and not when it is the one stopping: stopping its own unit ends it
    [[ "${2:-}" == inside ]] || systemctl --user stop amethystora-share-screen-watch.service 2>/dev/null || true
}

status() {
    local m port=""
    m="$(mode)"
    [[ "${m}" == off ]] || port="${PORT}"
    jq -nc --arg mode "${m}" --arg port "${port}" --arg since "$(cat "${STATE}/since" 2>/dev/null || true)" \
        --arg view "$(gsettings get "${SCHEMA}" view-only 2>/dev/null || echo true)" \
        '{mode: $mode, port: ($port | if . == "" then null else tonumber end), since: ($since | if . == "" then null else tonumber end),
          view_only: ($view == "true")}'
}

# Ends a help when the screen locks (the lock screen is the end of it) or the hour is up. A bus that cannot be watched ends it at
# once, which is the safe side
watch() {
    timeout "${LIMIT}" gdbus monitor --session --dest org.gnome.ScreenSaver 2>/dev/null | grep -m1 --line-buffered 'ActiveChanged (true' >/dev/null || true
    stop quiet inside
    notify-send --app-name="Amethystora" --icon=screen-shared-symbolic -- "$(gettext "Sharing ended")" \
        "$(gettext "Your screen is no longer shared, and the code no longer works.")" 2>/dev/null || true
}

case "${1:-}" in
    second-screen)
        case "${2:-}" in
            on) start second-screen false ;;
            off) stop ;;
            *) usage ;;
        esac
        ;;
    help)
        case "${2:-}" in
            on) start help true ;;
            off) stop ;;
            control)
                [[ "$(mode)" == help ]] || { gettext "Nobody is being helped right now."; echo; exit 1; }
                case "${3:-}" in
                    on) gsettings set "${SCHEMA}" view-only false ;;
                    off) gsettings set "${SCHEMA}" view-only true ;;
                    *) usage ;;
                esac
                ;;
            *) usage ;;
        esac
        ;;
    status) status ;;
    watch) watch ;;
    *) usage ;;
esac
