#!/usr/bin/bash
# What `ame plugin` runs (plans/PLAN-plugins.md). It reads with amethystora-plugin-host, which only reads the store, and changes
# the store only through pkexec amethystora-plugin-root, one polkit action for each verb. Nothing here grants anything by itself:
# `grant` and `add` ask in a terminal, for each permission on its own, and cannot be answered in advance; an administrator's approval comes after,
# from polkit's own dialog. The agent never runs them (never.rs).
#
#   list|show|check|verify|history [--json]   read
#   add SOURCE [--digest SHA256]              from a git address (https), a folder or a .amethystora-plugin file
#   update ID SOURCE                          the same, for a plugin that is installed: what is new is shown first
#   grant ID [PERMISSION...]                  more of what an installed plugin asks for
#   revoke ID [PERMISSION...] | block ID [HOST] | unblock ID [HOST] | remove ID | rollback ID
#   on ID | off ID                            whether it runs, which stays inside what was approved
#   shipped                                   the plugins the image ships (add one with: add ID; it needs a click and no administrator)
#   make REQUEST | change ID | fix ID         the agent writes a draft (R7-02), changes it, or fixes a plugin that paused (R7-09)
#   examples | new ID [EXAMPLE]               the examples to start from (an agent or a person), and a draft made from one
#   try ID [ACTION]                           run a plugin or a draft once in its sandbox and print what the shell would be given
#   remove-agent-made                         every plugin and draft the agent made, after asking
#   draft ID [--by me]                        a draft the agent wrote is checked, marked as the agent's and shown (it has no permissions)
#   keep ID | discard ID                      a draft: keep it as a plugin (the same consent as any) or throw it away
#   settings ID | set ID NAME                 what a plugin asks you for, and giving it a value (a secret goes into the Vault)
#   share ID [FILE]                           a plugin or draft as a .amethystora-pill file to send (nothing of yours is in it)
#   open FILE                                 what a .amethystora-pill file does: add it (you read what it runs and reaches first)
set -euo pipefail
# shellcheck source=/dev/null
source gettext.sh
export TEXTDOMAIN=amethystora

HOST=/usr/libexec/amethystora-plugin-host
ROOT=/usr/libexec/amethystora-plugin-root
STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/amethystora/plugins"
DRAFTS="${XDG_DATA_HOME:-${HOME}/.local/share}/amethystora/plugin-drafts"
SHIPPED=/usr/share/amethystora/plugins
EXAMPLES=/usr/share/amethystora/plugin-examples
ID_PATTERN='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
WORK=""
trap '[[ -z "${WORK}" ]] || rm -rf -- "${WORK}"' EXIT

die() {
    echo "$1" >&2
    exit "${2:-1}"
}

usage() {
    echo "usage: ame plugin list|show|add|update|remove|check|verify|history|rollback|on|off|grant|revoke|block|unblock|shipped|examples|new|try|make|change|fix|draft|keep|discard|remove-agent-made|settings|set|share|open" >&2
    exit 64
}

valid_id() {
    [[ "$1" =~ ${ID_PATTERN} && ${#1} -le 64 ]]
}

# Asking is only ever done by a person at a terminal: there is no way to answer in advance
need_terminal() {
    [[ -t 0 && -t 1 ]] || die "$(gettext "This asks you before it changes anything, so it needs a terminal.")" 1
}

ask() {
    local answer
    read -r -p "$1 [y/N] " answer || return 1
    [[ "${answer}" == y || "${answer}" == Y || "${answer}" == yes ]]
}

# One line of the host's tab-separated answer: the first field names it
field() {
    awk -F'\t' -v key="$1" '$1 == key { print $2; exit }'
}

cmd_list() {
    if [[ "${1:-}" == --json ]]; then
        exec "${HOST}" list --json
    fi
    local found=0 id version state name kind
    while IFS=$'\t' read -r id version state name kind; do
        found=1
        case "${state}" in
            on) state="$(gettext "on")" ;;
            changed) state="$(gettext "changed")" ;;
            *) state="$(gettext "off")" ;;
        esac
        [[ "${kind}" != draft ]] || name="${name} ($(gettext "draft"))"
        printf '%-40s %-9s %-8s %s\n' "${id}" "${version}" "${state}" "${name}"
    done < <("${HOST}" list)
    if ((!found)); then
        gettext "No plugin is installed. Add one with: ame plugin add ADDRESS"
        echo
    fi
}

cmd_show() {
    valid_id "${1:-}" || usage
    if [[ "${2:-}" == --json ]]; then
        exec "${HOST}" show "$1" --json
    fi
    local key a b
    while IFS=$'\t' read -r key a b; do
        case "${key}" in
            id | name | version | license) printf '%-10s %s\n' "${key}" "${a}" ;;
            digest) export digest="${a}"; eval_gettext "Files: \${digest}"; echo ;;
            verified) [[ "${a}" == yes ]] || { export problem="${a}"; eval_gettext "STOPPED: \${problem}"; echo; } ;;
            enabled) [[ "${a}" == true ]] && { gettext "It is on."; echo; } || { gettext "It is off."; echo; } ;;
            granted) export perm="${a}" why="${b}"; eval_gettext "  allowed: \${perm}: \${why}"; echo ;;
            asked) export perm="${a}" why="${b}"; eval_gettext "  asked, not allowed: \${perm}: \${why}"; echo ;;
            blocked) export host="${a}"; eval_gettext "  blocked: \${host}"; echo ;;
            sandbox) gettext "It runs like this:"; echo; echo "  ${a}" ;;
        esac
    done < <("${HOST}" show "$1")
}

cmd_check() {
    [[ -n "${1:-}" ]] || usage
    # A draft by its id
    if [[ ! -e "$1" ]] && valid_id "$1" && [[ -d "${DRAFTS}/$1" ]]; then
        set -- "${DRAFTS}/$1" "${@:2}"
    fi
    if [[ "${2:-}" == --json ]]; then
        exec "${HOST}" check "$1" --json
    fi
    local key a b status=0 out
    out="$("${HOST}" check "$1")" || status=$?
    while IFS=$'\t' read -r key a b; do
        case "${key}" in
            error) export what="${a}"; eval_gettext "Not accepted: \${what}"; echo ;;
            warning) export what="${a}"; eval_gettext "Note: \${what}"; echo ;;
            perm) export perm="${a}" why="${b}"; eval_gettext "It asks for \${perm}: \${why}"; echo ;;
        esac
    done <<<"${out}"
    if ((status == 0)); then
        gettext "It can be installed. Nothing of it was run."
        echo
    fi
    return "${status}"
}

cmd_verify() {
    local status=0 key id why out
    out="$("${HOST}" verify ${1:+"$1"})" || status=$?
    while IFS=$'\t' read -r key id why; do
        export id why
        if [[ "${key}" == ok ]]; then
            eval_gettext "\${id}: as it was approved"
        else
            eval_gettext "\${id}: CHANGED since it was approved (\${why})"
        fi
        echo
    done <<<"${out}"
    return "${status}"
}

cmd_history() {
    if [[ "${2:-}" == --json || "${1:-}" == --json ]]; then
        exec "${HOST}" history ${1:+"$1"} ${2:+"$2"}
    fi
    local when action id perms
    while IFS=$'\t' read -r when action id perms; do
        printf '%s  %-14s %s %s\n' "${when}" "${action}" "${id}" "${perms}"
    done < <("${HOST}" history ${1:+"$1"})
}

units() {
    # The host runs only while a plugin is on, and stops by itself when the last is off
    if "${HOST}" list | awk -F'\t' '$3 == "on" { found = 1 } END { exit !found }'; then
        systemctl --user enable --now amethystora-plugin-host.service
    else
        systemctl --user disable --now amethystora-plugin-host.service 2>/dev/null || true
    fi
}

cmd_onoff() {
    valid_id "${2:-}" || usage
    "${HOST}" "$1" "$2"
    units
    export id="$2"
    if [[ "$1" == enable ]]; then eval_gettext "\${id} is on."; else eval_gettext "\${id} is off."; fi
    echo
}

cmd_root() {
    # The verbs that give nothing (revoke, block, remove) need no password for the person at the machine; the ones that give more ask an
    # administrator in polkit's own dialog, which names the plugin and each permission
    valid_id "${2:-}" || usage
    pkexec "${ROOT}" "$@" >/dev/null
    export id="$2"
    case "$1" in
        revoke) eval_gettext "\${id} was given less." ;;
        block) eval_gettext "What \${id} sends is blocked." ;;
        unblock) eval_gettext "\${id} may send again." ;;
        rollback) eval_gettext "\${id} is back at its earlier version." ;;
    esac
    echo
}

cmd_remove() {
    valid_id "${1:-}" || usage
    # Control opens this in a terminal: what is removed goes with its settings and its key in the Vault, so it is asked first
    if [[ -t 0 && -t 1 ]]; then
        export id="$1"
        ask "$(eval_gettext "Remove \${id}, with what it kept?")" || { gettext "Nothing was removed."; echo; return 1; }
    fi
    "${HOST}" disable "$1" || true
    pkexec "${ROOT}" remove "$1" >/dev/null
    units
    rm -rf -- "${STATE:?}/$1"
    # What it was given: its settings, and its key in the Vault, so that nothing sealed under it can be read again
    "${HOST}" forget "$1" || true
    export id="$1"
    eval_gettext "\${id} was removed, with what it kept."
    echo
}

# What was frozen, one permission at a time: nothing is granted that was not answered with a y
consent() {
    local id="$1" digest="$2" inspected="$3" previous="$4" key a b
    local -a chosen=() asked=()
    local -A why=()
    while IFS=$'\t' read -r key a b; do
        case "${key}" in
            name) export name="${a}"; ;;
            version) export version="${a}"; ;;
            license) export license="${a}"; ;;
            perm) asked+=("${a}"); why["${a}"]="${b}" ;;
            file) export size="${a}" path="${b}" ;;
        esac
    done <<<"${inspected}"
    export id name version license digest
    eval_gettext "\${name} \${version} (\${id}), licence \${license}"
    echo
    eval_gettext "Its files, as frozen: \${digest}"
    echo
    local count
    count="$(awk -F'\t' '$1 == "file" { n++ } END { print n + 0 }' <<<"${inspected}")"
    export count
    eval_gettext "\${count} files. Read them first if you want to: nothing of it has run."
    echo
    if ((${#asked[@]} == 0)); then
        gettext "It asks for no permission."
        echo
    fi
    for perm in "${asked[@]}"; do
        export perm reason="${why[${perm}]}"
        echo
        eval_gettext "It asks for: \${perm}"
        echo
        eval_gettext "  Its reason: \${reason}"
        echo
        case "${perm}" in
            network=*) gettext "  A host it may reach is a way for anything it knows to leave this computer."; echo ;;
        esac
        if grep -qxF -- "${perm}" <<<"${previous}"; then
            gettext "  You allowed this before."
            echo
        fi
        if ask "$(gettext "Allow it?")"; then
            chosen+=("${perm}")
        fi
    done
    local files=0 network=0 p
    for p in "${chosen[@]}"; do
        [[ "${p}" == files=* ]] && files=1
        [[ "${p}" == network=* ]] && network=1
    done
    if ((files && network)); then
        echo
        gettext "These files and this network are allowed together: the plugin can send those files to those hosts."
        echo
        ask "$(gettext "Keep both?")" || {
            gettext "Nothing was installed."
            echo
            return 1
        }
    fi
    echo
    if ! ask "$(gettext "Install it with only what you allowed?")"; then
        gettext "Nothing was installed."
        echo
        return 1
    fi
    # An administrator approves in polkit's dialog, which shows this very command with each permission
    pkexec "${ROOT}" commit "${id}" "${digest}" "${chosen[@]}" >/dev/null
    eval_gettext "\${id} is installed. Turn it on with: ame plugin on \${id}"
    echo
}

# The files of SOURCE as an archive on standard output: a folder is packed here, a file is sent as it is, and an address is cloned
fetch() {
    local source="$1"
    # A pipeline runs this in a subshell of its own, which cleans up after itself
    WORK="$(mktemp -d)"
    trap '[[ -z "${WORK}" ]] || rm -rf -- "${WORK}"' EXIT
    if [[ -d "${source}" ]]; then
        "${HOST}" pack "${source}"
    elif [[ -f "${source}" ]]; then
        cat -- "${source}"
    elif [[ "${source}" == https://* ]]; then
        git clone --quiet --depth 1 -- "${source}" "${WORK}/clone" >&2 || die "$(gettext "It could not be fetched.")"
        export commit
        commit="$(git -C "${WORK}/clone" rev-parse HEAD)"
        eval_gettext "Pinned at commit \${commit}." >&2
        echo >&2
        rm -rf -- "${WORK}/clone/.git"
        "${HOST}" pack "${WORK}/clone"
    else
        die "$(gettext "A source is a folder, a .amethystora-plugin file or an https:// git address.")" 64
    fi
}

install_from() {
    local source="$1" want_digest="$2" expect_id="$3" previous=""
    need_terminal
    local out ticket digest id
    out="$(fetch "${source}" | pkexec "${ROOT}" prepare)" || die "$(gettext "It was refused, so nothing was kept.")"
    ticket="$(field ticket <<<"${out}")"
    digest="$(field digest <<<"${out}")"
    id="$(field id <<<"${out}")"
    if [[ -n "${want_digest}" && "${want_digest}" != "${digest}" ]]; then
        export digest want_digest
        die "$(eval_gettext "Its digest is \${digest}, not the \${want_digest} you gave. Nothing was installed.")"
    fi
    if [[ -n "${expect_id}" && "${expect_id}" != "${id}" ]]; then
        export id expect_id
        die "$(eval_gettext "That is the plugin \${id}, not \${expect_id}. Nothing was installed.")"
    fi
    if [[ -n "${expect_id}" ]]; then
        previous="$("${HOST}" show "${expect_id}" | awk -F'\t' '$1 == "granted" { print $2 }')"
    fi
    consent "${id}" "${digest}" "$(pkexec "${ROOT}" inspect "${ticket}")" "${previous}"
}

cmd_add() {
    local source="${1:-}" want=""
    [[ -n "${source}" ]] || usage
    shift
    # An id the image ships is added from the image, with a click
    if [[ "${source}" =~ ${ID_PATTERN} && ! -e "${source}" && -d "${SHIPPED}/${source}" ]]; then
        add_shipped "${source}"
        return
    fi
    while (($#)); do
        case "$1" in
            --digest) want="${2:-}"; shift 2 || usage ;;
            *) usage ;;
        esac
    done
    install_from "${source}" "${want}" ""
}

cmd_update() {
    valid_id "${1:-}" && [[ -n "${2:-}" ]] || usage
    install_from "$2" "" "$1"
}

cmd_grant() {
    valid_id "${1:-}" || usage
    need_terminal
    local id="$1" digest key a b
    shift
    local -a want=("$@") chosen=()
    local -A why=()
    local -a asked=()
    digest="$("${HOST}" show "${id}" | field digest)"
    while IFS=$'\t' read -r key a b; do
        if [[ "${key}" == asked ]]; then
            asked+=("${a}")
            why["${a}"]="${b}"
        fi
    done < <("${HOST}" show "${id}")
    if ((${#asked[@]} == 0)); then
        gettext "It asks for nothing more than it has."
        echo
        return 0
    fi
    for perm in "${asked[@]}"; do
        if ((${#want[@]})) && ! printf '%s\n' "${want[@]}" | grep -qxF -- "${perm}"; then
            continue
        fi
        export perm reason="${why[${perm}]}"
        eval_gettext "\${perm}: \${reason}"
        echo
        if ask "$(gettext "Allow it?")"; then
            chosen+=("${perm}")
        fi
    done
    ((${#chosen[@]})) || { gettext "Nothing was allowed."; echo; return 0; }
    pkexec "${ROOT}" grant "${id}" "${digest}" "${chosen[@]}" >/dev/null
    export id
    eval_gettext "\${id} was given what you allowed."
    echo
}


# ---- Shipped plugins ----

cmd_shipped() {
    local dir id name
    for dir in "${SHIPPED}"/*/; do
        [[ -f "${dir}manifest.json" ]] || continue
        id="$(basename "${dir}")"
        name="$(jq -r '.name' "${dir}manifest.json" 2>/dev/null || echo "${id}")"
        printf '%-36s %s\n' "${id}" "${name}"
    done
}

# One of the image's own plugins: its code is the signed image's and cannot change, so a click is all it takes, after the permissions are read
add_shipped() {
    local id="$1" folder="${SHIPPED}/$1" key a b
    [[ -f "${folder}/manifest.json" ]] || die "$(gettext "The image ships no such plugin.")"
    need_terminal
    local out
    out="$("${HOST}" check "${folder}" --system)" || die "$(gettext "That plugin did not pass its own check.")"
    while IFS=$'\t' read -r key a b; do
        case "${key}" in
            name) export name="${a}" ;;
            perm) export perm="${a}" reason="${b}"; eval_gettext "  It will be allowed \${perm}: \${reason}"; echo ;;
        esac
    done <<<"${out}"
    export id
    eval_gettext "\${name} (\${id}) is part of this image: its code is signed and cannot change."
    echo
    ask "$(gettext "Add it with what it asks for?")" || { gettext "Nothing was added."; echo; return 1; }
    pkexec "${ROOT}" commit-shipped "${id}" >/dev/null
    "${HOST}" enable "${id}"
    units
    eval_gettext "\${id} is added and on."
    echo
}

# ---- Drafts: what an agent wrote and nobody has kept ----

draft_dir() {
    valid_id "${1:-}" || usage
    [[ -d "${DRAFTS}/$1" ]] || die "$(gettext "There is no such draft.")"
    echo "${DRAFTS}/$1"
}

cmd_draft() {
    local id="${1:-}" by=agent dir
    shift || true
    [[ "${1:-}" != --by ]] || { [[ "${2:-}" == me ]] && by=me; }
    dir="$(draft_dir "${id}")"
    "${HOST}" check "${dir}" >/dev/null || { "${HOST}" check "${dir}" | awk -F'\t' '$1 == "error" { print $2 }' >&2; die "$(gettext "It did not pass the check, so it was not shown.")"; }
    if [[ "${by}" == agent ]]; then
        local manifest="${dir}/manifest.json" temp
        temp="$(mktemp "${dir}/.manifest.XXXXXX")"
        jq '.author = "Agent"' "${manifest}" >"${temp}" && mv -f -- "${temp}" "${manifest}"
        printf '{"by": "agent", "when": %s}\n' "$(date +%s)" >"${dir}/origin.json"
    else
        printf '{"by": "me", "when": %s}\n' "$(date +%s)" >"${dir}/origin.json"
    fi
    # Turned off and on again, so that the host reads a changed draft again
    "${HOST}" disable "${id}" || true
    "${HOST}" enable "${id}"
    units
    export id
    eval_gettext "\${id} is a draft now, running with nothing allowed. Look at it, then keep it, change it or throw it away."
    echo
}

cmd_discard() {
    valid_id "${1:-}" || usage
    "${HOST}" discard "$1"
    units
    export id="$1"
    eval_gettext "The draft \${id} was thrown away."
    echo
}

cmd_keep() {
    local dir id="${1:-}" copy
    dir="$(draft_dir "${id}")"
    need_terminal
    WORK="$(mktemp -d)"
    copy="${WORK}/draft"
    mkdir -p "${copy}"
    # What was written for the pill's sake is not part of the plugin
    cp -a -- "${dir}/." "${copy}/"
    rm -f -- "${copy}/origin.json" "${copy}/sample.json"
    install_from "${copy}" "" ""
    rm -rf -- "${dir:?}"
    "${HOST}" disable "${id}" || true
    "${HOST}" enable "${id}"
    units
}


cmd_examples() {
    local dir name
    for dir in "${EXAMPLES}"/*/ "${SHIPPED}"/*/; do
        [[ -f "${dir}manifest.json" ]] || continue
        name="$(basename "${dir}")"
        printf '%-28s %s\n' "${name#amethystora.}" "$(jq -r '.name' "${dir}manifest.json" 2>/dev/null || echo "${name}")"
    done
}

# A draft from an example, under a name of your own (a name with no dot gets local. in front): a draft runs with nothing allowed
cmd_new() {
    local id="${1:-}" example="${2:-hello}" from
    [[ -n "${id}" ]] || usage
    [[ "${id}" == *.* ]] || id="local.${id}"
    valid_id "${id}" && [[ "${id}" != amethystora.* ]] || die "$(gettext "A name is lower case letters, digits and dashes, as in my-widget or dev.example.my-widget.")" 64
    for from in "${EXAMPLES}/${example}" "${SHIPPED}/amethystora.${example}" "${SHIPPED}/${example}"; do
        [[ -f "${from}/manifest.json" ]] && break
        from=""
    done
    [[ -n "${from}" ]] || die "$(gettext "There is no such example. See them with: ame plugin examples")"
    [[ ! -e "${DRAFTS}/${id}" ]] || die "$(gettext "There is a draft of that name already.")"
    mkdir -p "${DRAFTS}"
    cp -a -- "${from}" "${DRAFTS}/${id}"
    local manifest="${DRAFTS}/${id}/manifest.json" temp title
    title="${id##*.}"
    title="${title//-/ }"
    temp="$(mktemp "${DRAFTS}/${id}/.manifest.XXXXXX")"
    jq --arg id "${id}" --arg name "${title^}" '.id = $id | .name = $name | del(.author)' "${manifest}" >"${temp}" && mv -f -- "${temp}" "${manifest}"
    chmod 0644 "${manifest}"
    export id
    eval_gettext "Started \${id} from the example \${example}, in \${DRAFTS}/\${id}. Change its files, then: ame plugin draft \${id} --by me"
    echo
}

cmd_try() {
    valid_id "${1:-}" || usage
    exec "${HOST}" try "$@"
}

cmd_remove_agent_made() {
    need_terminal
    local ids id
    ids="$("${HOST}" list --json | jq -r '.[] | select(.author == "Agent") | .id + "\t" + (.draft | tostring)')"
    [[ -n "${ids}" ]] || { gettext "The agent made nothing that is still here."; echo; return 0; }
    local draft
    while IFS=$'\t' read -r id draft; do
        echo "  ${id}"
    done <<<"${ids}"
    ask "$(gettext "Remove all of these, with what they kept?")" || { gettext "Nothing was removed."; echo; return 1; }
    while IFS=$'\t' read -r id draft; do
        if [[ "${draft}" == true ]]; then
            "${HOST}" discard "${id}" || true
        else
            "${HOST}" disable "${id}" || true
            pkexec "${ROOT}" remove "${id}" >/dev/null || true
            rm -rf -- "${STATE:?}/${id}"
            "${HOST}" forget "${id}" || true
        fi
    done <<<"${ids}"
    units
    gettext "Removed."
    echo
}

# ---- The agent ----

agent_available() {
    amethystora-agent status >/dev/null 2>&1 || die "$(gettext "The AI agent is off. Turn it on with: ame agent toggle on")"
}

cmd_make() {
    agent_available
    local request="$*"
    [[ -n "${request// /}" ]] || request="whatever I tell you (ask me what it should show)"
    exec amethystora-agent ask -- "Make a plugin for the Amethystora pill: ${request}. Read the amethystora-plugins skill first. Write it as a draft folder under ${DRAFTS}/<reverse.domain.id>/ with manifest.json, an executable command and a sample.json of what it would print. It has no permissions until the person keeps it, so ask for only what it needs, each with a why. Run: ame plugin check ${DRAFTS}/<id>, and when it passes: ame plugin draft <id>. Never run grant, add or keep: the person does."
}

cmd_change() {
    local dir
    dir="$(draft_dir "${1:-}")"
    agent_available
    exec amethystora-agent ask -- "Change the draft plugin in ${dir}: ask me what to change. Keep it passing: ame plugin check ${dir}, then ame plugin draft $1. Never run grant, add or keep."
}

cmd_fix() {
    valid_id "${1:-}" || usage
    agent_available
    exec amethystora-agent ask -- "The plugin $1 paused itself (it failed, ran too long or went over its limits). Find out why with: ame plugin show $1, then ame plugin off $1 and ame plugin try $1 (a plugin that is on cannot be tried), read its folder, and fix it, as a draft if it must change: ame plugin check, ame plugin draft. You cannot give it more permissions."
}

cmd_settings() {
    valid_id "${1:-}" || usage
    exec "${HOST}" settings "$@"
}

cmd_set() {
    valid_id "${1:-}" && [[ -n "${2:-}" ]] || usage
    need_terminal
    local value
    read -r -s -p "$(gettext "Value (it is not shown): ")" value
    echo
    # On standard input, never as an argument: a secret goes into the Vault and nowhere in the clear
    printf '%s' "${value}" | "${HOST}" setting-set "$1" "$2"
    export name="$2"
    eval_gettext "\${name} is set."
    echo
}

# A plugin's folder as one file: a draft's own, an installed plugin's files in the store (which anyone can read), or one the image ships
cmd_share() {
    valid_id "${1:-}" || usage
    local id="$1" out="${2:-${HOME}/$1.amethystora-pill}" folder digest
    if [[ -d "${DRAFTS}/${id}" ]]; then
        folder="${DRAFTS}/${id}"
    elif [[ -d "${SHIPPED}/${id}" ]]; then
        folder="${SHIPPED}/${id}"
    else
        digest="$("${HOST}" show "${id}" | field digest)"
        [[ "${digest}" =~ ^[0-9a-f]{64}$ && -d "/var/lib/amethystora/plugins/store/${digest}" ]] || die "$(gettext "There is no such plugin.")"
        folder="/var/lib/amethystora/plugins/store/${digest}"
    fi
    [[ ! -e "${out}" ]] || die "$(gettext "That file exists already.")"
    local work
    work="$(mktemp -d)"
    cp -a -- "${folder}/." "${work}/"
    # What was kept for the pill's sake, and what the account wrote, is not part of what is shared
    rm -f -- "${work}/origin.json"
    "${HOST}" pack "${work}" >"${out}"
    rm -rf -- "${work}"
    export out
    eval_gettext "Written to \${out}. Whoever opens it reads what it runs and reaches first, and decides."
    echo
}

cmd_open() {
    [[ -f "${1:-}" ]] || usage
    install_from "$1" "" ""
}

case "${1:-}" in
    list) shift; cmd_list "$@" ;;
    show) shift; cmd_show "$@" ;;
    check) shift; cmd_check "$@" ;;
    verify) shift; cmd_verify "$@" ;;
    history) shift; cmd_history "$@" ;;
    on) shift; cmd_onoff enable "$@" ;;
    off) shift; cmd_onoff disable "$@" ;;
    add) shift; cmd_add "$@" ;;
    update) shift; cmd_update "$@" ;;
    grant) shift; cmd_grant "$@" ;;
    revoke | block | unblock | rollback) cmd_root "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    shipped) cmd_shipped ;;
    draft) shift; cmd_draft "$@" ;;
    discard) shift; cmd_discard "$@" ;;
    keep) shift; cmd_keep "$@" ;;
    make) shift; cmd_make "$@" ;;
    change) shift; cmd_change "$@" ;;
    fix) shift; cmd_fix "$@" ;;
    settings) shift; cmd_settings "$@" ;;
    set) shift; cmd_set "$@" ;;
    open) shift; cmd_open "$@" ;;
    share) shift; cmd_share "$@" ;;
    examples) cmd_examples ;;
    new) shift; cmd_new "$@" ;;
    try) shift; cmd_try "$@" ;;
    remove-agent-made) cmd_remove_agent_made ;;
    *) usage ;;
esac
