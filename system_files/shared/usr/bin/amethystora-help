#!/usr/bin/bash
#
# Amethystora Help: Something's wrong, which looks at what a person picked and offers one thing to press, and What changed,
# one list of what changed on this computer, each with Undo.
#
#   amethystora-help [wrong|changed]   the window, on that page
#
# The window is a GTK program, one with the other Amethystora apps (apps/, build_files/base/13-apps.sh). What it shows is
# /usr/libexec/amethystora-wrong's and /usr/libexec/amethystora-changes'.

set -euo pipefail

case "${1:-}" in
    -h | --help | help) sed -n '3,9p' "$0" | sed 's/^# \?//' ;;
    *) exec /usr/lib/amethystora-help/amethystora-help "$@" ;;
esac
