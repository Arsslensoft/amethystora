#!/usr/bin/bash
#
# The Amethystora menu: one keyboard-driven place for the things that are otherwise scattered over
# Settings, the terminal and `ame`. Super+Alt+Space opens it; the submenus have keys of their own
# (Super+Ctrl+Shift+Space for themes, Super+Ctrl+Space for the next wallpaper).
#
#   amethystora-menu            the main menu
#   amethystora-menu theme      jump straight to the theme picker
#   amethystora-menu background the wallpapers of the current theme
#   amethystora-menu keys       the keybinding cheatsheet
#   amethystora-menu webapps    install or remove a web app
#   amethystora-menu system     lock, log out, restart, shut down
#
# Opened from a keybinding there is no terminal attached, so it reopens itself in one.

set -euo pipefail

# shellcheck source=../lib/amethystora/theme/lib.sh
source /usr/lib/amethystora/theme/lib.sh

KEYBINDINGS=/usr/share/amethystora/keybindings.md

if [[ ! -t 0 ]]; then
    exec xdg-terminal-exec "$0" "$@"
fi

have gum || die "gum is missing, the menu needs it"

# Entering a submenu by name is a one-shot: it exits instead of dropping into the main menu,
# because the key that opened it asked for that one thing.
DIRECT=false

# Each menu on a screen of its own: going back leaves nothing of the one before above it
heading() {
    [[ ! -t 1 ]] || clear
    gum style --foreground 141 --bold --margin "1 0 0 0" "$1"
}

# Typing narrows the list, the arrows move, Enter chooses and Esc goes back
choose() {
    gum filter --header "$1" --height 14 --placeholder "Type to filter" "${@:2}"
}

back() {
    if [[ ${DIRECT} == true ]]; then
        exit 0
    fi
    main_menu
}

# --- Menus ------------------------------------------------------------------------------------

theme_menu() {
    local current choice
    current="$(theme_current || true)"
    heading "Theme"
    # No --selected: gum 2's filter prints a preselected entry on Enter whatever was typed or highlighted
    choice="$(theme_list | choose "Current: ${current:-none}" || true)"
    [[ -n ${choice} ]] || back
    amethystora-theme set "${choice}"
    back
}

background_menu() {
    local -a backgrounds
    local choice
    mapfile -t backgrounds < <(amethystora-theme bg list)
    heading "Background"
    if [[ ${#backgrounds[@]} -le 1 ]]; then
        amethystora-theme bg next
        echo "This theme has one background."
        back
    fi
    choice="$(printf '%s\n' "${backgrounds[@]}" | choose "Background for $(theme_current)" || true)"
    [[ -n ${choice} ]] || back
    amethystora-theme bg set "${choice}"
    back
}

# In gum's pager, which Esc leaves as it leaves a menu (q too)
keys_menu() {
    if have glow; then
        glow --style auto "${KEYBINDINGS}" | gum pager
    else
        gum pager <"${KEYBINDINGS}"
    fi
    back
}

webapps_menu() {
    local choice
    heading "Web apps"
    choice="$(choose "Sites in a window of their own, launched from the app grid" \
        "Install a web app" "Remove a web app" || true)"
    case "${choice}" in
        "Install a web app") amethystora-webapp install || true ;;
        "Remove a web app") amethystora-webapp remove || true ;;
    esac
    back
}

system_menu() {
    local choice
    heading "System"
    choice="$(choose "" "Lock screen" "Log out" "Restart" "Shut down" \
        "Check for updates" "Security report" "Logs" "Backups" || true)"
    case "${choice}" in
        "Lock screen") loginctl lock-session ;;
        "Log out") gnome-session-quit --logout ;;
        "Restart") systemctl reboot ;;
        "Shut down") systemctl poweroff ;;
        # System Updates, in a window of its own like the Manual; `ame update` still works here
        "Check for updates") setsid -f amethystora-update >/dev/null 2>&1 ;;
        # The Security app, in a window of its own like the Manual
        "Security report") setsid -f amethystora-security >/dev/null 2>&1 ;;
        # The Logs app: the journal, searched and followed
        "Logs") setsid -f amethystora-logs >/dev/null 2>&1 ;;
        # The Backups app: earlier versions of your files, and putting them back
        "Backups") setsid -f amethystora-backups >/dev/null 2>&1 ;;
        *) back ;;
    esac
}

main_menu() {
    local choice problem idea
    local -a entries=("Theme" "Background" "Keybindings" "Control" "Manual" "Web apps" "Apps and system commands" "System")
    # Only while the agentic features are on (ame agent toggle)
    if amethystora-agent status >/dev/null 2>&1; then
        entries=("Ask an agent" "Diagnose a problem" "Make a widget" "${entries[@]}")
    fi
    heading "Amethystora"
    choice="$(choose "" "${entries[@]}" "Quit" || true)"
    case "${choice}" in
        "Ask an agent") exec amethystora-agent ;;
        "Diagnose a problem")
            heading "Diagnose a problem"
            # Escape goes back; Enter on an empty line looks for recent failures
            problem="$(gum input --width 80 \
                --placeholder "What went wrong? A PID or service name works too; empty looks for recent failures")" || back
            exec amethystora-agent diagnose "${problem}"
            ;;
        "Make a widget")
            heading "Make a widget"
            # Escape goes back; Enter on an empty line has the agent ask
            idea="$(gum input --width 80 \
                --placeholder "What should it show in the top bar? Empty, and the agent asks you")" || back
            exec /usr/libexec/amethystora-plugins make "${idea}"
            ;;
        Theme) theme_menu ;;
        Background) background_menu ;;
        Keybindings) keys_menu ;;
        # Each a window of its own, which outlives the terminal the menu runs in
        Control) setsid -f amethystora-control >/dev/null 2>&1 ;;
        Manual) setsid -f amethystora-manual >/dev/null 2>&1 ;;
        "Web apps") webapps_menu ;;
        "Apps and system commands")
            # Every `ame` command, in its group: the full list, which stays right as commands come
            # and go with the image
            ame --list --list-submodules
            back
            ;;
        System) system_menu ;;
        *) exit 0 ;;
    esac
}

case "${1:-}" in
    "") main_menu ;;
    theme) DIRECT=true theme_menu ;;
    background | bg) DIRECT=true background_menu ;;
    keys | keybindings) DIRECT=true keys_menu ;;
    webapps | webapp) DIRECT=true webapps_menu ;;
    system) DIRECT=true system_menu ;;
    -h | --help | help) sed -n '3,15p' "$0" | sed 's/^# \?//' ;;
    *) die "unknown menu: $1" ;;
esac
