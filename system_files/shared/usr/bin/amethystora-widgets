#!/usr/bin/bash
# The top bar's widgets are plugins now (plans/done/PLAN-plugins.md): this is the old name for `ame plugin`, kept so that what people and agents
# already type still works. A widget is a plugin that contributes `bar` or `desktop`, runs in a sandbox of its own and reaches only what a
# person allowed. Nothing is read from ~/.config/amethystora/widgets any more.
#
#   amethystora-widgets [list [--json]]   the plugins, and which are on
#   amethystora-widgets make ["<idea>"]   have the AI agent make one, as a draft with nothing allowed
#   amethystora-widgets add <example> [bar|desktop]   one of the image's plugins (clock, calendar, now-playing, system, pomodoro, do-not-disturb, hello)
#   amethystora-widgets new <id> [<example>]          start one from an example, as a draft
#   amethystora-widgets run <id>          check a plugin's folder or a draft, and run it once in its sandbox
#   amethystora-widgets fix <id>          have the AI agent find out why it fails, and fix it
#   amethystora-widgets on|off <id>       show it, or not
#   amethystora-widgets remove <id>       remove it
set -euo pipefail
# shellcheck source=/dev/null
source gettext.sh
export TEXTDOMAIN=amethystora

PLUGINS=/usr/libexec/amethystora-plugins

die() {
    echo "$1" >&2
    exit "${2:-1}"
}

# The one-click gallery: an example's name is the end of the image's plugin id
add_widget() {
    [[ -n "$1" ]] || die "$(gettext "Name the example: amethystora-widgets add <example> [bar|desktop]")" 64
    [[ -z "$2" || "$2" == bar || "$2" == desktop ]] || die "$(gettext "A widget goes in the bar or on the desktop: amethystora-widgets add <example> [bar|desktop]")" 64
    exec "${PLUGINS}" add "amethystora.$1"
}

case "${1:-list}" in
    list) shift; exec "${PLUGINS}" list "$@" ;;
    add) add_widget "${2:-}" "${3:-}" ;;
    new) shift; exec "${PLUGINS}" new "$@" ;;
    run) [[ -n "${2:-}" ]] || die "$(gettext "name the widget: amethystora-widgets run <id>")" 64; exec "${PLUGINS}" check "$2" ;;
    make | fix | on | off | remove) exec "${PLUGINS}" "$@" ;;
    -h | --help | help) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) die "$(gettext "unknown command. Run amethystora-widgets --help")" 64 ;;
esac
