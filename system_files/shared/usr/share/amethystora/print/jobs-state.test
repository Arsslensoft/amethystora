# What the pill asks CUPS about several print jobs of one printer at once (modules/pill/printing.js of Amethystora UI,
# through ipptool -c): one Get-Jobs for the jobs it follows, by number, whatever their state, asking only for state,
# reasons and pages. The numbers come in $j1 to $j16 (the last ones repeating when there are fewer): ipptool takes a list
# from literals but not from one variable. Never the document's name or the printer's own text.
{
    OPERATION Get-Jobs
    GROUP operation-attributes-tag
    ATTR charset attributes-charset utf-8
    ATTR naturalLanguage attributes-natural-language en
    ATTR uri printer-uri $uri
    ATTR name requesting-user-name $user
    ATTR integer job-ids $j1,$j2,$j3,$j4,$j5,$j6,$j7,$j8,$j9,$j10,$j11,$j12,$j13,$j14,$j15,$j16
    ATTR keyword requested-attributes job-id,job-state,job-state-reasons,job-impressions,job-impressions-completed,job-media-sheets,job-media-sheets-completed
    STATUS successful-ok
    DISPLAY job-id
    DISPLAY job-state
    DISPLAY job-state-reasons
    DISPLAY job-impressions
    DISPLAY job-impressions-completed
    DISPLAY job-media-sheets
    DISPLAY job-media-sheets-completed
}
{
    OPERATION Get-Printer-Attributes
    GROUP operation-attributes-tag
    ATTR charset attributes-charset utf-8
    ATTR naturalLanguage attributes-natural-language en
    ATTR uri printer-uri $uri
    ATTR name requesting-user-name $user
    ATTR keyword requested-attributes printer-state,printer-state-reasons
    STATUS successful-ok
    DISPLAY printer-state
    DISPLAY printer-state-reasons
}
