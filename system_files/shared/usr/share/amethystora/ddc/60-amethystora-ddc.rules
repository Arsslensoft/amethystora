# External screens' brightness (ame desktop screen-brightness on copies this into /etc/udev/rules.d, off takes it
# away): the i2c buses of the display controllers (PCI class 0x03), which ddcutil talks to the screens on over DDC/CI,
# to the person at the machine. Not active as the image ships: such a bus can also reach other chips of the card.
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", ATTRS{class}=="0x03*", TAG+="uaccess"
