[Plymouth Theme]
Name=Amethystora
Description=The Amethystora gem, growing on black and glowing while the system starts
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/amethystora
ScriptFile=/usr/share/plymouth/themes/amethystora/amethystora.script
Font=Inter 12
TitleFont=Inter Light 30
