[Unit]
Description=Look for a newer system and newer versions of layered packages, without installing them
Documentation=file:///usr/share/amethystora/manual/updates.md
Wants=network-online.target
After=network-online.target
# A sealed image has no rpm-ostree, and its updates are not looked for before they are staged
ConditionPathExists=!/usr/share/amethystora/sealed

[Service]
Type=oneshot
# Never beside an update: both would want rpm-ostree or bootc at once (and uupd waits for this, its drop-ins)
ExecCondition=/usr/bin/bash -c '! systemctl -q is-active uupd.service uupd-manual.service'
ExecStart=/usr/libexec/amethystora-update-check check
StateDirectory=amethystora/updates
StateDirectoryMode=0755
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
