[Unit]
Description=Find devices whose driver is missing, refused or without its firmware
Documentation=file:///usr/share/amethystora/manual/hardware.md
# 99-amethystora-displaylink.rules starts it with the service that tries to load the dock's driver
After=displaylink.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/amethystora-driver-status check
# It waits for a notification to be answered, which can take as long as a person likes
TimeoutStartSec=infinity
