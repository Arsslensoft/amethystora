[Unit]
Description=Audit watches for each user's home directory
Documentation=man:auditctl(8)
# The rules name paths inside home directories, so they can only be written once those exist, and they
# are written into /etc/audit/rules.d rather than shipped with the image.
#
# Before the rules are loaded, not after: 99-amethystora-finalize.rules closes the rule set with -e 2, so
# the one load at boot is the only chance these have to reach the kernel. Since audit 4.2 (Fedora 44),
# audit-rules.service makes it with `augenrules --load` once auditd has started; before that, auditd
# loaded them itself as it started. This comes before both, by name, so that it does even when auditd
# is not started. A load afterwards would be refused, and the home directories would go unwatched.
#
# auditd runs in early boot, before sysinit.target. With the default dependencies this would come after
# sysinit.target and so after auditd as well, and systemd breaks that cycle by dropping auditd's start
# job: auditd stayed off at every boot. local-fs.target is all this needs, for /etc and /var/home.
DefaultDependencies=no
After=local-fs.target
Before=auditd.service audit-rules.service sysinit.target shutdown.target
Conflicts=shutdown.target
Wants=auditd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Nothing to write while AUDIT_LOG=off in /etc/amethystora/security.conf: auditd and its rules stay off. It
# still runs while a home may hold the decoy key (DECOY), which it takes back then, as it does with DECOY off.
ExecCondition=/usr/bin/bash -c '/usr/libexec/amethystora-security-config --is AUDIT_LOG on || compgen -G "/var/home/*/.ssh/id_backup" >/dev/null'
ExecStart=/usr/libexec/amethystora-audit-home-rules
# auditd and the rules' load wait on this, so it may not sit there: a handful of lines per account takes
# moments
TimeoutStartSec=30
# It runs as root in every home, so whatever an account puts there, it can write nowhere but /etc, the
# homes, the sensor's run directory and its own state. /etc, not /etc/audit: SELinux lets systemd mount over
# /etc but not over auditd_etc_t, and a sandbox systemd cannot set up skipped this unit at every boot.
# systemd-resolved runs this early with the same sandbox. augenrules, for a run by hand, makes its temporary
# file in /tmp; /var/home is missing only on a machine with no homes. The file-watch sensor's plan and watch
# list go in RuntimeDirectory (/run/amethystora/sensor, which the sensor and the watcher only read), and its
# load-probe result is cached under /var/lib/amethystora so a new deployment is the only one that re-probes.
ProtectSystem=strict
ReadWritePaths=/etc -/var/home -/var/lib/amethystora
RuntimeDirectory=amethystora/sensor
# What it watches, and which secrets, is not for the accounts to read; everything that reads it is root
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
PrivateTmp=disconnected
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
