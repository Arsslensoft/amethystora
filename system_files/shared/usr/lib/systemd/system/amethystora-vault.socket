[Unit]
Description=Amethystora Vault's socket
Documentation=file:///usr/share/amethystora/manual/vault.md

# The service starts only when something asks and exits when nothing is open, so a machine that never set up a vault costs
# nothing but this. Every account may connect: the kernel says which account is asking, and that picks the only vaults it
# can reach (SO_PEERCRED).
[Socket]
ListenStream=/run/amethystora/vault.sock
SocketUser=root
SocketGroup=root
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
