[Unit]
Description=Upgrade the containers amethystora-pkg manages
Documentation=man:distrobox(1)
# Nothing to do for an account that has never made one, and podman is not asked
ConditionPathIsDirectory=%S/amethystora/pkg/containers
# A user unit cannot wait for network-online.target: upgrade-all, started by the timer, waits for the network

[Service]
Type=oneshot
# Started by the timer, it holds back the way uupd's automatic updates do (on battery, under load);
# started by hand or by System Updates, it does not. On a connection that counts data, the timer's run waits for one
# that does not, at most a week (amethystora-metered)
ExecCondition=/usr/libexec/amethystora-metered wait containers
ExecStart=/usr/bin/amethystora-pkg upgrade-all
ExecStartPost=/usr/libexec/amethystora-metered done containers
TimeoutStartSec=4h
# An upgrade that makes the desktop stutter is an upgrade the user turns off
Nice=19
IOSchedulingClass=idle
