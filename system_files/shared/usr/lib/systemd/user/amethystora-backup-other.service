[Unit]
Description=Back up this account to its other computer with restic
Documentation=man:restic(1)
# Nothing to do until `ame backup other-computer` has written the settings
ConditionPathExists=%h/.config/amethystora/backup-other.env
After=network-online.target

[Service]
Type=oneshot
# Only at home with the store answering, and not twice a day; a run that is not due is skipped, and asked again the next hour
ExecCondition=/usr/libexec/amethystora-backup-other-ready --due
# On a connection that counts data the run waits for one that does not, at most a week, as the first backup does (amethystora-metered)
ExecCondition=/usr/libexec/amethystora-metered wait backup
ExecStart=/usr/libexec/amethystora-backup --other
ExecStartPost=/usr/libexec/amethystora-metered done backup
# A backup that makes the desktop stutter is a backup the user turns off
Nice=19
IOSchedulingClass=idle
