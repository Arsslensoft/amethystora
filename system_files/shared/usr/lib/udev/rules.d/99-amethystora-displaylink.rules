# When a DisplayLink dock arrives, at boot as well as on plug: say what keeps its screens dark, if anything does
# (amethystora-driver-status). The vendor id is the one displaylink's own rule starts its service by.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="17e9", TAG+="systemd", ENV{SYSTEMD_WANTS}+="amethystora-driver-check.service"
